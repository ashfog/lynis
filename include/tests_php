    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        for FILE in ${PHPINI_ALLFILES}; do
            # Don't look at this setting in cli configuration
            case "${FILE}" in
                */cli/*)
                    continue
                    ;;
            esac
            LogText "测试：检查文件${FILE}"
            FIND=$(${GREPBINARY} -E -i 'expose_php.*(on|yes|1)' ${FILE} | ${GREPBINARY} -v '^;')
            if HasData "${FIND}"; then
                LogText "结果：在 expose_php 设置上找到可能的匹配项"
                LogText "数据：${FIND}"
                FOUND=1
            fi
        done

        if [ ${FOUND} -eq 1 ]; then
            Display --indent 4 --text "- 检查 expose_php 选项" --result "${STATUS_ON}" --color RED
            ReportSuggestion "${TEST_NO}" "关闭PHP信息暴露" "expose_php = 关" "-"
            Report "Result: expose_php option is turned on, which can expose useful information for an attacker"
            AddHP 1 3
        else
            Display --indent 4 --text "- 检查 expose_php 选项" --result "${STATUS_OFF}" --color GREEN
            LogText "结果：发现 'expose_php' 处于禁用状态（0、no 或 off）"
            AddHP 2 2
        fi
    fi
