    # Test        : PHP-2320
    # Description : Check php disable functions option
    if [ -n "${PHPINI_ALLFILES}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PHP-2320 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查PHP禁用的功能"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        for I in ${PHPINI_ALLFILES}; do
            LogText "测试：检查文件 ${I} 中的 PHP 功能强化禁用_functions 或 suhosin.executor.func.blacklist"
            FIND=$(${GREPBINARY} "^disable_functions.*=" ${I})
            if [ -z "${FIND}" ]; then
                LogText "结果：${I}：找不到disabled_functions"
            else
                LogText "结果：${I}：找到disabled_functions"
                FOUND=1
            fi

            FIND=$(${GREPBINARY} "^suhosin.executor.func.blacklist=" ${I})
            if [ -z "${FIND}" ]; then
                LogText "结果：${I}：未找到suhosin.executor.func.blacklist"
            else
                LogText "结果：${I}：找到suhosin.executor.func.blacklist"
                FOUND=1
            fi
        done
        if [ ${FOUND} -eq 0 ]; then
            LogText "结果：所有 PHP 函数都可以执行"
            Display --indent 4 --text "- 检查PHP禁用的功能" --result "${STATUS_NONE}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "通过禁用有风险的功能来强化 PHP"
            LogText "建议评估或禁用的函数： chown, diskfreespace, disk_free_space, disk_total_space, dl, exec, escapeshellarg, escapeshellcmd, fileinode, highlight_file, max_execution_time, passthru, pclose, phpinfo, popen, proc_close, proc_open, proc_get_status, proc_nice, proc_open, proc_terminate, set_time_limit, shell_exec, show_source, system)"
            AddHP 0 1
        else
            LogText "结果：一项或多项 PHP 功能被禁用/列入黑名单"
            Display --indent 4 --text "- 检查PHP禁用的功能" --result "${STATUS_FOUND}" --color GREEN
            AddHP 3 3
        fi
    fi
