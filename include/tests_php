    # Test        : PHP-2211
    # Description : Check php.ini presence
    Register --test-no PHP-2211 --weight L --network NO --category security --description "检查 php.ini 是否存在"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查是否存在 php.ini"
        PHPINIFILE=""
        PHPINI_ALLFILES=""
        for FILE in ${PHPINILOCS}; do
            LogText "测试：检查存在 ${FILE}"
            if [ -f ${FILE} ]; then
                PHPINIFILE="${FILE}"
                LogText "结果：找到 php.ini 文件 (${PHPINIFILE})"
                LogText "注意：将文件添加到 php.ini 数组"
                PHPINI_ALLFILES="${PHPINI_ALLFILES} ${PHPINIFILE}"
            else
                LogText "结果：未找到文件 ${FILE}"
            fi
        done

        # Check all known locations
        for DIR in ${PHPINIDIRS}; do
            FIND=$(ls ${DIR}/*.ini 2> /dev/null)
            if [ -z "${FIND}" ]; then
                LogText "结果：未找到 ${DIR} 的文件"
            else
                LogText "结果：在位置 ${DIR} 中发现文件，正在检查"
                for FILE in ${FIND}; do
                    if [ -f ${FILE} ]; then
                        LogText "结果：文件 ${FILE} 存在，加入 php.ini 数组"
                        PHPINI_ALLFILES="${PHPINI_ALLFILES} ${FILE}"
                    fi
                done
            fi
        done

        if [ -n "${PHPINIFILE}" ]; then
            Display --indent 2 --text "- 检查PHP" --result "${STATUS_FOUND}" --color GREEN
            LogText "结果：使用单个文件 ${PHPINIFILE} 进行主要 php.ini 测试"
            LogText "结果：使用php.ini阵列${PHPINI_ALLFILES}进行进一步测试"
        else
            Display --indent 2 --text "- 检查PHP" --result "${STATUS_NOT_FOUND}" --color WHITE
            LogText "结果：未找到 php.ini 文件"
        fi
        unset DIR FILE FIND
    fi
