            Report "Result: allow_url_include option is turned on, which can be used for downloads via PHP and is a risk"
            ReportSuggestion "${TEST_NO}" "将 allow_url_include 行改为 allow_url_include = Off，以禁用通过 PHP 包含远程内容"
            AddHP 0 1
        else
            Display --indent 4 --text "- 检查 allow_url_include 选项" --result "${STATUS_OFF}" --color GREEN
            LogText "结果：发现 'allow_url_include' 处于禁用状态（0、no 或 off）"
            AddHP 2 2
        fi
    fi
