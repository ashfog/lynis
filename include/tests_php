#################################################################################
#
    # Test        : PHP-2382
    # Description : Check listen option
    # Background  : https://github.com/CISOfy/lynis/issues/837
    if [ -n "${PHPINI_ALLFILES}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PHP-2382 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 PHP expose_php 选项"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        for FILE in ${PHPINI_ALLFILES}; do
            # Don't look at this setting in cli configuration
            case "${FILE}" in
                */cli/*)
                    continue
                    ;;
            esac
            LogText "测试：检查文件${FILE}"
            FIND=$(${GREPBINARY} -E -i "^listen = [0-9]{1,5}$" ${FILE})
            if HasData "${FIND}"; then
                LogText "结果：发现只监听一个端口号"
                LogText "数据：${FIND}"
                LogText "注意：条件允许时，请将访问限制为仅 localhost，避免外部访问"
                FOUND=1
            fi
        done

        if [ ${FOUND} -eq 1 ]; then
            Display --indent 4 --text "- 检查监听选项" --result "${STATUS_SUGGESTION}" --color YELLOW
            #ReportSuggestion "${TEST_NO}" "Limit the listening of FastCGI to just localhost or a local socket" "listen = 127.0.0.1:9000" "-"
            AddHP 1 3
        else
            Display --indent 4 --text "- 检查监听选项" --result "${STATUS_OK}" --color GREEN
            AddHP 2 2
        fi
    fi
