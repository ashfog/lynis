                            apache2)                HTTPDBINARY=${BINARY};             LogText "发现已知程序：apache2（Web 服务器） - ${BINARY}" ;;
                            apt)                    APTBINARY=${BINARY};               LogText "发现已知程序：apt（软件包管理器） - ${BINARY}" ;;
                            apk)                    APKBINARY=${BINARY};               LogText "发现已知程序：apk（软件包管理器） - ${BINARY}" ;;
                            arch-audit)             ARCH_AUDIT_BINARY="${BINARY}";     LogText "发现已知程序：arch-audit（软件包漏洞审计工具） - ${BINARY}" ;;
                            auditd)                 AUDITDBINARY=${BINARY};            LogText "发现已知程序：auditd（审计框架） - ${BINARY}" ;;
                            awk)                    AWKBINARY=${BINARY};               LogText "发现已知程序：awk（文本处理工具） - ${BINARY}" ;;
                            as)                     ASBINARY="${BINARY}";              COMPILER_INSTALLED=1;                  LogText "发现已知程序：as（编译器） - ${BINARY}" ;;
                            auditctl)               AUDITCTLBINARY="${BINARY}";        LogText "发现已知程序：auditctl（auditd 控制工具） - ${BINARY}" ;;
                            autolog)                AUTOLOGBINARY="${BINARY}";         IDLE_SESSION_KILLER_INSTALLED=1;       LogText "发现已知程序：autolog（空闲会话终止工具） - ${BINARY}" ;;
                            base64)                 BASE64BINARY="${BINARY}";          LogText "发现已知程序：base64（编码工具） - ${BINARY}" ;;
                            blkid)                  BLKIDBINARY="${BINARY}";           LogText "发现已知程序：blkid（块设备信息） - ${BINARY}" ;;
                            bootctl)                BOOTCTLBINARY="${BINARY}";         LogText "发现已知程序：bootctl（systemd-boot 管理工具） - ${BINARY}" ;;
                            bro)                    BROBINARY="${BINARY}";             LogText "发现已知程序：bro（IDS） - ${BINARY}" ;;
                            cat)                    CAT_BINARY="${BINARY}";            LogText "发现已知程序：cat（通用文件处理工具） - ${BINARY}" ;;
                            cc)                     CCBINARY="${BINARY}";              COMPILER_INSTALLED=1;  LogText "发现已知程序：cc（编译器） - ${BINARY}" ;;
                            chkconfig)              CHKCONFIGBINARY=${BINARY};         LogText "发现已知程序：chkconfig（管理工具） - ${BINARY}" ;;
                            clamconf)               CLAMCONF_BINARY=${BINARY};         LogText "发现已知程序：clamconf（ClamAV 配置信息） - ${BINARY}" ;;
                            clamscan)               CLAMSCANBINARY=${BINARY};          LogText "发现已知程序：clamscan（杀毒扫描器） - ${BINARY}" ;;
