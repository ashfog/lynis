                            aa-status)              AASTATUSBINARY=${BINARY};          LogText "发现已知程序：aa-status（AppArmor 组件） - ${BINARY}" ;;
                            afick.pl)               AFICKBINARY=${BINARY};             LogText "发现已知程序：afick.pl（文件完整性检查器） - ${BINARY}" ;;
