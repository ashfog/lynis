#################################################################################
#
# Ports and packages
#
#################################################################################
#
    InsertSection "${SECTION_PORTS_AND_PACKAGES}"
    PACKAGE_MGR_PKG=0
    PACKAGE_AUDIT_TOOL=""
    PACKAGE_AUDIT_TOOL_FOUND=0
    PACMANCONF="${ROOTDIR}etc/pacman.conf"
    INSTALLED_PACKAGES=""
#
#################################################################################
#
    Display --indent 2 --text "- 搜索软件包管理器"
#
#################################################################################
#
    # Test        : PKGS-7200
    # Description : Check Alpine Package Keeper (apk)
    if [ -x ${ROOTDIR}/sbin/apk ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7200 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "查询 apk"
    if [ ${SKIPTEST} -eq 0 ]; then
        COUNT=0
        Display --indent 4 --text "- 搜索 apk 软件包管理器" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 apk 可执行文件"
        Report "package_manager[]=apk"
        PACKAGE_MGR_PKG=1
        LogText "检查：运行 apk info -v 获取软件包列表"
        Display --indent 6 --text "- 查询软件包管理器"
        LogText "输出："
        SPACKAGES=$(apk info -v | ${SEDBINARY} -r -e 's/([a-z,A-Z,0-9,_,-,.]{1,250})-([a-z,A-Z,0-9,.]+-r[a-z,A-Z,0-9]+)/\1,\2/' | sort)
        for J in ${SPACKAGES}; do
            COUNT=$((COUNT + 1))
            PACKAGE_NAME=$(echo ${J} | ${CUTBINARY} -d ',' -f1)
            PACKAGE_VERSION=$(echo ${J} | ${CUTBINARY} -d ',' -f2)
            LogText "发现软件包：${PACKAGE_NAME}（版本：${PACKAGE_VERSION}）"
            INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PACKAGE_NAME},${PACKAGE_VERSION}"
        done
        Report "installed_packages=${COUNT}"
    else
        LogText "结果：未找到 apk，已跳过检查"
    fi
#
#################################################################################
#
    # Test        : PKGS-7301
    # Description : Query FreeBSD pkg
    if [ -x ${ROOTDIR}usr/sbin/pkg ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7301 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "查询 FreeBSD pkg"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(pkg -N 2>&1; echo $?)
        if [ "${FIND}" = "0" ]; then
            Display --indent 4 --text "- 使用 pkg 搜索软件包" --result "${STATUS_FOUND}" --color GREEN
            Report "package_manager[]=pkg"
            PACKAGE_MGR_PKG=1
            LogText "结果：发现 pkg"
            LogText "检查：查询 pkg 获取软件包列表"
            Display --indent 6 --text "- 使用 pkg 查询已安装的软件包"
            LogText "输出："; LogText "-----"
            SPACKAGES=$(${ROOTDIR}usr/sbin/pkg query %n,%v)
            for ITEM in ${SPACKAGES}; do
                sPKG_NAME=$(echo ${ITEM} | ${CUTBINARY} -d ',' -f1)
                sPKG_VERSION=$(echo ${ITEM} | ${CUTBINARY} -d ',' -f2)
                LogText "已安装的软件包：${sPKG_NAME}（版本：${sPKG_VERSION}）"
                INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${ITEM}"
            done
        fi
    fi
#
#################################################################################
#
    # Test        : PKGS-7302
    # Description : Query FreeBSD/NetBSD pkg_info
    if [ -x ${ROOTDIR}usr/sbin/pkg_info ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7302 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "查询 FreeBSD/NetBSD pkg_info"
    if [ ${SKIPTEST} -eq 0 ]; then
        COUNT=0
        Display --indent 4 --text "- 检查 pkg_info" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 pkg_info"
        Report "package_manager[]=pkg_info"
        LogText "检查：查询 pkg_info 获取软件包列表"
        Display --indent 6 --text "- 使用 pkg_info 查询已安装的软件包"
        LogText "输出："; LogText "-----"
        SPACKAGES=$(${ROOTDIR}usr/sbin/pkg_info 2>&1 | ${SORTBINARY} | ${TRBINARY} -s ' ' | ${CUTBINARY} -d ' ' -f1 | ${SEDBINARY} -e 's/^\(.*\)-\([0-9].*\)$/\1,\2/g')
        for ITEM in ${SPACKAGES}; do
            COUNT=$((COUNT + 1))
            sPKG_NAME=$(echo ${ITEM} | ${CUTBINARY} -d ',' -f1)
            sPKG_VERSION=$(echo ${ITEM} | ${CUTBINARY} -d ',' -f2)
            LogText "已安装的软件包：${sPKG_NAME}（版本：${sPKG_VERSION}）"
            INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${ITEM}"
        done
        Report "installed_packages=${COUNT}"
    fi
#
#################################################################################
#
    # Test        : PKGS-7303
    # Description : Query brew package manager
    FIND=$(which brew 2> /dev/null | grep -v "no [^ ]* in ")
    if [ -n "${FIND}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7303 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "查询 brew 软件包管理器"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 4 --text "- 搜索 brew" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 brew"
        PACKAGE_MGR_PKG=1
        Report "package_manager[]=brew"
        LogText "检查：查询 brew 获取软件包列表"
        Display --indent 4 --text "- 使用 brew 查询已安装的软件包"
        LogText "输出："; LogText "-----"
        GPACKAGES=$(brew list --versions)
        while IFS= read -r PKG; do
            PACKAGE_NAME=$(echo ${PKG} | ${CUTBINARY} -d ' ' -f1)
            PACKAGE_VERSION=$(echo ${PKG} | ${CUTBINARY} -d ' ' -f2)
            LogText "发现软件包：${PACKAGE_NAME}（版本：${PACKAGE_VERSION}）"
            INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PACKAGE_NAME},${PACKAGE_VERSION}"
        done << EOF
$GPACKAGES
EOF
    else
        LogText "结果：此系统上未找到 brew"
    fi
#
#################################################################################
#
    # Test        : PKGS-7304
    # Description : Gentoo packages
    if [ -x ${ROOTDIR}usr/bin/emerge -a -x ${ROOTDIR}usr/bin/equery ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7304 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "查询 Gentoo 软件包"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 4 --text "- 搜索 emerge" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 Gentoo emerge"
        Report "package_manager[]=emerge"
        LogText "检查：查询 Portage 获取软件包列表"
        Display --indent 4 --text "- 使用 Portage 查询已安装的软件包"
        LogText "输出："; LogText "-----"
        GPACKAGES=$(equery l '*' | ${SEDBINARY} -e 's/[.*]//g')
        for PKG in ${GPACKAGES}; do
            LogText "发现软件包 ${PKG}"
            INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PKG},0,"
        done
    else
        LogText "结果：此系统上未找到 emerge"
    fi
#
#################################################################################
#
    # Test        : PKGS-7305
    # Description : Query macOS Apps in /Applications and CoreServices
    Register --test-no PKGS-7305 --os macOS --weight L --network NO --category security --description "查询 /Applications 和 CoreServices 中的 macOS 应用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：查询 /Applications 中的应用"
        Display --indent 4 --text "- 查询 /Applications 中的 macOS 应用"
        LogText "输出："; LogText "-----"
        for APP in /Applications/*.app; do
            PACKAGE_NAME=$(basename "$APP" .app)
            PACKAGE_VERSION=$(defaults read "$APP/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo "N/A")
            LogText "发现软件包：${PACKAGE_NAME}（版本：${PACKAGE_VERSION}）"
            INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PACKAGE_NAME},${PACKAGE_VERSION}"
        done
        Display --indent 4 --text "- 查询 Apple CoreServices"
        for CS in /Library/Apple/System/Library/CoreServices/*.app; do
            PACKAGE_NAME=$(basename "$CS" .app)
            PACKAGE_VERSION=$(defaults read "$CS/Contents/Info" CFBundleShortVersionString 2>/dev/null || echo "N/A")
            LogText "发现 CoreServices：${PACKAGE_NAME}（版本：${PACKAGE_VERSION}）"
            INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PACKAGE_NAME},${PACKAGE_VERSION}"
        done   
    fi
#
#################################################################################
#
    # Test        : PKGS-7306
    # Description : Solaris packages
    if [ -x ${ROOTDIR}usr/bin/pkginfo ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7306 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "查询 Solaris 软件包"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 4 --text "- 搜索 pkginfo" --result "${STATUS_FOUND}" --color GREEN
            LogText "结果：发现 Solaris pkginfo"
            Report "package_manager[]=pkginfo"
            PACKAGE_MGR_PKG=1
            LogText "检查：查询 pkginfo 获取软件包列表"
            Display --indent 4 --text "- 使用 pkginfo 查询已安装的软件包"
            LogText "输出："; LogText "-----"
            # Strip SUNW from strings
            SPACKAGES=$(${ROOTDIR}usr/bin/pkginfo -i | ${TRBINARY} -s ' ' | ${CUTBINARY} -d ' ' -f2 | ${SEDBINARY} "s#^SUNW##")
            for J in ${SPACKAGES}; do
                LogText "发现软件包 ${J}"
                INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${J},0,"
            done
    else
        LogText "结果：此系统上未找到 pkginfo"
    fi
#
#################################################################################
#
    # Test        : PKGS-7308
    # Description : RPM package based systems
    if [ -n "${RPMBINARY}" -a -z "${DNFBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7308 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "使用 RPM 检查软件包列表"
    if [ ${SKIPTEST} -eq 0 ]; then
        COUNT=0
        Display --indent 4 --text "- 搜索 RPM 软件包管理器" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 rpm 可执行文件（${RPMBINARY}）"
        Report "package_manager[]=rpm"
        LogText "检查：运行 rpm -qa 获取软件包列表"
        Display --indent 6 --text "- 查询 RPM 软件包管理器"
        LogText "输出："; LogText "--------"
        SPACKAGES=$(${RPMBINARY} -qa --queryformat "%{NAME},%{VERSION}-%{RELEASE}.%{ARCH}\n" 2> /dev/null | sort)
        if [ -z "${SPACKAGES}" ]; then
            LogText "结果：RPM 可执行文件可用，但软件包列表似乎为空"
            LogText "信息：rpm 已安装，但似乎未用于安装软件包"
            ReportSuggestion "${TEST_NO}" "检查 RPM 数据库：rpm 可用，但未返回任何软件包"
        else
            for PKG in ${SPACKAGES}; do
                COUNT=$((COUNT + 1))
                PACKAGE_NAME=$(echo ${PKG} | ${AWKBINARY} -F, '{print $1}')
                PACKAGE_VERSION=$(echo ${PKG} | ${AWKBINARY} -F, '{print $2}')
                LogText "发现软件包：${PKG}"
                INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PACKAGE_NAME},${PACKAGE_VERSION},"
            done
            Report "installed_packages=${COUNT}"
        fi
    else
        LogText "结果：此系统上未找到 RPM，已跳过检查"
    fi
#
#################################################################################
#
    # Test        : PKGS-7310
    # Description : pacman package based systems
    if [ -n "${PACMANBINARY}" -a -f "${PACMANCONF}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7310 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "使用 pacman 检查软件包列表"
    if [ ${SKIPTEST} -eq 0 ]; then
        COUNT=0
        Display --indent 4 --text "- 搜索 pacman 软件包管理器" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 pacman 可执行文件（${PACMANBINARY}）"
        Report "package_manager[]=pacman"
        PACKAGE_MGR_PKG=1
        LogText "检查：运行 pacman -Q 获取软件包列表"
        Display --indent 6 --text "- 查询 pacman 软件包管理器"
        LogText "输出："; LogText "--------"
        SPACKAGES=$(${PACMANBINARY} -Q | ${SORTBINARY} | ${SEDBINARY} 's/ /,/g')
        if [ -z "${SPACKAGES}" ]; then
            LogText "结果：pacman 可用，但软件包列表似乎为空"
            LogText "信息：pacman 已安装，但似乎未用于安装软件包"
        else
            for PKG in ${SPACKAGES}; do
                COUNT=$((COUNT + 1))
                PACKAGE_NAME=$(echo ${PKG} | ${AWKBINARY} -F, '{ print $1 }')
                PACKAGE_VERSION=$(echo ${PKG} | ${AWKBINARY} -F, '{ print $2 }')
                LogText "发现软件包：${PACKAGE_NAME}（版本：${PACKAGE_VERSION}）"
                INSTALLED_PACKAGES="${INSTALLED_PACKAGES}|${PKG}"
            done
            Report "installed_packages=${COUNT}"
        fi
    fi
#
#################################################################################
#
    # Test        : PKGS-7312
    # Description : Check for available package updates when pacman package is used
    if [ -n "${PACMANBINARY}" -a -f "${PACMANCONF}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7312 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 pacman 系统的可用更新"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        FIND=$(which checkupdates 2> /dev/null | grep -v "no [^ ]* in ")
        if [ -n "${FIND}" ]; then
            FIND=$(checkupdates)
            for I in ${FIND}; do
                LogText "结果：${I} 有可用更新"
                Report "available_update[]=${I}"
                FOUND=1
            done
            if [ ${FOUND} -eq 1 ]; then
                Display --indent 4 --text "- 使用 checkupdates 检查更新状态" --result "有待更新" --color YELLOW
                ReportSuggestion "${TEST_NO}" "此系统采用滚动更新，请安装可用的系统更新"
            else
                Display --indent 4 --text "- 使用 checkupdates 检查更新状态" --result "已是最新" --color GREEN
            fi
        else
            LogText "结果：未找到 checkupdates，跳过此检查"
        fi
    else
        LogText "结果：此系统上未找到 pacman，已跳过检查"
    fi
#
#################################################################################
#
    # Test        : PKGS-7314
    # Description : Check pacman.conf options
    if [ -n "${PACMANBINARY}" -a -f "${PACMANCONF}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no PKGS-7314 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 pacman 配置选项"
    if [ ${SKIPTEST} -eq 0 ]; then
        COUNT=0
        # Check configuration options (options start with a capital)
        LogText "检查：搜索 ${PACMANCONF} 中的配置选项"
        FIND=$(${GREPBINARY} "^[A-Z]" ${PACMANCONF} | ${SORTBINARY} -u | ${SEDBINARY} 's/ /:space:/g')
        for I in ${FIND}; do
            PMOPTION=$(echo ${I} | ${SEDBINARY} 's/:space:/ /g' | ${AWKBINARY} -F= '{ print $1 }')
            PMVALUE=$(echo ${I} | ${SEDBINARY} 's/:space:/ /g' | ${AWKBINARY} -F= '{ print $2 }')
            LogText "结果：发现选项 ${PMOPTION}，配置值为 ${PMVALUE}"
            Report "pacman_option[]=${PMOPTION}:${PMVALUE}:"
        done

        # Check software repositories
        LogText "检查：检查可用的软件仓库"
        FIND=$(${GREPBINARY} "^\[.*\]$" ${PACMANCONF} | ${TRBINARY} -d '[]')
        for I in ${FIND}; do
            COUNT=$((COUNT + 1))
            Report "package_repository[]=${I}"
        done
        LogText "结果：发现 ${COUNT} 个软件仓库"
    fi
