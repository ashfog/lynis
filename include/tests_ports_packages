#
    # Test        : PKGS-7410
    # Description : Count number of installed kernel packages
    Register --test-no PKGS-7410 --weight L --network NO --category security --description "统计已安装的内核软件包"
    if [ ${SKIPTEST} -eq 0 ]; then
        KERNELS=0
        TESTED=0
        LogText "检查：统计已安装的内核软件包数量"

        if [ "${DPKGBINARY}" ]; then
            TESTED=1
            KERNEL_PKG_NAMES="linux-image-[0-9]|raspberrypi-kernel|pve-kernel-[0-9]|linux-odroid-5422"
            KERNELS=$(${DPKGBINARY} -l 2> /dev/null | ${GREPBINARY} -E "${KERNEL_PKG_NAMES}" | ${GREPBINARY} -v ^rc | ${WCBINARY} -l)
            if [ ${KERNELS} -eq 0 ]; then
                LogText "结果：dpkg -l 输出中未发现内核软件包，情况异常"
            elif [ ${KERNELS} -gt 5 ]; then
                LogText "结果：系统中发现超过 5 个内核软件包，可能未定期清理"
                ReportSuggestion "${TEST_NO}" "删除不需要的内核软件包" "${KERNELS} 个内核" "text:检查 dpkg -l 输出，并使用 apt autoremove 清理"
            else
                LogText "结果：系统中发现 ${KERNELS} 个内核软件包，数量正常"
            fi
        fi
        if [ "${RPMBINARY}" ]; then
            TESTED=1
            KERNELS=$(${RPMBINARY} -q kernel 2> /dev/null | ${WCBINARY} -l)
            if [ ${KERNELS} -eq 0 ]; then
                LogText "结果：rpm -q kernel 输出中未发现内核软件包，情况异常"
            elif [ ${KERNELS} -gt 5 ]; then
                LogText "结果：系统中发现超过 5 个内核软件包，可能未定期清理"
                ReportSuggestion "${TEST_NO}" "使用 package-cleanup --old-kernels 删除不需要的内核软件包"
            else
                LogText "结果：系统中发现 ${KERNELS} 个内核软件包，数量正常"
            fi
        fi

        if [ "${ZYPPERBINARY}" ]; then
            TESTED=1
            KERNELS=$(${ZYPPERBINARY} --non-interactive -n se --type package --match-exact --installed-only "kernel-default" 2> /dev/null | ${GREPBINARY} "kernel-default" | ${WCBINARY} -l)
            if [ ${KERNELS} -eq 0 ]; then
                LogText "结果：zypper 输出中未发现内核软件包，情况异常。"
                ReportException "${TEST_NO}" "软件包管理器未找到内核软件包，系统可能使用了不同的内核软件包名称。"
            elif [ ${KERNELS} -gt 3 ]; then
                LogText "结果：系统中发现超过 5 个内核软件包，可能未定期清理"
                ReportSuggestion "${TEST_NO}" "删除不需要的内核软件包"
            else
                LogText "结果：系统中发现 ${KERNELS} 个内核软件包，数量正常"
            fi
        fi

        if [ ${KERNELS} -eq 0 -a ${TESTED} -eq 1 ]; then
            # Only report exception if there are kernels actually there. For example, LXC use the kernel of host system
            case "${OS}" in
                "Linux")
                    case "${CONTAINER_TYPE}" in
                        "LXC")
                            LogText "信息：LXC 与宿主机共享内核，因此跳过后续检查"
                        ;;
                        *)
                            if [ -d "${ROOTDIR}boot" ]; then
                                if [ -z "$(${FINDBINARY} /boot -maxdepth 1 -type f -name 'vmlinuz*' -print -quit)" ]; then
                                    ReportException "${TEST_NO}" "软件包管理器未找到内核软件包"
                                fi
                            fi
                        ;;
                    esac
                ;;
                *)
                    ReportException "${TEST_NO}" "软件包管理器未找到内核软件包"
                ;;
            esac
        fi

        Report "installed_kernel_packages=${KERNELS}"
    fi
