    # Test        : PKGS-7395
    # Description : Check Alpine upgradeable packages
    if [ "${LINUX_VERSION}" = "Alpine Linux" ]  && [ -x "${ROOTDIR}sbin/apk" ]; then
        PREQS_MET="YES"
    else
        PREQS_MET="NO"
    fi

    Register --test-no PKGS-7395 --os Linux --preqs-met ${PREQS_MET} --weight L --network YES --category security --description "检查 Alpine 更新"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ ${REFRESH_REPOSITORIES} -eq 1 ]; then
            LogText "操作：使用 apk 更新软件仓库"
            ${ROOTDIR}sbin/apk update
            LogText "结果：apk 执行完成"
        else
            LogText "结果：配置已禁用仓库更新，当前使用的软件仓库信息可能已过期"
        fi
        LogText "检查：使用 apk version -l 查询可升级的软件包"
        FIND=$(${ROOTDIR}sbin/apk version -l '<' | ${GREPBINARY} '<' | ${SEDBINARY} 's/\s\+<\s/</g')
        if [ -z "${FIND}" ]; then
            LogText "结果：未发现可升级的软件包"
            Display --indent 2 --text "- 检查可升级的软件包" --result "${STATUS_NONE}" --color GREEN
            AddHP 3 3
        else
            LogText "结果：发现一个或多个可升级的软件包"
            Display --indent 2 --text "- 检查可升级的软件包" --result "${STATUS_FOUND}" --color YELLOW
            for ITEM in ${FIND}; do
                ITEM=$(echo ${ITEM} | ${SEDBINARY}  -r -e 's/([a-z,A-Z,0-9,_,-,.]{1,250})-([a-z,A-Z,0-9,.]+-r[a-z,A-Z,0-9]+)<([a-z,A-Z,0-9,-,.]+)/\1 from \2 to \3/')
                LogText "${ITEM}"
            done
        fi
    fi
