#
    InsertSection "${SECTION_CONTAINERS}"
#
#################################################################################
#
    DOCKER_CONTAINERS_RUNNING=0
    DOCKER_CONTAINERS_TOTAL=0
    DOCKER_FILE_PERMISSIONS_WARNINGS=0
    RUN_DOCKER_TESTS=0
#
#################################################################################
#
    # Test        : CONT-8004
    # Description : Query running Solaris zones
    if [ -x ${ROOTDIR}usr/sbin/zoneadm ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no CONT-8004 --os Solaris --weight L --network NO --category security --description "查询正在运行的 Solaris 区域"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：使用 zoneadm 查询全部正在运行的区域"
        FIND=$(${ROOTDIR}usr/sbin/zoneadm list -p | ${AWKBINARY} -F: '{ if ($2!="global") print $0 }')
        if [ -n "${FIND}" ]; then
            COUNT=0
            for ITEM in ${FIND}; do
                COUNT=$((COUNT + 1))
                ZONEID=$(echo ${ITEM} | ${CUTBINARY} -d ':' -f1)
                ZONENAME=$(echo ${ITEM} | ${CUTBINARY} -d ':' -f2)
                LogText "结果：发现正在运行的区域 ${ZONENAME}"
                Report "solaris_running_zone[]=${ZONENAME} [id:${ZONEID}]"
            done
            LogText "结果：共有 ${COUNT} 个正在运行的区域"
            Display --indent 2 --text "- 正在检查 Solaris 区域" --result "发现 ${COUNT} 个区域" --color GREEN
        else
            LogText "结果：未发现正在运行的区域"
            Display --indent 2 --text "- 正在检查 Solaris 区域" --result "${STATUS_NONE}" --color WHITE
        fi
    fi
