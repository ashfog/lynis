    AIDECONFIG=""
    CSF_CONFIG="${ROOTDIR}etc/csf/csf.conf"
    FILE_INT_TOOL=""
    FILE_INT_TOOL_FOUND=0     # Boolean, file integrity tool found
#
#################################################################################
#
    InsertSection "${SECTION_SYSTEM_INTEGRITY}"
    Display --indent 2 --text "- 正在检查系统完整性工具"
#
#################################################################################
#
    # Test        : SINT-7010
    # Description : System Integrity Status
    if [ -x ${ROOTDIR}/usr/bin/csrutil ]; then PREQS_MET="YES"; else PREQS_MET="NO"; SKIPREASON="未找到 csrutil 可执行文件"; fi
    Register --test-no SINT-7010 --os MacOS --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight H --network NO --category security --description "检查系统完整性保护状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        if ${ROOTDIR}usr/bin/csrutil status | ${GREPBINARY} -sq enabled ; then
            Display --indent 2 --text "- 系统完整性保护（状态）" --result "${STATUS_OK}" --color GREEN
            Report "system_integrity_tool[]=mac-sip"
            LogText "结果：SIP 已启用，状态正常"
            AddHP 3 3
        else
            Display --indent 2 --text "- 系统完整性保护（状态）" --result "${STATUS_NO}" --color RED
            LogText "结果：SIP 已禁用，状态异常"
            AddHP 0 3
        fi
    fi

#
#################################################################################
#

WaitForKeyPress

# EOF
