#################################################################################
#
    # Test        : INSE-8300
    # Description : Check if rsh client is installed
    Register --test-no INSE-8300 --package-manager-required --weight L --network NO --category security --description "检查是否安装 rsh 客户端"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：rsh 客户端是否已安装"
        FOUND=0
        PACKAGES="rsh rsh-client rsh-redone-client"
        for PACKAGE in ${PACKAGES}; do
            if PackageIsInstalled "${PACKAGE}"; then LogText "软件包 '${PACKAGE}' 已安装"; FOUND=1; fi
        done
        if [ ${FOUND} -eq 1 ]; then
            LogText "结果：rsh 客户端已安装"
            Display --indent 2 --text "- 已安装的 rsh 客户端软件包" --result "${STATUS_SUGGESTION}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "不使用 rsh 客户端时应将其移除，或改用更安全的 SSH 软件包"
        else
            LogText "结果：未安装 rsh 客户端"
            Display --indent 2 --text "- 已安装的 rsh 客户端软件包" --result "${STATUS_OK}" --color GREEN
        fi
    fi
