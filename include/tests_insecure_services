#################################################################################
#
# Insecure services
#
#################################################################################
#
    InsertSection "${SECTION_INSECURE_SERVICES}"
#
#################################################################################
#
    INETD_ACTIVE=0
    INETD_CONFIG_FILE="${ROOTDIR}etc/inetd.conf"
    INETD_PACKAGE_INSTALLED=0
    XINETD_ACTIVE=0
    XINETD_CONFIG_FILE="${ROOTDIR}etc/xinetd.conf"
    XINETD_CONFIG_DIR="${ROOTDIR}etc/xinetd.d"
#
#################################################################################
#
    # Test        : INSE-8000
    # Description : Check for installed inetd package
    Register --test-no INSE-8000 --package-manager-required --weight L --network NO --category security --description "检查是否安装 inetd 软件包"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check for installed inetd daemon
        LogText "检查：inetd 是否已安装"
        if PackageIsInstalled "inetd" || PackageIsInstalled "inetutils-inetd"; then
            INETD_PACKAGE_INSTALLED=1
            LogText "结果：inetd 已安装"
            Display --indent 2 --text "- 已安装的 inetd 软件包" --result "${STATUS_FOUND}" --color YELLOW
            #ReportSuggestion "${TEST_NO}" "If there are no inetd services required, it is recommended that the daemon be removed"
        else
            LogText "结果：未安装 inetd"
            Display --indent 2 --text "- 已安装的 inetd 软件包" --result "${STATUS_NOT_FOUND}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8002
    # Description : Check for inetd status
    if [ ${INETD_PACKAGE_INSTALLED} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8002 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 inetd 守护进程是否启用"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check running processes
        LogText "检查：搜索活动的 inetd 守护进程"
        if IsRunning "inetd" || IsRunning "inetutils-inetd"; then
            LogText "结果：inetd 正在运行"
            Display --indent 4 --text "- inetd 状态" --result "${STATUS_ACTIVE}" --color GREEN
            INETD_ACTIVE=1
        else
            LogText "结果：inetd 未运行"
            Display --indent 4 --text "- inetd 状态" --result "${STATUS_NOT_ACTIVE}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8004
    # Description : Check for inetd configuration file (inetd)
    if [ ${INETD_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8004 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 inetd 配置文件是否存在"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check configuration file
        LogText "检查：搜索文件 ${INETD_CONFIG_FILE}"
        if [ -f ${INETD_CONFIG_FILE} ]; then
            LogText "结果：${INETD_CONFIG_FILE} 存在"
            Display --indent 4 --text "- 正在检查 inetd.conf" --result "${STATUS_FOUND}" --color WHITE
        else
            LogText "结果：${INETD_CONFIG_FILE} 不存在"
            Display --indent 4 --text "- 正在检查 inetd.conf" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8006
    # Description : Check for inetd configuration file contents if inetd is NOT active
    if [ ${INETD_ACTIVE} -eq 0 -a -f ${INETD_CONFIG_FILE} ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8006 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 inetd 禁用时的配置内容"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check if any service is enabled in /etc/inetd.conf (inetd is not active, see test INSE-8002)
        LogText "检查：inetd 禁用时是否仍配置了已启用服务"
        FIND=$(${GREPBINARY} -v "^#" ${INETD_CONFIG_FILE} | ${GREPBINARY} -v "^$")
        if [ -z "${FIND}" ]; then
            LogText "结果：${INETD_CONFIG_FILE} 中未发现服务"
            Display --indent 4 --text "- 正在检查已启用的 inetd 服务" --result "${STATUS_OK}" --color GREEN
        else
            LogText "结果：inetd 未运行，但配置中仍发现服务"
            Display --indent 4 --text "- 正在检查已启用的 inetd 服务" --result "${STATUS_SUGGESTION}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "虽然 inetd 未运行，但仍应确认 ${INETD_CONFIG_FILE} 中没有启用服务，或移除 inetd 服务"
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8016
    # Description : Check for telnet enabled via inetd
    if [ ${INETD_ACTIVE} -eq 1 -a -f ${INETD_CONFIG_FILE} ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8016 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 inetd 是否启用了 Telnet"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：inetd 配置中是否存在 Telnet"
        FIND=$(${GREPBINARY} "^telnet" ${INETD_CONFIG_FILE})
        if [ -z "${FIND}" ]; then
            LogText "结果：${INETD_CONFIG_FILE} 中未启用 Telnet"
            Display --indent 2 --text "- 正在检查 inetd（Telnet）" --result "${STATUS_NOT_FOUND}" --color GREEN
            AddHP 3 3
        else
            LogText "结果：${INETD_CONFIG_FILE} 中已启用 Telnet"
            Display --indent 2 --text "- 正在检查 inetd（Telnet）" --result "${STATUS_WARNING}" --color RED
            ReportSuggestion "${TEST_NO}" "在 inetd 配置中禁用 Telnet，并改用 SSH"
            AddHP 1 3
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8100
    # Description : Check for installed xinetd daemon
    Register --test-no INSE-8100 --package-manager-required --weight L --network NO --category security --description "检查是否安装 xinetd 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check for installed xinetd daemon
        LogText "检查：xinetd 守护进程是否已安装"
        if PackageIsInstalled "xinetd"; then
            LogText "结果：xinetd 已安装"
            Display --indent 2 --text "- 已安装的 xinetd 软件包" --result "${STATUS_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "如果不需要任何 xinetd 服务，建议移除该守护进程"
        else
            LogText "结果：未安装 xinetd"
            Display --indent 2 --text "- 已安装的 xinetd 软件包" --result "${STATUS_OK}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8102
    # Description : Check for xinetd status
    Register --test-no INSE-8102 --weight L --network NO --category security --description "检查 xinetd 守护进程是否活动"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check running processes
        LogText "检查：搜索活动的扩展网络服务守护进程 xinetd"
        if IsRunning "xinetd"; then
            LogText "结果：xinetd 正在运行"
            Display --indent 4 --text "- xinetd 状态" --result "${STATUS_ACTIVE}" --color GREEN
            XINETD_ACTIVE=1
        else
            LogText "结果：xinetd 未运行"
            Display --indent 4 --text "- xinetd 状态" --result "${STATUS_NOT_ACTIVE}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8104
    # Description : Check for xinetd configuration file
    if [ ${XINETD_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8104 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 xinetd 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check configuration file
        LogText "检查：搜索文件 ${XINETD_CONFIG_FILE}"
        if [ -f "${XINETD_CONFIG_FILE}" ]; then
            LogText "结果：${XINETD_CONFIG_FILE} 存在"
            Display --indent 6 --text "- 配置文件（xinetd.conf）" --result "${STATUS_FOUND}" --color WHITE
        else
            LogText "结果：${XINETD_CONFIG_FILE} 不存在"
            Display --indent 6 --text "- 配置文件（xinetd.conf）" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8106
    # Description : Check for xinetd configuration file contents if xinetd is NOT active
    if [ ${XINETD_ACTIVE} -eq 0 -a -f ${XINETD_CONFIG_FILE} ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8106 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 xinetd 禁用时的配置内容"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Check if any service is enabled in /etc/xinetd.d (xinetd is not active, see test INSE-8102)
        LogText "检查：xinetd 禁用时是否仍启用了服务"
        FIND=$(${GREPBINARY} -r "disable\s*=\s*no" ${XINETD_CONFIG_DIR})
        if [ -z "${FIND}" ]; then
            LogText "结果：${XINETD_CONFIG_DIR} 中未发现服务"
            Display --indent 6 --text "- 已启用的 xinetd.d 服务" --result "${STATUS_NOT_FOUND}" --color GREEN
        else
            LogText "结果：xinetd 未运行，但 ${XINETD_CONFIG_DIR} 中仍发现服务"
            Display --indent 6 --text "- 已启用的 xinetd.d 服务" --result "${STATUS_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "虽然 xinetd 未运行，但仍应确认 ${XINETD_CONFIG_DIR} 中没有启用服务，或移除 xinetd 服务"
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8116
    # Description : Check for insecure services enabled via xinetd
    if [ ${XINETD_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8116 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查通过 xinetd 启用的不安全服务"
    if [ ${SKIPTEST} -eq 0 ]; then
        XINETD_INSECURE_SERVICE_FOUND=0

        ITEMS="chargen chargen-dgram chargen-stream daytime daytime-dgram daytime-stream discard discard-dgram discard-stream echo echo-dgram echo-stream time time-dgram time-stream ntalk rexec rlogin rsh rsync talk telnet tftp"

        for SERVICE in ${ITEMS}; do
            LogText "检查：服务 ${SERVICE}"
            if ! SkipAtomicTest "${TEST_NO}:${SERVICE}"; then
                FILE="${XINETD_CONFIG_DIR}/${SERVICE}"
                if [ -f "${FILE}" ]; then
                    LogText "检查：xinetd 配置文件中的状态（${FILE}）"
                    FIND=$(${GREPBINARY} "disable\s*=\s*no" ${FILE})
                    if [ -n "${FIND}" ]; then
                        LogText "结果：发现已启用的不安全服务：${SERVICE}"
                        XINETD_INSECURE_SERVICE_FOUND=1
                        ReportSuggestion "${TEST_NO}" "禁用或移除 xinetd 配置中的不安全服务" "${SERVICE}" "text:详情请查看日志文件"
                        Report "insecure_service[]=${SERVICE}"
                    fi
                fi
            else
                LogText "结果：该项目已通过配置文件排除，因此跳过"
            fi
        done

        if [ ${XINETD_INSECURE_SERVICE_FOUND} -eq 0 ]; then
            LogText "结果：xinetd 配置中未发现不安全服务"
            Display --indent 6 --text "- 正在检查 xinetd（不安全服务）" --result "${STATUS_OK}" --color GREEN
            AddHP 3 3
        else
            LogText "结果：xinetd 配置中发现一个或多个不安全服务"
            Display --indent 6 --text "- 正在检查 xinetd（不安全服务）" --result "${STATUS_WARNING}" --color RED
            AddHP 0 3
        fi
    fi
#
#################################################################################
#
    # Test        : INSE-8200
    # Description : Check if tcp_wrappers is installed when inetd/xinetd is active
    if [ ${INETD_ACTIVE} -eq 1 -o ${XINETD_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no INSE-8200 --package-manager-required --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "inetd/xinetd 活动时检查是否安装 tcp_wrappers"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：tcp_wrappers 是否已安装"
        FOUND=0
        PACKAGES="tcp_wrappers tcpd"
        for PACKAGE in ${PACKAGES}; do
            if PackageIsInstalled "${PACKAGE}"; then LogText "软件包 '${PACKAGE}' 已安装"; FOUND=1; fi
        done
        if [ ${FOUND} -eq 1 ]; then
            LogText "结果：tcp_wrappers 已安装"
            Display --indent 2 --text "- 正在检查 tcp_wrappers 安装状态" --result "${STATUS_OK}" --color GREEN
        else
            LogText "结果：未安装 tcp_wrappers"
            Display --indent 2 --text "- 正在检查 tcp_wrappers 安装状态" --result "${STATUS_SUGGESTION}" --color YELLOW
            #ReportSuggestion "${TEST_NO}" "When network services are using the inetd/xinetd service, the tcp_wrappers package should be installed"
        fi
    fi
