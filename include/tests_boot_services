            FIND=$(${FINDBINARY} -L ${CHECKDIR} -type f -print | ${SORTBINARY})
            if [ -n "${FIND}" ]; then
                LogText "结果：目录中发现文件，开始检查权限"
                for FILE in ${FIND}; do
                    LogText "检查：检查文件 ${FILE} 的权限"
                    ShowSymlinkPath "${FILE}"
                    if [ ${FOUNDPATH} -eq 1 ]; then
                        CHECKFILE="${SYMLINK}"
                        LogText "结果：发现符号链接指向的路径（${CHECKFILE} --> ${FILE}）"
                    else
                        CHECKFILE="${FILE}"
                    fi
                    if IsWorldWritable ${CHECKFILE}; then
                        FOUND=1
                        LogText "结果：警告，文件 ${CHECKFILE} 可被所有用户写入"
                    else
                        LogText "结果：正常，文件 ${CHECKFILE} 不可被所有用户写入"
                    fi
                done
            else
                LogText "结果：目录中未发现文件。"
            fi
        else
            LogText "结果：未找到目录 ${CHECKDIR}，跳过。"
        fi

        # Other files
        CHECKFILES="${ROOTDIR}etc/rc ${ROOT}etc/rc.conf ${ROOT}etc/rc.conf.local ${ROOTDIR}etc/rc.local"
        for I in ${CHECKFILES}; do
            if [ -f ${I} ]; then
                ShowSymlinkPath "${I}"
                if [ ${FOUNDPATH} -eq 1 ]; then
                    CHECKFILE="${SYMLINK}"
                    LogText "结果：发现符号链接指向的路径（${CHECKFILE} --> ${I}）"
                else
                    CHECKFILE="${I}"
                fi
                LogText "检查：检查文件 ${CHECKFILE} 的可写权限"
                if IsWorldWritable ${CHECKFILE}; then
                    FOUND=1
                    ReportWarning "${TEST_NO}" "发现可写的启动脚本 ${CHECKFILE}"
                    LogText "结果：警告，文件 ${CHECKFILE} 可被所有用户写入"
                else
                    LogText "结果：正常，文件 ${CHECKFILE} 不可被所有用户写入"
                fi
            fi
        done

        # Check results
        if [ ${FOUND} -eq 1 ]; then
            Display --indent 2 --text "- 检查启动文件权限" --result "${STATUS_WARNING}" --color RED
            ReportWarning "${TEST_NO}" "发现可被所有用户写入的启动脚本" "-" "-"
            LogText "结果：发现一个或多个可能被其他用户写入的脚本"
            AddHP 0 3
        else
            Display --indent 2 --text "- 检查启动文件权限" --result "${STATUS_OK}" --color GREEN
            AddHP 3 3
        fi
    fi
