#
    # Test        : BOOT-5264
    # Description : 运行 systemd-analyze security
    if [ -z "${SYSTEMDANALYZEBINARY}" ]; then SKIPREASON="systemd-analyze 不可用"; PREQS_MET="NO";
    else
        SYSTEMD_VERSION=$("${SYSTEMDANALYZEBINARY}" --version | ${AWKBINARY} '/^systemd / {print $2}')
        if [ "${SYSTEMD_VERSION}" -ge 240 ]; then PREQS_MET="YES"; else SKIPREASON="systemd-analyze 版本过旧（v${SYSTEMD_VERSION}），至少需要 v240"; PREQS_MET="NO"; fi
    fi
    Register --test-no BOOT-5264 --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --os Linux --weight L --network NO --category security --description "运行 systemd-analyze security"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：运行 systemd-analyze security"
        Display --indent 2 --text "- 运行 'systemd-analyze security'"
        Display --indent 6 --text "单元名称（暴露值）和安全等级"
        Display --indent 6 --text "--------------------------------"
        ${SYSTEMDANALYZEBINARY} security | while read UNIT EXPOSURE PREDICATE HAPPY; do
            if [ "${UNIT}" = "UNIT" ]; then
                continue
            fi
            STATUS="UNKNOWN"
            COLOR="BLACK"
            case ${PREDICATE} in
                PERFECT | SAFE | OK)
                    STATUS="${STATUS_PROTECTED}"
                    COLOR=GREEN
                ;;
                MEDIUM)
                    STATUS="${STATUS_MEDIUM}"
                    COLOR=WHITE
                ;;
                EXPOSED)
                    STATUS="${STATUS_EXPOSED}"
                    COLOR=YELLOW
                ;;
                UNSAFE | DANGEROUS)
                    STATUS="${STATUS_UNSAFE}"
                    COLOR=YELLOW
                ;;
            esac
            Display --indent 4 --text "- ${UNIT}（值=${EXPOSURE}）" --result "${STATUS}" --color "${COLOR}"
            LogText "结果：${UNIT} 的暴露值为 ${EXPOSURE}，安全等级为 '${STATUS}'"
        done
        ReportSuggestion "${TEST_NO}" "考虑加强系统服务的安全配置" "对每个服务运行 '${SYSTEMDANALYZEBINARY} security SERVICE'"
    fi
