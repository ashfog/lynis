#################################################################################
#
    # Test        : BOOT-5139
    # Description : Check for LILO boot loader
    # Notes       : password= or password =
    Register --test-no BOOT-5139 --weight L --network NO --category security --description "检查 LILO 启动加载器"
    if [ ${SKIPTEST} -eq 0 ]; then
        BOOT_LOADER_SEARCHED=1
        LILOCONFFILE="${ROOTDIR}etc/lilo.conf"
        LogText "检查：查找 LILO 配置文件"
        if [ -f ${LILOCONFFILE} ]; then
            FileIsReadable ${LILOCONFFILE}
            if [ ${CANREAD} -eq 1 ]; then
                BOOT_LOADER="LILO"
                BOOT_LOADER_FOUND=1
                Display --indent 2 --text "- 检查 LILO" --result "${STATUS_OK}" --color GREEN
                LogText "检查 LILO 密码选项"
                FIND=$(${GREPBINARY} -E 'password[[:space:]]?=' ${LILOCONFFILE} | ${GREPBINARY} -v "^#")
                if [ -z "${FIND}" ]; then
                    if [ "${MACHINE_ROLE}" = "server" -o "${MACHINE_ROLE}" = "workstation" ]; then
                        Display --indent 4 --text "- 密码选项 " --result "${STATUS_WARNING}" --color RED
                        LogText "结果：LILO 未设置密码，可能被用于进入单用户模式或未经授权访问设备和数据。"
                        ReportSuggestion "${TEST_NO}" "为 LILO 添加密码：在 lilo.conf 中第一个 'image=<name>' 行之前添加 password=<password>"
                        ReportWarning "${TEST_NO}" "LILO 启动加载器未设置密码"
                        AddHP 0 2
                    elif [ "${MACHINE_ROLE}" = "personal" ]; then
                        Display --indent 4 --text "- 密码选项 " --result "${STATUS_WARNING}" --color yellow
                        LogText "结果：LILO 未设置密码，可能被用于进入单用户模式或未经授权访问设备和数据。"
                        ReportSuggestion "${TEST_NO}" "LILO 启动加载器未设置密码。为 LILO 添加密码：在 lilo.conf 中第一个 'image=<name>' 行之前添加 password=<password>"
                        AddHP 1 2
                    else
                        LogText "结果：LILO 未设置密码，且计算机角色未知"
                    fi
                else
                    Display --indent 4 --text "- 密码选项 " --result "${STATUS_OK}" --color GREEN
                    LogText "结果：已设置 LILO 密码选项"
                    AddHP 4 4
                fi
            else
                LogText "结果：无法读取 ${LILOCONFFILE}（权限不足）"
            fi
        else
            LogText "结果：未找到 LILO 配置文件"
        fi
    fi
