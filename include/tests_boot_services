#################################################################################
#
    # Test        : BOOT-5116
    # Description : 检查系统是否以 UEFI 模式启动
    Register --test-no BOOT-5116 --weight L --network NO --root-only YES --category security --description "检查系统是否以 UEFI 模式启动"
    if [ ${SKIPTEST} -eq 0 ]; then
        UEFI_TESTS_PERFORMED=0
        case ${OS} in
            Linux)
                UEFI_TESTS_PERFORMED=1
                # Check if UEFI is available in this boot
                LogText "检查：确认是否使用 UEFI"
                if [ -d ${ROOTDIR}sys/firmware/efi ]; then
                    LogText "结果：系统以 UEFI 模式启动"
                    UEFI_BOOTED=1
                else
                    LogText "结果：未使用 UEFI，找不到 /sys/firmware/efi 目录"
                fi

                # Test if Secure Boot is enabled
                LogText "检查：确定是否使用 Secure Boot"
                if [ -d ${ROOTDIR}sys/firmware/efi/efivars ]; then
                    FIND=$(${LSBINARY} ${ROOTDIR}sys/firmware/efi/efivars/SecureBoot-* 2> /dev/null)
                    if [ -n "${FIND}" ]; then
                        for FILE in ${FIND}; do
                            LogText "检查：检查文件 ${FILE}"
                            # TODO: add detection for od
                            J=$(od -An -t u1 ${FILE} | ${AWKBINARY} '{ print $5 }')
                            if [ "${J}" = "1" ]; then
                                LogText "结果：发现已启用状态的 SecureBoot 文件"
                                UEFI_BOOTED_SECURE=1
                            else
                                LogText "结果：系统未通过 Secure Boot 启动（文件 ${FILE} 中状态为 0）"
                            fi
                        done
                    fi
                else
                    LogText "结果：系统未通过 Secure Boot 启动（未找到 SecureBoot 文件）"
                fi
            ;;
            #macOS)
            # TODO: macOS ioreg -l -p IODeviceTree | ${GREPBINARY} firmware-abi
            #;;
            *)
                LogText "结果：尚未为此平台实现 UEFI 检查"
            ;;
        esac
        if [ ${UEFI_BOOTED} -eq 1 ]; then
            Display --indent 2 --text "- 检查 UEFI 启动" --result "${STATUS_ENABLED}" --color GREEN
            if [ ${UEFI_BOOTED_SECURE} -eq 1 ]; then
                Display --indent 2 --text "- 检查 Secure Boot" --result "${STATUS_ENABLED}" --color GREEN
            else
                Display --indent 2 --text "- 检查 Secure Boot" --result "${STATUS_DISABLED}" --color YELLOW
            fi
        else
            if [ ${UEFI_TESTS_PERFORMED} -eq 1 ]; then
                Display --indent 2 --text "- 检查 UEFI 启动" --result "${STATUS_DISABLED}" --color WHITE
            fi
        fi
    fi
