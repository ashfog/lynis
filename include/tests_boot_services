#################################################################################
#
    # Test        : BOOT-5202
    # Description : 检查系统运行时间
    Register --test-no BOOT-5202 --weight L --network NO --category security --description "检查系统运行时间"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        FIND=""
        UPTIME_IN_SECS=""
        case "${OS}" in
            Linux)
                # Idle time, not real uptime
                if [ -f /proc/uptime ]; then
                    UPTIME_IN_SECS=$(${CUTBINARY} -d ' ' -f1 /proc/uptime | ${CUTBINARY} -d '.' -f1)
                else
                    Display --indent 2 --text "- 检查运行时间" --result "${STATUS_SKIPPED}" --color YELLOW
                    ReportException "${TEST_NO}:1" "此操作系统没有可用的运行时间检查（缺少 /proc/uptime）"
                fi
            ;;

            DragonFly | FreeBSD | macOS)
                if [ -n "${SYSCTLBINARY}" ]; then
                    TIME_BOOT=$(${SYSCTLBINARY} kern.boottime | ${AWKBINARY} '{ print $5 }' | ${SEDBINARY} -e 's/,//' | ${GREPBINARY} "[0-9]")
                    TIME_NOW=$(date "+%s")
                    LogText "启动时间：${TIME_BOOT}"
                    LogText "当前时间：${TIME_NOW}"
                    if [ -n "${TIME_BOOT}" -a -n "${TIME_NOW}" ]; then
                        UPTIME_IN_SECS=$((TIME_NOW - TIME_BOOT))
                    else
                        ReportException "${TEST_NO}:5" "kern.boottime 可能为空，无法确定运行时间"
                    fi
                else
                    Display --indent 2 --text "- 检查运行时间" --result "${STATUS_SKIPPED}" --color YELLOW
                    ReportException "${TEST_NO}:4" "此操作系统没有可用的运行时间检查（缺少 sysctl）"
                fi
            ;;

            NetBSD | OpenBSD)
                if [ -n "${SYSCTLBINARY}" ]; then
                    TIME_BOOT=$(${SYSCTLBINARY} -n kern.boottime)
                    TIME_NOW=$(date "+%s")
                    LogText "启动时间：${TIME_BOOT}"
                    LogText "当前时间：${TIME_NOW}"
                    if [ -n "${TIME_BOOT}" -a -n "${TIME_NOW}" ]; then
                        UPTIME_IN_SECS=$((TIME_NOW - TIME_BOOT))
                    else
                        ReportException "${TEST_NO}:5" "kern.boottime 可能为空，无法确定运行时间"
                    fi
                else
                    Display --indent 2 --text "- 检查运行时间" --result "${STATUS_SKIPPED}" --color YELLOW
                    ReportException "${TEST_NO}:4" "此操作系统没有可用的运行时间检查（缺少 sysctl）"
                fi
            ;;

            Solaris)
                if [ -n "${KSTATBINARY}" ]; then
                    UPTIME_IN_SECS=$(${KSTATBINARY} -p unix:0:system_misc:snaptime | ${GREPBINARY} "^unix" | ${AWKBINARY} '{print $2}' | ${CUTBINARY} -d "." -f1)
                else
                    Display --indent 2 --text "- 检查运行时间" --result "${STATUS_SKIPPED}" --color YELLOW
                    ReportException "${TEST_NO}:2" "此操作系统没有可用的运行时间检查（缺少 kstat）"
                fi
            ;;

            *)
                Display --indent 2 --text "- 检查运行时间" --result "${STATUS_SKIPPED}" --color YELLOW

                # Want to help improving Lynis? Share your operating system and a way to determine the uptime (in seconds)
                ReportException "${TEST_NO}:3" "尚未为此操作系统提供运行时间检查"
            ;;
        esac

        if [ -n "${UPTIME_IN_SECS}" ]; then
            UPTIME_IN_DAYS=$((UPTIME_IN_SECS / 60 / 60 / 24))
            LogText "运行时间（秒）：${UPTIME_IN_SECS}"
            LogText "运行时间（天）：${UPTIME_IN_DAYS}"
            Report "uptime_in_seconds=${UPTIME_IN_SECS}"
            Report "uptime_in_days=${UPTIME_IN_DAYS}"
        else
            LogText "结果：没有可用的运行时间信息"
        fi
    fi
