#
    # Test        : TOOL-5104
    # Description : Check for Fail2ban enabled tests
    if [ ${PERFORM_FAIL2BAN_TESTS} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no TOOL-5104 --weight L --network NO --preqs-met ${PREQS_MET} --category security --description "已启用 检查 在 Fail2ban"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${FAIL2BANCLIENT} -d | ${TRBINARY} -d '[]' | ${TRBINARY} -d "'" | ${AWKBINARY} -F, '{ if ($1=="add") { print $2 }}' | ${TRBINARY} -d ' ')
        if [ -n "${FIND}" ]; then
            for F2BSERVICE in ${FIND}; do
                LogText "结果：服务 '${F2BSERVICE}' 已启用"
                Report "fail2ban_enabled_service[]=${F2BSERVICE}"
            done
            LogText "结果： 发现 在 least 一个 已启用 jail"
            Display --indent 4 --text "- 检查 Fail2ban jails" --result "${STATUS_ENABLED}" --color GREEN
            AddHP 3 3
        else
            LogText "结果： Fail2ban 已安装 but completely 已禁用"
            Display --indent 4 --text "- 检查 Fail2ban jails" --result "${STATUS_DISABLED}" --color RED
            AddHP 0 5
            ReportWarning "${TEST_NO}" "所有 jails 在 Fail2ban 是 已禁用" "${FAIL2BAN_CONFIG}"
        fi
    fi
