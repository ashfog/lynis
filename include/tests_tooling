#################################################################################
#
    # Test        : TOOL-5130
    # Description : Check for Suricata
    Register --test-no TOOL-5130 --weight L --network NO --category security --description "检查 用于 当前 Suricata 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Suricata presence
        if [ -n "${SURICATABINARY}" ]; then
            Report "ids_ips_tooling[]=suricata"
            LogText "结果： Suricata 是 已安装 (${SURICATABINARY})"
            # Suricata status
            # Suricata sets its process name to Suricata-Main on Linux, but this might differ on other platforms,
            # so fall back to checking the full commandline instead if the first test fails
            if IsRunning "Suricata-Main" || IsRunning --full "${SURICATABINARY} "; then
                # Only satisfy test TOOL-5190 if Suricata is actually running
                IDS_IPS_TOOL_FOUND=1
                LogText "结果： Suricata 守护进程 是 当前"
                Display --indent 2 --text "- 检查 Suricata 状态" --result "${STATUS_RUNNING}" --color GREEN
            else
                LogText "结果： Suricata 守护进程 不 当前"
                Display --indent 2 --text "- 检查 Suricata 状态" --result "${STATUS_NOT_RUNNING}" --color YELLOW
            fi
        else
            LogText "结果： Suricata 不 已安装 (suricata 未找到)"
        fi
    fi
