    # Test        : TOOL-5126
    # Description : Check for OSSEC
    Register --test-no TOOL-5126 --weight L --network NO --category security --description "检查 用于 当前 OSSEC 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Server side
        if IsRunning "ossec-analysisd"; then
            IDS_IPS_TOOL_FOUND=1
            Report "ids_ips_tooling[]=ossec"
            Report "ids_ips_tooling[]=ossec-analysisd"
            LogText "结果： OSSEC 分析 守护进程 是 当前"
            Display --indent 2 --text "- 检查 presence 的 OSSEC (分析)" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果： OSSEC 分析 守护进程 不 当前"
        fi

        # Client side
        if IsRunning "ossec-agentd"; then
            IDS_IPS_TOOL_FOUND=1
            Report "ids_ips_tooling[]=ossec"
            Report "ids_ips_tooling[]=ossec-agentd"
            LogText "结果： OSSEC agent 守护进程 是 当前"
            Display --indent 2 --text "- 检查 presence 的 OSSEC (agent)" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果： OSSEC agent 守护进程 不 当前"
        fi
    fi
