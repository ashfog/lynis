    # Test        : HTTP-6720
    # Description : Search for nginx log files
    if [ ${NGINX_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no HTTP-6720 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查Nginx日志文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查具有日志文件定义的文件目录"
        for DIR in ${NGINX_CONF_LOCS}; do
            LogText "测试：检查${DIR}"
            if [ -d ${DIR} ]; then
                LogText "结果：目录 ${DIR} 存在，将作为搜索路径"
                FIND=$(find ${DIR} -type f -exec ${GREPBINARY} access_log \{\} \; | ${GREPBINARY} -v "#" | ${AWKBINARY} '{ if($1=="access_log") { print $2 } }' | ${SEDBINARY} 's/;$//g' | ${SORTBINARY} -u)
                if IsEmpty "${FIND}"; then
                    LogText "结果：未找到日志文件"
                else
                    LogText "结果：找到一个或多个日志文件"
                    for FILE in ${FIND}; do
                        if [ -f ${FILE} ]; then
                            LogText "找到日志文件：${FILE}"
                            Report "log_file=${FILE}"
                        else
                            LogText "发现不存在的日志文件：${FILE}"
                        fi
                    done
                fi
            else
                LogText "结果：未找到目录 ${DIR}，跳过在该目录中的搜索。"
            fi
        done
        unset DIR FILE FIND
    fi
