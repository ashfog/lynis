    # Test        : HTTP-6720
    # Description : Search for nginx log files
    if [ ${NGINX_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no HTTP-6720 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 Nginx 日志 文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 目录 用于 文件 使用 日志 文件 definitions"
        for DIR in ${NGINX_CONF_LOCS}; do
            LogText "检查： 检查 ${DIR}"
            if [ -d ${DIR} ]; then
                LogText "结果：目录 ${DIR} 存在，将作为搜索路径"
                FIND=$(find ${DIR} -type f -exec ${GREPBINARY} access_log \{\} \; | ${GREPBINARY} -v "#" | ${AWKBINARY} '{ if($1=="access_log") { print $2 } }' | ${SEDBINARY} 's/;$//g' | ${SORTBINARY} -u)
                if IsEmpty "${FIND}"; then
                    LogText "结果： 没有 日志 文件 发现"
                else
                    LogText "结果： 发现 一个 或 更多 日志 文件"
                    for FILE in ${FIND}; do
                        if [ -f ${FILE} ]; then
                            LogText "发现 日志 文件： ${FILE}"
                            Report "log_file=${FILE}"
                        else
                            LogText "发现 non existing 日志 文件： ${FILE}"
                        fi
                    done
                fi
            else
                LogText "结果：未找到目录 ${DIR}，跳过在该目录中的搜索。"
            fi
        done
        unset DIR FILE FIND
    fi
