                else
                    Display --indent 10 --text "- Insecure protocols 发现" --result "${STATUS_YES}" --color RED
                    ReportSuggestion "${TEST_NO}" "禁用 较弱 协议 在 nginx 配置"
                fi
            else
                Display --indent 8 --text "- Protocols 已配置" --result "${STATUS_NO}" --color RED
                NGINX_SSL_SUGGESTION=1
            fi
        else
            LogText "结果： 没有 SSL 配置 发现"
            Display --indent 6 --text "- SSL 已配置" --result "${STATUS_NO}" --color RED
            ReportSuggestion "${TEST_NO}" "添加 HTTPS 到 nginx 虚拟 主机 用于 enhanced protection 的 sensitive 数据 和 privacy"
            AddHP 1 5
        fi
        if [ ${NGINX_SSL_SUGGESTION} -eq 1 ]; then
            LogText "结果： 一个 或 更多 parts 的 nginx 配置 可以 为 enhanced regarding SSL"
            ReportSuggestion "${TEST_NO}" "更改 HTTPS 和 SSL 设置 用于 enhanced protection 的 sensitive 数据 和 privacy"
        fi
    fi
