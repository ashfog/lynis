#
    InsertSection "${SECTION_USERS_GROUPS_AND_AUTHENTICATION}"

    # Test        : AUTH-9204
    # Description : Check users with UID zero (0)
    # Notes       : Ignores :0: in file if match is in NIS related line
    Register --test-no AUTH-9204 --weight L --network NO --category security --description "检查 UID 为 0 的用户"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Search accounts with UID 0
        LogText "检查：搜索 UID 为 0 的账户"
        # Check if device is a QNAP, as the root user is called admin, and not root
        if [ ${QNAP_DEVICE} -eq 1 ]; then
            FIND=$(${GREPBINARY} ':0:' ${ROOTDIR}etc/passwd | ${GREPBINARY} -E -v '^#|^admin:|^(\+:\*)?:0:0:::' | ${CUTBINARY} -d ":" -f1,3 | ${GREPBINARY} ':0')
        else
            FIND=$(${GREPBINARY} ':0:' ${ROOTDIR}etc/passwd | ${GREPBINARY} -E -v '^#|^root:|^(\+:\*)?:0:0:::' | ${CUTBINARY} -d ":" -f1,3 | ${GREPBINARY} ':0')
        fi
        if [ -n "${FIND}" ]; then
            Display --indent 2 --text "- 管理员账户" --result "${STATUS_WARNING}" --color RED
            LogText "结果：发现多个管理员账户"
            ReportWarning "${TEST_NO}" "passwd 文件中发现多个 UID 为 0 的用户"
            for USER in ${FIND}; do
                LogText "管理员账户：${USER}"
                Report "user_with_uid_zero[]=${USER}"
                if [ "${USER}" = "toor" ]; then
                    LogText "BSD 说明：系统默认安装了用户 'toor'。除非为其设置密码并用于"
                    LogText "日常操作或紧急情况，否则通常无需保留，例如 root 用户的 Shell 配置异常。"
                    ReportSuggestion "${TEST_NO}" "如未使用，请通过 vipw 删除 'toor' 用户。"
                fi
            done
        else
            Display --indent 2 --text "- 管理员账户" --result "${STATUS_OK}" --color GREEN
            LogText "结果：除 root 外未发现其他 UID 为 0 的账户。"
        fi
    fi
#
#################################################################################
#
    # Test        : AUTH-9208
    # Description : Check non-unique accounts
    Register --test-no AUTH-9208 --weight L --network NO --category security --description "检查 passwd 文件中的重复账户"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：查找重复账户"
        if  [ "${OS}" = "DragonFly" -o "${OS}" = "FreeBSD" -o "${OS}" = "NetBSD" -o "${OS}" = "OpenBSD" ]; then
            PASSWD_FILE="${ROOTDIR}etc/master.passwd"
          else
            PASSWD_FILE="${ROOTDIR}etc/passwd"
        fi
        # Check password file
        if [ -f ${PASSWD_FILE} ]; then
            FIND=$(${GREPBINARY} -v '^#' ${PASSWD_FILE} | ${CUTBINARY} -d ':' -f3 | ${SORTBINARY} | uniq -d)
            if [ "${FIND}" = "" ]; then
                Display --indent 2 --text "- UID 唯一性" --result "${STATUS_OK}" --color GREEN
                LogText "结果：${PASSWD_FILE} 中的所有账户 UID 均唯一"
            else
                Display --indent 2 --text "- UID 唯一性" --result "${STATUS_WARNING}" --color RED
                LogText "结果：发现多个账户使用相同 UID"
                LogText "输出（重复 UID）：${FIND}"
                ReportWarning "${TEST_NO}" "发现多个账户使用相同 UID"
            fi
          else
            Display --indent 2 --text "- UID 唯一性" --result "${STATUS_SKIPPED}" --color WHITE
            LogText "结果：${PASSWD_FILE} 文件不可用，跳过检查"
        fi
        LogText "说明：重复 UID 可能带来系统风险，也可能是配置错误"
    fi
