#
    # Test        : AUTH-9340
    # Description : Solaris 账户锁定
    Register --test-no AUTH-9340 --os Solaris --weight L --network NO --category security --description "Solaris 账户锁定"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        if [ -f ${ROOTDIR}etc/security/policy.conf ]; then
            LogText "结果：发现 ${ROOTDIR}etc/security/policy.conf"
            FIND=$(${GREPBINARY} "^LOCK_AFTER_RETRIES" /etc/security/policy.conf)
            if [ ! "${FIND}" = "" ]; then
                FOUND=1
                LogText "结果：已设置账户锁定选项"
                LogText "输出：${FIND}"
                AddHP 2 2
            else
                LogText "结果：未设置 LOCK_AFTER_RETRIES 选项"
                AddHP 1 2
            fi
        else
            LogText "结果：${ROOTDIR}etc/security/policy.conf 不存在"
        fi
        # If policy.conf does not exist, we most likely deal with a Solaris version below 10
        # and we proceed with checking the softer option RETRIES in /etc/default/login
        # which does not lock account, but discourages brute force password attacks.
        if [ ${FOUND} -eq 0 ]; then
            LogText "检查：检查 ${ROOTDIR}etc/default/login"
            if [ -f ${ROOTDIR}etc/default/login ]; then
                LogText "结果：文件 ${ROOTDIR}etc/default/login 存在"
                FIND=$(${GREPBINARY} "^RETRIES" ${ROOTDIR}etc/default/login)
                if [ -n "${FIND}" ]; then
                    FOUND=1
                    LogText "结果：已配置重试次数选项"
                    LogText "输出：${FIND}"
                    AddHP 2 2
                else
                    LogText "结果：未配置重试次数选项"
                    AddHP 1 2
                fi
            else
                LogText "结果：文件 ${ROOTDIR}etc/default/login 不存在"
            fi
        fi
        if [ ${FOUND} -eq 1 ]; then
            Display --indent 2 --text "- 检查账户锁定" --result "${STATUS_ENABLED}" --color GREEN
        else
            Display --indent 2 --text "- 检查账户锁定" --result "${STATUS_NOT_ENABLED}" --color YELLOW
        fi
    fi
