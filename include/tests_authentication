#
    # Test        : AUTH-9212
    # Description : 检查组文件 with chkgrp tool (ie FreeBSD)
    LogText "前置检查：/usr/sbin/chkgrp"
    if [ -x ${ROOTDIR}usr/sbin/chkgrp ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no AUTH-9212 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查组文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 2 --text "- 检查 chkgrp 工具" --result "${STATUS_FOUND}" --color GREEN
        LogText "结果：发现 /usr/sbin/chkgrp，将用它执行后续检查。"
        LogText "检查：验证 /etc/group 文件一致性"
        FIND=$(${ROOTDIR}usr/sbin/chkgrp | ${GREPBINARY} -v 'is fine')
        if [ "${FIND}" = "" ]; then
            Display --indent 4 --text "- 检查 /etc/group 文件一致性" --result "${STATUS_OK}" --color GREEN
            LogText "结果：chkgrp 检查完成，组文件看起来正常。"
          else
            Display --indent 4 --text "- 检查 /etc/group 文件一致性" --result "${STATUS_WARNING}" --color RED
            LogText "结果：chkgrp 发现错误，请手动运行该工具查看详情。"
            LogText "chkgrp 输出：${FIND}"
            ReportWarning "${TEST_NO}" "chkgrp 报告 /etc/group 文件存在不一致"
        fi
    fi
