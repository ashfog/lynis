            LogText "检查：确认脚本是否会执行另一个脚本。"
            FIND=$(${GREPBINARY} -i "^exec " /etc/init.d/rcS | ${AWKBINARY} '{ print $2 }')
            if [ "${FIND}" = "" ]; then
                FIND2=$(${GREPBINARY} -i "^UMASK" /etc/init.d/rcS | ${AWKBINARY} '{ print $2 }')
                if [ "${FIND2}" = "" ]; then
                    LogText "结果：未配置 UMASK 值，通常会使用默认值 022"
                    Display --indent 4 --text "- 检查 umask（/etc/init.d/rcS）" --result "${STATUS_SUGGESTION}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "未在 /etc/init.d/rcS 中找到默认 umask；通常默认为 022，可以改为更严格的 027"
                    AddHP 1 2
                elif [ "${FIND2}" = "077" -o "${FIND2}" = "027" ]; then
                    LogText "结果：umask 为 ${FIND2}，设置正常"
                    Display --indent 4 --text "- umask (/etc/init.d/rcS)" --result "${STATUS_OK}" --color GREEN
                    AddHP 2 2
                else
                    LogText "结果：发现 umask ${FIND2}，可以进一步收紧"
                    Display --indent 4 --text "- umask (/etc/init.d/rcS)" --result "${STATUS_SUGGESTION}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "可以将 /etc/init.d/rcS 中的默认 umask 设置得更严格，例如 027"
                    AddHP 0 2
                fi
            else
                # Improve check
                LogText "结果：文件中存在 exec 行，此脚本无需单独设置 umask"
                LogText "输出：${FIND}"
            fi
          else
            LogText "结果：文件 /etc/init.d/rcS 不存在"
        fi

    fi
