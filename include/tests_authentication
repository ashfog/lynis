#################################################################################
#
    # Test        : AUTH-9218
    # Description : 检查无密码账户的登录 Shell
    # Notes       : Results should be checked
    Register --test-no AUTH-9218 --os "DragonFly FreeBSD NetBSD OpenBSD" --root-only YES --weight L --network NO --category security --description "检查无密码账户的登录 Shell"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        LogText "检查：检查登录 Shell"
        if [ -f ${ROOTDIR}etc/master.passwd ]; then
            # Check for all shells, except: (/usr)/sbin/nologin /nonexistent
            FIND=$(${GREPBINARY} "[a-z]:\*:" ${ROOTDIR}etc/master.passwd | ${GREPBINARY} -E -v '^#|/sbin/nologin|/usr/sbin/nologin|/nonexistent' | ${SEDBINARY} 's/ /!space!/g')
            if [ -z "${FIND}" ]; then
                Display --indent 2 --text "- 登录 Shell" --result "${STATUS_OK}" --color GREEN
            else
                Display --indent 2 --text "- 登录 Shell" --result "${STATUS_WARNING}" --color RED
                for LINE in ${FIND}; do
                    LINE=$(echo ${LINE} | ${SEDBINARY} 's/!space!/ /g')
                    SHELL=$(echo ${LINE} | ${AWKBINARY} -F: '{ print $10 }')
                    LogText "输出：${LINE}"
                    if [ -z "${SHELL}" ]; then
                        LogText "结果：该行未发现 Shell"
                    else
                        LogText "结果：发现可能存在风险的 Shell ${SHELL}"
                        if [ -f ${SHELL} ]; then
                            LogText "结果：Shell ${SHELL} 存在"
                            FOUND=1
                        else
                            LogText "结果：Shell ${SHELL} 不存在"
                            ReportSuggestion "${TEST_NO}" "确认该账户是否仍有必要保留，因为 Shell ${SHELL} 不存在"
                        fi
                    fi
                done
                if [ ${FOUND} -eq 1 ]; then
                    ReportWarning "${TEST_NO}" "无密码账户使用了可能存在风险的 Shell"
                fi
            fi
          else
            Display --indent 2 --text "- 登录 Shell" --result "${STATUS_SKIPPED}" --color WHITE
            LogText "结果：未找到 ${ROOTDIR}etc/master.passwd 文件"
        fi
        unset LINE SHELL
    fi
