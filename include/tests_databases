                    AddHP 0 3
                    Display --indent 4 --text "- Redis（CONFIG 命令已重命名）" --result "${STATUS_NOT_FOUND}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "为 Redis 使用 'rename-command CONFIG' 设置" "${FILE}" "text:在 ${FILE} 中配置 'rename-command CONFIG'"
                    Report "redis_rename_command_config=0"
                fi
            else
                LogText "结果：无法读取配置文件，跳过检查"
            fi
        done
    fi
