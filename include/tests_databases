#################################################################################
#
    # Test        : DBS-1816
    # Description : Check empty MySQL root password
    # Notes       : Only perform test when MySQL is running and client is available
    if [ -n "${MYSQLCLIENTBINARY}" -a ${MYSQL_RUNNING} -eq 1 ]; then PREQS_MET="YES"; SKIPREASON=""; else PREQS_MET="NO"; SKIPREASON="未安装 MySQL 或 MySQL 未运行"; fi
    Register --test-no DBS-1816 --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --category security --description "检查 MySQL root 密码"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：尝试不使用密码登录本地 MySQL 服务器"

        # "-u root --password=" avoids ~/.my.cnf authentication settings
        # "plugin = 'mysql_native_password' AND authentication_string = ''" avoids false positives when secure plugins are used
        FIND=$(${MYSQLCLIENTBINARY} --default-auth=mysql_native_password  --no-defaults -u root --password= --silent --batch --execute="SELECT count(*) FROM mysql.user WHERE user = 'root' AND plugin = 'mysql_native_password' AND authentication_string = ''" mysql > /dev/null 2>&1; echo $?)
        if [ "${FIND}" = "0" ]; then
           LogText "结果：登录成功，MySQL root 账户未设置密码！"
           ReportWarning "${TEST_NO}" "MySQL root 账户未设置密码"
           Display --indent 4 --text "- 正在检查 MySQL root 空密码" --result "${STATUS_WARNING}" --color RED
           AddHP 0 5
        else
            LogText "结果：登录失败，说明 MySQL root 账户已设置密码"
            if IsVerbose; then Display --indent 4 --text "- 检查 MySQL root 密码" --result "${STATUS_OK}" --color GREEN; fi
            AddHP 2 2
        fi
    else
        LogText "检查已跳过：MySQL 守护进程未运行或没有可用的 MySQL 客户端"
    fi
