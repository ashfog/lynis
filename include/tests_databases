                    Report "redis_bind_localhost=1"
                else
                    AddHP 0 3
                    Display --indent 4 --text "- Redis（绑定到本地主机）" --result "${STATUS_NOT_FOUND}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "使用 'bind' 设置让 Redis 实例仅监听本地主机" "${FILE}" "text:在 ${FILE} 中配置 'bind localhost'"
                    Report "redis_bind_localhost=0"
                fi
            else
                LogText "结果：无法读取配置文件，跳过检查"
            fi
        done
    fi
#
#################################################################################
#
    if [ ${DATABASE_ENGINE_RUNNING} -eq 0 ]; then
        Display --indent 4 --text "未发现数据库引擎"
    fi
