#################################################################################
#
    InsertSection "${SECTION_ACCOUNTING}"
#
#################################################################################
#
    AUDITD_CONF_LOCS="${ROOTDIR}etc ${ROOTDIR}etc/audit"
    AUDITD_CONF_FILE=""
    CMD_CONF_LOCS="${ROOTDIR}etc ${ROOTDIR}etc/cmd"
    CMD_CONF_FILE=""
    LINUX_AUDITD_RUNNING=0
    LINUX_CMD_RUNNING=0
    AUDIT_DAEMON_RUNNING=0
    SOLARIS_AUDITD_RUNNING=0
#
#################################################################################
#
    # Test        : ACCT-2754
    # Description : Check availability FreeBSD accounting data
    Register --test-no ACCT-2754 --os FreeBSD --weight L --network NO --category security --description "检查可用的 FreeBSD 进程记账信息"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -f ${ROOTDIR}var/account/acct ]; then
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_OK}" --color GREEN
            LogText "结果：${ROOTDIR}var/account/acct 可用"
            AddHP 3 3
        else
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_NOT_FOUND}" --color YELLOW
            LogText "结果：没有可用的进程记账信息"
            LogText "说明：进程记账数据可能存储在其他位置"
            ReportSuggestion "${TEST_NO}" "启用进程记账"
            AddHP 2 3
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-2760
    # Description : Check availability OpenBSD accounting data
    Register --test-no ACCT-2760 --os OpenBSD --weight L --network NO --category security --description "检查可用的 OpenBSD 进程记账信息"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -f ${ROOTDIR}var/account/acct ]; then
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_OK}" --color GREEN
            LogText "结果：${ROOTDIR}var/account/acct 可用"
            AddHP 3 3
        else
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_NOT_FOUND}" --color YELLOW
            LogText "结果：没有可用的进程记账信息"
            LogText "说明：进程记账数据可能存储在其他位置"
            ReportSuggestion "${TEST_NO}" "启用进程记账"
            AddHP 2 3
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9622
    # Description : Check availability Linux accounting data
    # Notes       : /var/log/pacct (Slackware)
    Register --test-no ACCT-9622 --os Linux --weight L --network NO --category security --description "检查可用的 Linux 进程记账信息"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查进程记账信息"
        if [ -f ${ROOTDIR}var/account/pacct ]; then
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_OK}" --color GREEN
            LogText "结果：${ROOTDIR}var/account/pacct 可用"
            AddHP 3 3
        elif [ -f ${ROOTDIR}var/log/account/pacct ]; then
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_OK}" --color GREEN
            LogText "结果：${ROOTDIR}var/log/account/pacct 可用"
            AddHP 3 3
        elif [ -f ${ROOTDIR}var/log/pacct ]; then
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_OK}" --color GREEN
            LogText "结果：${ROOTDIR}var/log/pacct 可用"
            AddHP 3 3
        else
            Display --indent 2 --text "- 检查进程记账信息" --result "${STATUS_NOT_FOUND}" --color YELLOW
            LogText "结果：没有可用的进程记账信息（${ROOTDIR}var/account/pacct、${ROOTDIR}var/log/account/pacct 和 ${ROOTDIR}var/log/pacct 均不存在）"
            LogText "说明：进程记账数据可能存储在其他位置"
            ReportSuggestion "${TEST_NO}" "启用进程记账"
            AddHP 2 3
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9626
    # Description : Check sysstat accounting data
    Register --test-no ACCT-9626 --os Linux --weight L --network NO --category security --description "检查 sysstat 记账数据"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认 ${ROOTDIR}etc/default/sysstat 是否存在"
        if [ -f ${ROOTDIR}etc/default/sysstat ]; then
            LogText "结果：发现 ${ROOTDIR}etc/default/sysstat"
            FIND=$(${GREPBINARY} "^ENABLED" ${ROOTDIR}etc/default/sysstat | ${GREPBINARY} -i true)
            if [ -n "${FIND}" ]; then
                LogText "结果：通过 ${ROOTDIR}etc/default/sysstat 启用了 sysstat"
                Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_ENABLED}" --color GREEN
            else
                LogText "结果：通过 ${ROOTDIR}etc/default/sysstat 禁用了 sysstat"
                Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_DISABLED}" --color WHITE
                ReportSuggestion "${TEST_NO}" "启用 sysstat 以收集记账数据（当前已禁用）"
            fi
        elif [ -f ${ROOTDIR}etc/cron.d/sysstat ]; then
            FIND=$(${GREPBINARY} -v '^[[:space:]]*\(#\|$\)' ${ROOTDIR}etc/cron.d/sysstat)
            if [ -n "${FIND}" ]; then
                LogText "结果：通过 ${ROOTDIR}etc/cron.d/sysstat 启用了 sysstat"
                Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_ENABLED}" --color GREEN
            else
                LogText "结果：通过 ${ROOTDIR}etc/cron.d/sysstat 禁用了 sysstat"
                Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_DISABLED}" --color WHITE
                ReportSuggestion "${TEST_NO}" "启用 sysstat 以收集记账数据（cron 当前已禁用）"
            fi
        elif [ -f "${ROOTDIR}lib/systemd/system/sysstat.service" ] || [ -f "${ROOTDIR}etc/systemd/system/sysstat.service" ]; then
            LogText "结果：发现 sysstat systemd 单元"
            if [ -L "${ROOTDIR}etc/systemd/system/multi-user.target.wants/sysstat.service" ]; then
                # Assuming -collect.timer and -summary.timer are enabled as well,
                # as they are usually in the install section.
                LogText "结果：通过 systemd 启用了 sysstat"
                Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_ENABLED}" --color GREEN
            else
                LogText "结果：通过 systemd 禁用了 sysstat"
                Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_DISABLED}" --color WHITE
            fi
        else
            LogText "结果：未在 ${ROOTDIR}etc/default/sysstat、${ROOTDIR}etc/cron.d/sysstat 或 systemd 单元中发现 sysstat"
            Display --indent 2 --text "- 检查 sysstat 记账数据" --result "${STATUS_NOT_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "启用 sysstat 以收集记账数据（当前未发现配置）"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9628
    # Description : Check auditd status
    if [ -n "${AUDITDBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9628 --os Linux --weight L --network NO --category security --description "检查 auditd"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查 auditd 状态"
        # Should not get kauditd
        if IsRunning "auditd"; then
            LogText "结果：auditd 正在运行"
            Display --indent 2 --text "- 检查 auditd" --result "${STATUS_ENABLED}" --color GREEN
            LINUX_AUDITD_RUNNING=1
            AUDIT_DAEMON_RUNNING=1
            Report "audit_trail_tool[]=auditd"
            Report "linux_auditd_running=1"
            AddHP 4 4
        else
            LogText "结果：auditd 未运行"
            Display --indent 2 --text "- 检查 auditd" --result "${STATUS_NOT_FOUND}" --color WHITE
            if [ ! "${VMTYPE}" = "openvz" ]; then
                ReportSuggestion "${TEST_NO}" "启用 auditd 以收集审计信息"
            fi
            AddHP 0 1
            Report "linux_auditd_running=0"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9630
    # Description : Check auditd rules
    if [ -n "${AUDITDBINARY}" -a -n "${AUDITCTLBINARY}" -a ${LINUX_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9630 --os Linux --preqs-met ${PREQS_MET} --weight L --network NO --root-only YES --category security --description "检查 auditd rules"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查 auditd 规则"
        FIND=$(${AUDITCTLBINARY} -l | ${GREPBINARY} -v "No rules")
        if [ -z "${FIND}" ]; then
            LogText "结果：auditd 规则为空"
            Display --indent 4 --text "- 检查审计规则" --result "${STATUS_SUGGESTION}" --color YELLOW
            AddHP 0 2
            ReportSuggestion "${TEST_NO}" "审计守护进程已启用，但规则集为空；请禁用该守护进程或定义审计规则"
        else
            LogText "结果：发现 auditd 规则"
            Display --indent 4 --text "- 检查审计规则" --result "${STATUS_OK}" --color GREEN
            # Log audit daemon rules
            FIND=$(${AUDITCTLBINARY} -l | ${SEDBINARY} 's/ /!space!/g')
            for RULE in ${FIND}; do
                RULE=$(echo ${RULE} | ${SEDBINARY} 's/!space!/ /g')
                LogText "输出：${RULE}"
            done
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9632
    # Description : Check auditd configuration file
    if [ -n "${AUDITDBINARY}" -a ${LINUX_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9632 --os Linux --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 auditd 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查 auditd 配置文件"
        for DIR in ${AUDITD_CONF_LOCS}; do
            if [ -f ${DIR}/auditd.conf ]; then
                AUDITD_CONF_FILE="${DIR}/auditd.conf"
                LogText "结果：发现 ${DIR}/auditd.conf"
            else
                LogText "结果：未找到 ${DIR}/auditd.conf"
            fi
        done
        # Check if we discovered the configuration file. It should be there is the binaries are available and process is running
        if [ -n "${AUDITD_CONF_FILE}" ]; then
            Display --indent 4 --text "- 检查审计配置文件" --result "${STATUS_OK}" --color GREEN
        else
            LogText "结果：找不到 auditd 配置文件"
            Display --indent 4 --text "- 检查审计配置文件" --result "${STATUS_FOUND}" --color RED
            ReportSuggestion "${TEST_NO}" "确定 auditd 配置文件的位置"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9634
    # Description : Check auditd log file
    if [ -n "${AUDITDBINARY}" -a ${LINUX_AUDITD_RUNNING} -eq 1 -a -n "${AUDITD_CONF_FILE}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9634 --os Linux --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 auditd 日志文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查 auditd 日志文件"
        DEFAULT_LOCATION="/var/log/audit/audit.log"
        FIND=$(${GREPBINARY} "^log_file" ${AUDITD_CONF_FILE} | ${AWKBINARY} '{ if ($1=="log_file" && $2=="=") { print $3 } }')
        if [ -n "${FIND}" ]; then
            LogText "结果：已定义日志文件"
            LogText "配置值：${FIND}"
        else
            LogText "结果：未定义日志文件"
            LogText "采用默认位置：${DEFAULT_LOCATION}"
            FIND="${DEFAULT_LOCATION}"
        fi

        if [ -f ${FIND} ]; then
            LogText "结果：日志文件 ${FIND} 存在"
            Display --indent 4 --text "- 检查 auditd 日志文件" --result "${STATUS_FOUND}" --color GREEN
            Report "logfile[]=${FIND}"
        else
            LogText "结果：磁盘上找不到日志文件 ${FIND}"
            Display --indent 4 --text "- 检查 auditd 日志文件" --result "${STATUS_SUGGESTION}" --color RED
            ReportWarning "${TEST_NO}" "检查 auditd 日志文件位置"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9636
    # Description : Check for Snoopy (wrapper for execve() and logger)
    Register --test-no ACCT-9636 --os Linux --weight L --network NO --category security --description "检查 Snoopy 命令包装器和日志记录器"
    if [ ${SKIPTEST} -eq 0 ]; then
        FILE="${ROOTDIR}lib/snoopy.so"
        if [ -f ${FILE} ]; then
            LogText "结果：发现 ${FILE}"
            Display --indent 2 --text "- 检查 Snoopy" --result "${STATUS_FOUND}" --color GREEN
            if [ -f ${ROOTDIR}etc/ld.so.preload ]; then
                LogText "结果：发现 ${ROOTDIR}etc/ld.so.preload，检查是否列出了 snoopy.so"
                FIND=$(${GREPBINARY} ${FILE} ${ROOTDIR}etc/ld.so.preload)
                if [ -n "${FIND}" ]; then
                    LogText "结果：在 ld.so.preload 中发现 snoopy"
                    LogText "输出：${FIND}"
                    Display --indent 6 --text "- ld.so.preload 中的库" --result "已加载" --color GREEN
                    Report "audit_trail_tool[]=snoopy"
                else
                    Display --indent 6 --text "- ld.so.preload 中的库" --result "${STATUS_NOT_FOUND}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "Snoopy 已安装，但未通过 ${ROOTDIR}etc/ld.so.preload 加载"
                    AddHP 3 3
                fi
            else
                LogText "结果：${ROOTDIR}etc/ld.so.preload 不存在"
                Display --indent 6 --text "- ld.so.preload 中的库" --result "${STATUS_UNKNOWN}" --color PURPLE
                ReportException "${TEST_NO}:1" "由于 ld.so.preload 不存在，无法确定 Snoopy 的加载方式"
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9650
    # Description : 检查 Solaris 审计守护进程 presence
    Register --test-no ACCT-9650 --os Solaris --weight L --network NO --category security --description "检查 Solaris 审计守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认审计守护进程是否正在运行"
        if IsRunning "auditd"; then
            LogText "结果：Solaris 审计守护进程正在运行"
            SOLARIS_AUDITD_RUNNING=1
            AUDIT_DAEMON_RUNNING=1
            Display --indent 2 --text "- 检查 Solaris 审计守护进程状态" --result "${STATUS_RUNNING}" --color GREEN
        else
            LogText "结果：Solaris 审计守护进程未运行"
            Display --indent 2 --text "- 检查 Solaris 审计守护进程状态" --result "${STATUS_NOT_RUNNING}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9652
    # Description : Check Solaris auditd service status
    if [ -x ${ROOTDIR}usr/bin/svcs -a ${SOLARIS_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9652 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 auditd 的 SMF 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认 auditd 服务是否已启用并在线"
        FIND=$(${ROOTDIR}usr/bin/svcs svc:/system/auditd:default | ${GREPBINARY} "^online")
        if [ -n "${FIND}" ]; then
            LogText "结果：auditd 服务在线"
            Display --indent 4 --text "- 检查 Solaris 审计守护进程状态" --result "${STATUS_ON}"LINE --color GREEN
        else
            Display --indent 4 --text "- 检查 Solaris 审计守护进程状态" --result "未在线" --color YELLOW
            ReportSuggestion "${TEST_NO}" "检查审计守护进程状态"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9654
    # Description : Check Solaris Basic Security Mode (BSM) in /etc/system
    if [ ${SOLARIS_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9654 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 ${ROOTDIR}etc/system 中的 BSM 审计"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认 ${ROOTDIR}etc/system 中是否启用了 BSM"
        if [ -f ${ROOTDIR}etc/system ]; then
            FIND=$(${GREPBINARY} 'set c2audit:audit_load = 1' ${ROOTDIR}etc/system)
            if [ -n "${FIND}" ]; then
                LogText "结果：${ROOTDIR}etc/system 中已启用 BSM"
                Display --indent 4 --text "- 检查 Solaris BSM（${ROOTDIR}etc/system）" --result "${STATUS_ENABLED}" --color GREEN
            else
                Display --indent 4 --text "- 检查 Solaris BSM（${ROOTDIR}etc/system）" --result "${STATUS_NOT_FOUND}" --color YELLOW
            fi
        else
            LogText "结果：${ROOTDIR}etc/system 不存在"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9656
    # Description : Check Solaris BSM (c2audit) module status
    # Notes       : todo - replace direct binary call
    if [ ${SOLARIS_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9656 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查模块列表中的 BSM 审计"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认 c2audit 模块是否处于活动状态"
        if [ -x ${ROOTDIR}usr/sbin/modinfo ]; then
            FIND=$(${ROOTDIR}usr/sbin/modinfo | ${GREPBINARY} c2audit)
            if [ -n "${FIND}" ]; then
                LogText "结果：在 modinfo 输出中发现 c2audit"
                Display --indent 4 --text "- 检查 Solaris BSM（模块列表）" --result "${STATUS_ENABLED}" --color GREEN
            else
                LogText "结果：在 modinfo 输出中未发现 c2audit"
                Display --indent 4 --text "- 检查 Solaris BSM（模块列表）" --result "${STATUS_NOT_FOUND}" --color YELLOW
            fi
        else
            LogText "结果：${ROOTDIR}usr/sbin/modinfo 不存在，跳过检查"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9660
    # Description : Check location for audit events
    if [ ${SOLARIS_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9660 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查审计事件存储位置"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在 ${ROOTDIR}etc/security/audit_control 中检查事件日志位置"
        if [ -f ${ROOTDIR}etc/security/audit_control ]; then
            LogText "结果：发现文件 ${ROOTDIR}etc/security/audit_control"
            FIND=$(${GREPBINARY} "^dir" ${ROOTDIR}etc/security/audit_control | ${AWKBINARY} -F: '{ print $2 }')
            if [ -n "${FIND}" ]; then
                LogText "结果：发现位置 ${FIND}"
                LogText "检查：确认该位置是否为有效目录"
                if [ -d ${FIND} ]; then
                    LogText "结果：位置 ${FIND} 有效"
                    Display --indent 4 --text "- 检查 Solaris 审计位置" --result "${STATUS_FOUND}" --color GREEN
                else
                    LogText "结果：位置 ${FIND} 不存在"
                    Display --indent 4 --text "- 检查 Solaris 审计位置" --result "${STATUS_NOT_FOUND}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "检查 Solaris 审计目录是否可用"
                fi
            else
                LogText "结果：审计事件位置未知"
                Display --indent 4 --text "- 检查 Solaris 审计位置" --result "${STATUS_UNKNOWN}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "检查 Solaris 审计目录是否配置正确"
            fi
        else
            LogText "结果：找不到 ${ROOTDIR}etc/security/audit_control"
            Display --indent 4 --text "- 检查 Solaris 审计位置" --result "${STATUS_SKIPPED}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9662
    # Description : check auditstat
    if [ ${SOLARIS_AUDITD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9662 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 Solaris 审计统计信息"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查审计统计信息"
        if [ -x ${ROOTDIR}usr/sbin/auditstat ]; then
            FIND=$(${ROOTDIR}usr/sbin/auditstat | ${TRBINARY} -s ' ' ',')
            for ITEM in ${FIND}; do
                LogText "输出：${ITEM}"
            done
            Display --indent 4 --text "- 检查 Solaris 审计统计信息" --result "${STATUS_DONE}" --color GREEN
        else
            LogText "结果：未找到 ${ROOTDIR}usr/sbin/auditstat，跳过检查"
            Display --indent 4 --text "- 检查 Solaris 审计统计信息" --result "${STATUS_SKIPPED}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9670
    # Description : Check cmd status
    if [ -n "${CMDBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9670 --os Linux --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 cmd"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查 cmd 状态"
        if IsRunning "cmd_daemon"; then
            LogText "结果：cmd 正在运行"
            Display --indent 2 --text "- 检查 cmd" --result "${STATUS_ENABLED}" --color GREEN
            LINUX_CMD_RUNNING=1
            AUDIT_DAEMON_RUNNING=1
            Report "audit_trail_tool[]=cmd"
            Report "linux_cmd_running=1"
            AddHP 4 4
        else
            LogText "结果：cmd 未运行"
            Display --indent 2 --text "- 检查 cmd" --result "${STATUS_NOT_FOUND}" --color WHITE
            if [ ! "${VMTYPE}" = "openvz" ]; then
                ReportSuggestion "${TEST_NO}" "安装 cmd 以收集审计信息"
            fi
            AddHP 0 1
            Report "linux_cmd_running=0"
        fi
    fi
#
#################################################################################
#
    # Test        : ACCT-9672
    # Description : Check cmd configuration file
    if [ -n "${CMDBINARY}" -a ${LINUX_CMD_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no ACCT-9672 --os Linux --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 cmd 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查 cmd 配置文件"
        for DIR in ${CMD_CONF_LOCS}; do
            if [ -f ${DIR}/config.ini ]; then
                CMD_CONF_FILE="${DIR}/config.ini"
                LogText "结果：发现 ${DIR}/config.ini"
            else
                LogText "结果：未找到 ${DIR}/config.ini"
            fi
        done
        # Check if we discovered the configuration file. It should be there is the binaries are available and process is running
        if [ -n "${CMD_CONF_FILE}" ]; then
            Display --indent 4 --text "- 检查 cmd 配置文件" --result "${STATUS_OK}" --color GREEN
        else
            LogText "结果：找不到 cmd 配置文件"
            Display --indent 4 --text "- 检查 cmd 配置文件" --result "${STATUS_FOUND}" --color RED
            ReportSuggestion "${TEST_NO}" "确定 cmd 配置文件的位置"
        fi
    fi
#
#################################################################################
#
    Report "audit_daemon_running=${AUDIT_DAEMON_RUNNING}"
#
#################################################################################
#

WaitForKeyPress

