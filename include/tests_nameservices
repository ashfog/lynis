#################################################################################
#
    # Test        : NAME-4028
    # Description : Check DNS domain name
    # To Do       : ${GREPBINARY} ^DOMAINNAME /etc/conf.d/domainname (remove "'s)
    Register --test-no NAME-4028 --weight L --network NO --category security --description "检查域名"
    if [ ${SKIPTEST} -eq 0 ]; then
        DOMAINNAME=""
        LogText "测试：检查 dnsdomainname 命令是否可用"
        if HasData "${DNSDOMAINNAMEBINARY}"; then
            FIND2=$(${DNSDOMAINNAMEBINARY} 2> /dev/null)
            if HasData "${FIND2}"; then
                LogText "结果：dnsdomainname 命令返回一个值"
                LogText "查到域名：${FIND2}"
                DOMAINNAME="${FIND2}"
            else
                LogText "结果：dnsdomainname 命令未返回任何值"
            fi
        else
            LogText "结果：未找到 dnsdomainname 程序，跳过该项检查"
        fi

        # If files and commands can't be found, use defined value from resolv.conf
        if [ -z "${DOMAINNAME}" ]; then
            if [ -n "${RESOLV_DOMAINNAME}" ]; then
                LogText "结果：使用来自 ${ROOTDIR}etc/resolv.conf 的域名"
                DOMAINNAME=${RESOLV_DOMAINNAME}
            else
                LogText "结果：使用 FQDN 主机名 (${FQDN}) 中的域名"
                DOMAINNAME=$(echo ${FQDN} | ${AWKBINARY} -F. '{print $2}')
            fi
        fi

        if [ -n "${DOMAINNAME}" ]; then
            LogText "结果：找到域名"
            Report "domainname=${DOMAINNAME}"
            Display --indent 2 --text "- 搜索DNS域名" --result "${STATUS_FOUND}" --color GREEN
            Display --indent 6 --text "域名：${DOMAINNAME}"
        else
            Display --indent 2 --text "- 搜索DNS域名" --result "${STATUS_UNKNOWN}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "检查 dns 域名的 DNS 配置"
        fi
    fi
