#################################################################################
#
    # Test        : NAME-4306
    # Description : Check NIS domain
    # Notes       : FreeBSD: sysctl kern.domainname
    if [ ${YPBIND_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4306 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查NIS域名"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 $(domainname) 中的 NIS 域值"
        FIND=$(${DOMAINNAMEBINARY} | ${GREPBINARY} -v "(none)")
        if [ -n "${FIND}" ]; then
            LogText "值：${FIND}"
            NISDOMAIN="${FIND}"
        else
            LogText "结果：命令输出中未找到 NIS 域"
        fi
        # Solaris / Linux style
        LogText "测试：检查文件 ${ROOTDIR}etc/defaultdomain"
        if [ -f ${ROOTDIR}etc/defaultdomain ]; then
            LogText "结果：文件 ${ROOTDIR}etc/defaultdomain 存在"
            FIND2=$(cat ${ROOTDIR}etc/defaultdomain)
            if [ -n "${FIND2}" ]; then
                LogText "输出：${FIND2}"
                NISDOMAIN="${FIND2}"
            else
                LogText "结果：在文件中找不到 NIS 域"
            fi
        fi
        # Red Hat style
        LogText "测试：检查${ROOTDIR}etc/sysconfig/network"
        if [ -f ${ROOTDIR}etc/sysconfig/network ]; then
            LogText "结果：文件 ${ROOTDIR}etc/sysconfig/network 存在"
            LogText "测试：检查文件中的 NISDOMAIN 值"
            FIND3=$(${GREPBINARY} "^NISDOMAIN" ${ROOTDIR}etc/sysconfig/network | ${AWKBINARY} -F= '{ print $2 }' | ${SEDBINARY} 's/"//g')
            if [ -n "${FIND3}" ]; then
                LogText "找到 NIS 域名：${FIND3}"
                NISDOMAIN="${FIND3}"
            else
                LogText "结果：在文件中找不到 NIS 域"
            fi
        else
            LogText "结果：文件 ${ROOTDIR}etc/sysconfig/network 不存在"
        fi

        if [ ! "${SYSCTLBINARY}" = "" ]; then
            # Check sysctl (e.g. FreeBSD)
            LogText "测试：检查 sysctl 是否有 kern.domainname"
            FIND=$(${SYSCTLBINARY} -a 2>&1 | ${GREPBINARY} "^kern.domainname" | ${AWKBINARY} -F: '{ print $2 }' | ${SEDBINARY} 's/ //g' | ${GREPBINARY} -v "^$")
            if [ ! "${FIND}" = "" ]; then
                LogText "结果：通过 sysctl 找到 NIS 域"
                NISDOMAIN="${FIND}"
            fi
        fi
        # Check if we found any NIS domain
        if [ -n "${NISDOMAIN}" ]; then
            LogText "找到 NIS 域名：${NISDOMAIN}"
            Report "nisdomain=${NISDOMAIN}"
            Display --indent 4 --text "- 检查NIS域名" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未找到 NIS 域"
            Display --indent 4 --text "- 检查NIS域名" --result "${STATUS_UNKNOWN}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    if [ -f ${ROOTDIR}etc/hosts ]; then
        Display --indent 2 --text "- 检查/etc/hosts"
    else
        LogText "结果：未找到 /etc/hosts 文件"
    fi

    # Test        : NAME-4402
    # Description : Check /etc/hosts configuration
    if [ -f ${ROOTDIR}etc/hosts ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4402 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 /etc/hosts 中的重复行"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 ${ROOTDIR}etc/hosts 中的重复行"
        OUTPUT=$(${AWKBINARY} '{ print $1, $2 }' ${ROOTDIR}etc/hosts | ${GREPBINARY} -E -v '^(#|$)' | ${GREPBINARY} -E "[a-f0-9]" | ${SORTBINARY} | ${UNIQBINARY} -d)
        if [ -z "${OUTPUT}" ]; then
            LogText "结果：正常，未发现重复行"
            Display --indent 4 --text "- 主机文件中的重复条目" --result "${STATUS_NONE}" --color GREEN
        else
            LogText "发现重复行：${OUTPUT}"
            LogText "结果：发现重复行"
            Display --indent 4 --text "- 主机文件中的重复条目" --result "${STATUS_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "删除 ${ROOTDIR}etc/hosts 中的重复行"
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4404
    # Description : Check /etc/hosts contains an entry for this server name
    if [ -f ${ROOTDIR}etc/hosts ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4404 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 /etc/hosts 包含此服务器名称的条目"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 /etc/hosts 包含此服务器名称的条目"
        if [ -n "${HOSTNAME}" ]; then
            DATA=$(${GREPBINARY} -E -v '^(#|$|^::1\s|localhost)' ${ROOTDIR}etc/hosts | ${GREPBINARY} -i ${HOSTNAME})
            if [ -n "${DATA}" ]; then
                LogText "结果：在 ${ROOTDIR}etc/hosts 中找到 ${HOSTNAME} 的条目"
                Display --indent 4 --text "- /etc/hosts 中存在配置的主机名" --result "${STATUS_FOUND}" --color GREEN
            else
                LogText "结果：在 ${ROOTDIR}etc/hosts 中找不到 ${HOSTNAME} 的条目"
                Display --indent 4 --text "- /etc/hosts 中存在配置的主机名" --result "${STATUS_NOT_FOUND}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "将 IP 名称和 FQDN 添加到 /etc/hosts 以进行正确的名称解析"
                LogText "风险：/etc/hosts 中没有服务器名称 [主机名] 条目可能会导致本地连接出现意外性能问题"
            fi
        else
            LogText "结果：未配置主机名，跳过检查"
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4406
    # Description : Check server hostname mapping
    if [ -n "${HOSTNAME}" -a -f ${ROOTDIR}etc/hosts ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4406 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查服务器主机名映射"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 ${ROOTDIR}etc/hosts 中未本地映射的服务器主机名"
        DATA=$(${GREPBINARY} -E -v '^(#|$)' ${ROOTDIR}etc/hosts | ${GREPBINARY} -E '^(localhost|::1)\s' | ${GREPBINARY} -w ${HOSTNAME})
        if [ -n "${DATA}" ]; then
            LogText "结果：发现该服务器主机名映射到本地地址"
            LogText "输出：${DATA}"
            Display --indent 4 --text "- 主机名映射到 localhost" --result "${STATUS_FOUND}" --color YELLOW
            LogText "信息：将主机名链接到 localhost 条目可能会破坏某些解析。拆分解析，以便 localhost 解析回 127.0.0.1（和 ::1），并将计算机的主机名解析为网络接口上的真实 IP 地址。"
            ReportSuggestion "${TEST_NO}" "localhost 和系统主机名之间的拆分解析"
        else
            LogText "结果：该服务器主机名未映射到本地地址"
            Display --indent 4 --text "- 主机名映射到 localhost" --result "${STATUS_NOT_FOUND}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4408
    # Description : Check localhost entry
    if [ -n "${GETENT_BINARY}" ]; then PREQS_MET="YES"; SKIPREASON="没有 getent 二进制文件"; else PREQS_MET="NO"; SKIPREASON=""; fi
    Register --test-no NAME-4408 --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --category security --description "检查 localhost 条目"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 /etc/hosts 中未本地映射的服务器主机名"
        FIND=$(${GETENT_BINARY} hosts localhost | ${AWKBINARY} '{print $1}' | ${SORTBINARY} | ${TRBINARY} -d '\n')
        if [ "${FIND}" = "127.0.0.1" ]; then
            LogText "结果：localhost 映射到 127.0.0.1"
            Display --indent 4 --text "- Localhost 映射到 IP 地址" --result "${STATUS_OK}" --color GREEN
            Report "localhost-mapped-to=${FIND}"
        elif [ "${FIND}" = "::1" ]; then
            LogText "结果：localhost 映射到 ::1"
            Display --indent 4 --text "- Localhost 映射到 IP 地址" --result "${STATUS_OK}" --color GREEN
            Report "localhost-mapped-to=${FIND}"
        elif [ "${FIND}" = "127.0.0.1::1" ]; then
            LogText "结果：localhost 映射到 127.0.0.1 和 ::1"
            Display --indent 4 --text "- Localhost 映射到 IP 地址" --result "${STATUS_OK}" --color GREEN
            Report "localhost-mapped-to=${FIND}"
        else
            LogText "输出：${FIND}"
            LogText "结果：该服务器主机名未映射到本地地址"
            Display --indent 4 --text "- Localhost 映射到 IP 地址" --result "${STATUS_SUGGESTION}" --color YELLOW
            LogText "信息：确保 localhost 解析回 127.0.0.1（和/或 ::1）。"
            ReportSuggestion "${TEST_NO}" "localhost 和系统主机名之间的拆分解析" "/etc/hosts" "text:检查您的 localhost 行"
        fi
    fi
#
#################################################################################
#

Report "name_cache_used=${NAME_CACHE_USED}"
WaitForKeyPress

