#################################################################################
#
    # Test        : NAME-4036
    # Description : Checking Unbound configuration file
    if [ ${UNBOUND_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4036 --preqs-met ${PREQS_MET}  --weight L --network NO --category security --description "检查 Unbound 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(which unbound-checkconf | grep -v "no [^ ]* in ")
        if [ ! "${FIND}" = "" ]; then
            LogText "检查： 运行中 unbound-checkconf"
            # Don't capture any output, just gather exit code (0 is fine, otherwise bad)
            FIND=$(unbound-checkconf > /dev/null 2>&1)
            if [ $? -eq 0 ]; then
                UNBOUND_CONFIG_OK=1
                LogText "结果： 配置 是 正常"
                Display --indent 2 --text "- 检查 配置文件" --result "${STATUS_OK}" --color GREEN
            else
                LogText "结果： Unbound 守护进程 是 不 运行中"
                Display --indent 2 --text "- 检查 配置文件" --result "NOT OK" --color YELLOW
                ReportWarning "${TEST_NO}" "发现 Unbound 配置文件 issues (运行 unbound-checkconf)"
            fi
        else
            LogText "结果：找不到 unbound-checkconf 工具，已跳过"
        fi
    fi
