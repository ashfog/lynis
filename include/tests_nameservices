            LogText "输出：${FIND}"
            Display --indent 2 --text "- 检查/etc/nodename" --result "${STATUS_DONE}" --color GREEN
        else
            LogText "结果：找不到文件 /etc/nodename"
            Display --indent 2 --text "- 检查/etc/nodename" --result "未找到" --color YELLOW
        fi
    fi
