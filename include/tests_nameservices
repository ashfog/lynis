    if [ ${BIND_RUNNING} -eq 1 -a ! "${BIND_CONFIG_LOCATION}" = "" -a ! "${DIGBINARY}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4210 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 DNS 横幅"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：尝试从横幅确定版本"
        FIND=$(${DIGBINARY} @localhost version.bind chaos txt | ${GREPBINARY} "^version.bind" | ${GREPBINARY} TXT | ${GREPBINARY} -E "[0-9].[0-9].[0-9]*")
        if [ "${FIND}" = "" ]; then
            LogText "结果：横幅中没有找到有用的信息"
            Display --indent 4 --text "- 检查横幅中的 BIND 版本" --result "${STATUS_OK}" --color GREEN
            AddHP 2 2
        else
            LogText "结果：版本横幅中可能提供 BIND 版本"
            Display --indent 4 --text "- 检查横幅中的 BIND 版本" --result "${STATUS_WARNING}" --color RED
            ReportWarning "${TEST_NO}" "在横幅中找到 BIND 版本"
            ReportSuggestion "${TEST_NO}" "可在配置文件中设置 'version none' 隐藏 BIND 版本"
            AddHP 0 2
        fi
    fi
