    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${UNAMEBINARY} -n)
        LogText "结果：'uname -n' 返回 ${FIND}"
        Display --indent 2 --text "- 检查 uname -n 输出" --result "${STATUS_DONE}" --color GREEN
    fi
