#################################################################################
#
    # Test        : NAME-4026
    # Description : Check Solaris /etc/nodename
    # Notes       : If a system is standalone, /etc/nodename should contain a system name only, not FQDN
    Register --test-no NAME-4026 --os Solaris --weight L --network NO --category security --description "检查 /etc/nodename"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 /etc/nodename"
        if [ -f /etc/nodename ]; then
            LogText "结果： 文件 /etc/nodename 存在"
            FIND=$(cat /etc/nodename)
            LogText "输出： ${FIND}"
            Display --indent 2 --text "- 检查 /etc/nodename" --result "${STATUS_DONE}" --color GREEN
        else
            LogText "结果： 文件 /etc/nodename 可以 不 为 发现"
            Display --indent 2 --text "- 检查 /etc/nodename" --result "NONE FOUND" --color YELLOW
        fi
    fi
