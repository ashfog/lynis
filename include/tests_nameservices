    Register --test-no NAME-4204 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "搜索BIND配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：搜索BIND配置文件"
        for I in ${BIND_CONFIG_LOCS}; do
            if [ -f ${I}/named.conf ]; then
