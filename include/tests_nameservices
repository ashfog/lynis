            if IsVerbose; then Display --indent 2 --text "- 检查 ypbind 状态" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4306
    # Description : Check NIS domain
    # Notes       : FreeBSD: sysctl kern.domainname
    if [ ${YPBIND_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4306 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 NIS 域"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 $(domainname) 用于 NIS 域 值"
        FIND=$(${DOMAINNAMEBINARY} | ${GREPBINARY} -v "(none)")
        if [ -n "${FIND}" ]; then
            LogText "值： ${FIND}"
            NISDOMAIN="${FIND}"
        else
            LogText "结果： 没有 NIS 域 发现 在 命令 输出"
        fi
        # Solaris / Linux style
        LogText "检查： 检查 文件 ${ROOTDIR}etc/defaultdomain"
        if [ -f ${ROOTDIR}etc/defaultdomain ]; then
            LogText "结果： 文件 ${ROOTDIR}etc/defaultdomain 存在"
            FIND2=$(cat ${ROOTDIR}etc/defaultdomain)
            if [ -n "${FIND2}" ]; then
                LogText "输出： ${FIND2}"
                NISDOMAIN="${FIND2}"
            else
                LogText "结果： 没有 NIS 域 发现 在 文件"
            fi
        fi
        # Red Hat style
        LogText "检查： 检查 ${ROOTDIR}etc/sysconfig/网络"
        if [ -f ${ROOTDIR}etc/sysconfig/network ]; then
            LogText "结果： 文件 ${ROOTDIR}etc/sysconfig/网络 存在"
            LogText "检查： 检查 NISDOMAIN 值 在 文件"
            FIND3=$(${GREPBINARY} "^NISDOMAIN" ${ROOTDIR}etc/sysconfig/network | ${AWKBINARY} -F= '{ print $2 }' | ${SEDBINARY} 's/"//g')
            if [ -n "${FIND3}" ]; then
                LogText "发现 NIS 域： ${FIND3}"
                NISDOMAIN="${FIND3}"
            else
                LogText "结果： 没有 NIS 域 发现 在 文件"
            fi
        else
            LogText "结果： 文件 ${ROOTDIR}etc/sysconfig/网络 不存在"
        fi

        if [ ! "${SYSCTLBINARY}" = "" ]; then
            # Check sysctl (e.g. FreeBSD)
            LogText "检查： 检查 sysctl 用于 kern.domainname"
            FIND=$(${SYSCTLBINARY} -a 2>&1 | ${GREPBINARY} "^kern.domainname" | ${AWKBINARY} -F: '{ print $2 }' | ${SEDBINARY} 's/ //g' | ${GREPBINARY} -v "^$")
            if [ ! "${FIND}" = "" ]; then
                LogText "结果： 发现 NIS 域 通过 sysctl"
                NISDOMAIN="${FIND}"
            fi
        fi
        # Check if we found any NIS domain
        if [ -n "${NISDOMAIN}" ]; then
            LogText "发现 NIS 域： ${NISDOMAIN}"
            Report "nisdomain=${NISDOMAIN}"
            Display --indent 4 --text "- 检查 NIS 域" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果： 没有 NIS 域 发现"
            Display --indent 4 --text "- 检查 NIS 域" --result "${STATUS_UNKNOWN}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    if [ -f ${ROOTDIR}etc/hosts ]; then
        Display --indent 2 --text "- 检查 /etc/hosts"
    else
        LogText "结果： 没有 /etc/hosts 文件 发现"
    fi

    # Test        : NAME-4402
    # Description : Check /etc/hosts configuration
    if [ -f ${ROOTDIR}etc/hosts ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4402 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 duplicate 行 在 /etc/hosts"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 duplicate 行 在 ${ROOTDIR}etc/主机"
        OUTPUT=$(${AWKBINARY} '{ print $1, $2 }' ${ROOTDIR}etc/hosts | ${GREPBINARY} -E -v '^(#|$)' | ${GREPBINARY} -E "[a-f0-9]" | ${SORTBINARY} | ${UNIQBINARY} -d)
        if [ -z "${OUTPUT}" ]; then
            LogText "结果：正常，未发现重复行"
            Display --indent 4 --text "- Duplicate 条目 在 主机 文件" --result "${STATUS_NONE}" --color GREEN
        else
            LogText "发现 duplicate 行： ${OUTPUT}"
            LogText "结果： 发现 duplicate 行"
            Display --indent 4 --text "- Duplicate 条目 在 主机 文件" --result "${STATUS_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "移除 duplicate 行 在 ${ROOTDIR}etc/主机"
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4404
    # Description : Check /etc/hosts contains an entry for this server name
    if [ -f ${ROOTDIR}etc/hosts ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4404 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 /etc/hosts contains 一个 条目 用于 此 服务器 name"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 /etc/hosts contains 一个 条目 用于 此 服务器 name"
        if [ -n "${HOSTNAME}" ]; then
            DATA=$(${GREPBINARY} -E -v '^(#|$|^::1\s|localhost)' ${ROOTDIR}etc/hosts | ${GREPBINARY} -i ${HOSTNAME})
            if [ -n "${DATA}" ]; then
                LogText "结果： 发现 条目 用于 ${HOSTNAME} 在 ${ROOTDIR}etc/主机"
                Display --indent 4 --text "- Presence 的 已配置 主机名 在 /etc/hosts" --result "${STATUS_FOUND}" --color GREEN
            else
                LogText "结果： 没有 条目 发现 用于 ${HOSTNAME} 在 ${ROOTDIR}etc/主机"
                Display --indent 4 --text "- Presence 的 已配置 主机名 在 /etc/hosts" --result "${STATUS_NOT_FOUND}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "添加 IP name 和 FQDN 到 /etc/hosts 用于 proper name resolving"
                LogText "风险： 没有 条目 用于 服务器 name [主机名] 在 /etc/hosts 可能 cause 异常 performance problems 用于 本地 连接"
            fi
        else
            LogText "结果：未配置主机名，跳过检查"
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4406
    # Description : Check server hostname mapping
    if [ -n "${HOSTNAME}" -a -f ${ROOTDIR}etc/hosts ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4406 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 服务器 主机名 映射"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 服务器 主机名 不 locally mapped 在 ${ROOTDIR}etc/主机"
        DATA=$(${GREPBINARY} -E -v '^(#|$)' ${ROOTDIR}etc/hosts | ${GREPBINARY} -E '^(localhost|::1)\s' | ${GREPBINARY} -w ${HOSTNAME})
        if [ -n "${DATA}" ]; then
            LogText "结果： 发现 此 服务器 主机名 mapped 到 一个 本地 地址"
            LogText "输出： ${DATA}"
            Display --indent 4 --text "- 主机名 mapped 到 localhost" --result "${STATUS_FOUND}" --color YELLOW
            LogText "信息： Linking 主机名 到 localhost 条目 可能 break 一些 resolving. Split resolving so 该 localhost resolves back 到 127.0.0.1 (和 ::1) 和 主机名 的 机器 到 real IP 地址 在 网络接口."
            ReportSuggestion "${TEST_NO}" "Split resolving 之间 localhost 和 主机名 的 系统"
        else
            LogText "结果： 此 服务器 主机名 是 不 mapped 到 一个 本地 地址"
            Display --indent 4 --text "- 主机名 mapped 到 localhost" --result "${STATUS_NOT_FOUND}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4408
    # Description : Check localhost entry
    if [ -n "${GETENT_BINARY}" ]; then PREQS_MET="YES"; SKIPREASON="没有 getent 程序"; else PREQS_MET="NO"; SKIPREASON=""; fi
    Register --test-no NAME-4408 --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --category security --description "检查 localhost 条目"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 服务器 主机名 不 locally mapped 在 /etc/hosts"
        FIND=$(${GETENT_BINARY} hosts localhost | ${AWKBINARY} '{print $1}' | ${SORTBINARY} | ${TRBINARY} -d '\n')
        if [ "${FIND}" = "127.0.0.1" ]; then
            LogText "结果： localhost mapped 到 127.0.0.1"
            Display --indent 4 --text "- Localhost 映射 到 IP 地址" --result "${STATUS_OK}" --color GREEN
            Report "localhost-mapped-to=${FIND}"
        elif [ "${FIND}" = "::1" ]; then
            LogText "结果： localhost mapped 到 ：：1"
            Display --indent 4 --text "- Localhost 映射 到 IP 地址" --result "${STATUS_OK}" --color GREEN
            Report "localhost-mapped-to=${FIND}"
        elif [ "${FIND}" = "127.0.0.1::1" ]; then
            LogText "结果： localhost mapped 到 127.0.0.1 和 ：：1"
            Display --indent 4 --text "- Localhost 映射 到 IP 地址" --result "${STATUS_OK}" --color GREEN
            Report "localhost-mapped-to=${FIND}"
        else
            LogText "输出： ${FIND}"
            LogText "结果： 此 服务器 主机名 是 不 mapped 到 一个 本地 地址"
            Display --indent 4 --text "- Localhost 映射 到 IP 地址" --result "${STATUS_SUGGESTION}" --color YELLOW
            LogText "信息： Ensure 该 localhost resolves back 到 127.0.0.1 (和/或 ::1)."
            ReportSuggestion "${TEST_NO}" "Split resolving 之间 localhost 和 主机名 的 系统" "/etc/hosts" "text：检查 你的 localhost 行"
        fi
    fi
