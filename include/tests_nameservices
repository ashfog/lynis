    Register --test-no NAME-4204 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "搜索 BIND 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 搜索 BIND 配置文件"
        for I in ${BIND_CONFIG_LOCS}; do
            if [ -f ${I}/named.conf ]; then
                BIND_CONFIG_LOCATION="${I}/named.conf"
                LogText "结果： 发现 配置文件 (${BIND_CONFIG_LOCATION})"
