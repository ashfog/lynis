#
    # Test        : NAME-4206
    # Description : Check BIND configuration file consistency
    if [ ${BIND_RUNNING} -eq 1 -a ! "${BIND_CONFIG_LOCATION}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4206 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查BIND配置一致性"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：搜索named-checkconf二进制文件"
        if [ ! "${NAMEDCHECKCONFBINARY}" = "" ]; then
            LogText "结果：named-checkconf 已安装"
            FIND=$(${NAMEDCHECKCONFBINARY} ${BIND_CONFIG_LOCATION}; echo $?)
            if [ "${FIND}" = "0" ]; then
                LogText "结果：配置文件${BIND_CONFIG_LOCATION}似乎没问题"
                Display --indent 4 --text "- 检查BIND配置一致性" --result "${STATUS_OK}" --color GREEN
            else
                LogText "结果：在${BIND_CONFIG_LOCATION}中发现可能的错误"
                Display --indent 4 --text "- 检查BIND配置一致性" --result "${STATUS_WARNING}" --color RED
                ReportWarning "${TEST_NO}" "BIND 配置文件中发现错误"
            fi
        else
            LogText "结果：未找到 named-checkconf，跳过检查"
        fi
    fi
