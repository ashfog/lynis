#################################################################################
#
    # Test        : NAME-4028
    # Description : Check DNS domain name
    # To Do       : ${GREPBINARY} ^DOMAINNAME /etc/conf.d/domainname (remove "'s)
    Register --test-no NAME-4028 --weight L --network NO --category security --description "检查 域 name"
    if [ ${SKIPTEST} -eq 0 ]; then
        DOMAINNAME=""
        LogText "检查： 检查 如果 dnsdomainname 命令 是 可用"
        if HasData "${DNSDOMAINNAMEBINARY}"; then
            FIND2=$(${DNSDOMAINNAMEBINARY} 2> /dev/null)
            if HasData "${FIND2}"; then
                LogText "结果： dnsdomainname 命令 已返回 一个 值"
                LogText "发现 域 name： ${FIND2}"
                DOMAINNAME="${FIND2}"
            else
                LogText "结果： dnsdomainname 命令 已返回 没有 值"
            fi
        else
            LogText "结果：未找到 dnsdomainname 程序，跳过该项检查"
        fi

        # If files and commands can't be found, use defined value from resolv.conf
        if [ -z "${DOMAINNAME}" ]; then
            if [ -n "${RESOLV_DOMAINNAME}" ]; then
                LogText "结果： 使用 域 name 从 ${ROOTDIR}etc/resolv.conf"
                DOMAINNAME=${RESOLV_DOMAINNAME}
            else
                LogText "结果： 使用 域 name 从 FQDN 主机名 (${FQDN})"
                DOMAINNAME=$(echo ${FQDN} | ${AWKBINARY} -F. '{print $2}')
            fi
        fi

        if [ -n "${DOMAINNAME}" ]; then
            LogText "结果： 发现 域 name"
            Report "domainname=${DOMAINNAME}"
            Display --indent 2 --text "- 搜索 DNS 域 name" --result "${STATUS_FOUND}" --color GREEN
            Display --indent 6 --text "域 name： ${DOMAINNAME}"
        else
            Display --indent 2 --text "- 搜索 DNS 域 name" --result "${STATUS_UNKNOWN}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "检查 DNS 配置 用于 dns 域 name"
        fi
    fi
