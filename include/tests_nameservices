        if IsRunning "unbound"; then
            UNBOUND_RUNNING=1
            NAME_CACHE_USED=1
            LogText "结果： Unbound 守护进程 是 运行中"
            Display --indent 2 --text "- 检查 Unbound 状态" --result "${STATUS_RUNNING}" --color GREEN
        else
