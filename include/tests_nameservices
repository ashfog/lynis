#
#################################################################################
#
    # Test        : NAME-4016
    # Description : Check main domain (domain <domain name> in /etc/resolv.conf)
    Register --test-no NAME-4016 --weight L --network NO --category security --description "检查/etc/resolv.conf默认域"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 ${ROOTDIR}etc/resolv.conf 是否为默认域"
        if [ -f ${ROOTDIR}etc/resolv.conf ]; then
            LogText "结果：找到 ${ROOTDIR}etc/resolv.conf"
            FIND=$(${AWKBINARY} '/^domain/ { print $2 }' ${ROOTDIR}etc/resolv.conf)
            if [ -z "${FIND}" ]; then
                LogText "结果：未找到默认域"
                if IsVerbose; then Display --indent 2 --text "- 检查默认的DNS搜索域" --result "${STATUS_NONE}" --color WHITE; fi
            else
                LogText "结果：找到默认域"
                LogText "输出：${FIND}"
                Report "resolv_conf_domain=${FIND}"
                Display --indent 2 --text "- 检查默认的DNS搜索域" --result "${STATUS_FOUND}" --color GREEN
                RESOLV_DOMAINNAME="${FIND}"
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4018
    # Description : Check search domains in /etc/resolv.conf
    # Notes       : Maximum of one search keyword is allowed in /etc/resolv.conf
    Register --test-no NAME-4018 --weight L --network NO --category security --description "检查 /etc/resolv.conf 搜索域"
    if [ ${SKIPTEST} -eq 0 ]; then
        COUNT=0
        LogText "测试：检查 ${ROOTDIR}etc/resolv.conf 的搜索域"
        if [ -f ${ROOTDIR}etc/resolv.conf ]; then
            LogText "结果：找到 ${ROOTDIR}etc/resolv.conf"
            FIND=$(${AWKBINARY} '/^search/ { print $2 }' ${ROOTDIR}etc/resolv.conf)
            if IsEmpty "${FIND}"; then
                LogText "结果：未找到搜索域，正在使用默认域"
            else
                for ITEM in ${FIND}; do
                    LogText "找到搜索域：${ITEM}"
                    Report "resolv_conf_search_domain[]=${ITEM}"
                    COUNT=$((COUNT + 1))
                done
                # Warn if we have more than 6 search domains, which is maximum in most resolvers
                if [ ${COUNT} -gt 6 ]; then
                    LogText "结果：找到 ${COUNT} 搜索域"
                    Display --indent 2 --text "- 检查搜索域" --result "${STATUS_WARNING}" --color YELLOW
                    ReportWarning "${TEST_NO}" "发现超过 6 个搜索域，通常已超过多数解析器允许的最大数量"
                else
                    LogText "结果：找到 ${COUNT} 搜索域"
                    Display --indent 2 --text "- 检查搜索域" --result "${STATUS_FOUND}" --color GREEN
                fi
            fi
            # Check amount of search domains (max 1)
            FIND=$(${GREPBINARY} -c "^search" ${ROOTDIR}etc/resolv.conf)
            if [ ! "${FIND}" = "0" -a ! "${FIND}" = "1" ]; then
                LogText "结果：通过搜索语句找到 ${FIND} 行（预计少于 2 行）"
                Display --indent 4 --text "- 检查搜索域行" --result "配置错误" --color YELLOW
                ReportWarning "${TEST_NO}" "在 /etc/resolv.conf 中发现多条 search 配置，可能存在配置错误"
            else
                LogText "结果：通过搜索语句找到 ${FIND} 行（预计少于 2 行）"
            fi
        else
            LogText "结果：${ROOTDIR}etc/resolv.conf 不存在，跳过检查"
            Display --indent 2 --text "- 检查搜索域" --result "${STATUS_NOT_FOUND}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : NAME-4020
    # Description : Check non default resolv.conf options
    Register --test-no NAME-4020 --weight L --network NO --category security --description "检查非默认选项"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "测试：检查 ${ROOTDIR}etc/resolv.conf 是否有非默认选项"
        if [ -f ${ROOTDIR}etc/resolv.conf ]; then
            LogText "结果：找到 ${ROOTDIR}etc/resolv.conf"
            FIND=$(${GREPBINARY} "^options" ${ROOTDIR}etc/resolv.conf | ${AWKBINARY} '{ print $2 }')
            if IsEmpty "${FIND}"; then
                LogText "结果：/etc/resolv.conf 中没有配置特定的其他选项"
                if IsVerbose; then Display --indent 2 --text "- 检查 /etc/resolv.conf 选项" --result "${STATUS_NONE}" --color WHITE; fi
            else
                for ITEM in ${FIND}; do
                    LogText "找到选项：${ITEM}"
                    Report "resolv_conf_option[]=${ITEM}"
                    # TODO add suggestions for the related options
                    # rotate --> add performance tune point
                    # timeout --> add performance tune point when smaller than 3 seconds
                done
                Display --indent 2 --text "- 检查 /etc/resolv.conf 选项" --result "${STATUS_FOUND}" --color GREEN
            fi
        else
            LogText "结果：未找到 /etc/resolv.conf，跳过检查"
            Display --indent 2 --text "- 检查 /etc/resolv.conf 选项" --result "${STATUS_NOT_FOUND}" --color YELLOW
        fi
    fi
