#################################################################################
#
    # Test        : NAME-4210
    # Description : Check if we can determine useful information from banner
    if [ ${BIND_RUNNING} -eq 1 -a ! "${BIND_CONFIG_LOCATION}" = "" -a ! "${DIGBINARY}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4210 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 DNS banner"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 正在尝试 到 确定 版本 从 banner"
        FIND=$(${DIGBINARY} @localhost version.bind chaos txt | ${GREPBINARY} "^version.bind" | ${GREPBINARY} TXT | ${GREPBINARY} -E "[0-9].[0-9].[0-9]*")
        if [ "${FIND}" = "" ]; then
            LogText "结果： 没有 useful 信息 在 banner 发现"
            Display --indent 4 --text "- 检查 BIND 版本 在 banner" --result "${STATUS_OK}" --color GREEN
            AddHP 2 2
        else
            LogText "结果： 可能 BIND 版本 可用 在 版本 banner"
            Display --indent 4 --text "- 检查 BIND 版本 在 banner" --result "${STATUS_WARNING}" --color RED
            ReportWarning "${TEST_NO}" "发现 BIND 版本 在 banner"
            ReportSuggestion "${TEST_NO}" "可在配置文件中设置 'version none' 隐藏 BIND 版本"
            AddHP 0 2
        fi
    fi
