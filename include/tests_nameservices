#################################################################################
#
    # Test        : NAME-4032
    # Description : Check name service caching daemon (NSCD) status
    Register --test-no NAME-4032 --weight L --network NO --category security --description "检查 nscd 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 nscd 状态"
        if IsRunning "nscd"; then
            NAME_CACHE_USED=1
            LogText "结果： nscd 是 运行中"
            Display --indent 2 --text "- 检查 nscd 状态" --result "${STATUS_RUNNING}" --color GREEN
        else
            LogText "结果： nscd 是 不 运行中"
            if IsVerbose; then Display --indent 2 --text "- 检查 nscd 状态" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
