    # Test        : NAME-4206
    # Description : Check BIND configuration file consistency
    if [ ${BIND_RUNNING} -eq 1 -a ! "${BIND_CONFIG_LOCATION}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NAME-4206 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 BIND 配置 consistency"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 搜索 用于 named-checkconf 程序"
        if [ ! "${NAMEDCHECKCONFBINARY}" = "" ]; then
            LogText "结果： named-checkconf 是 已安装"
            FIND=$(${NAMEDCHECKCONFBINARY} ${BIND_CONFIG_LOCATION}; echo $?)
            if [ "${FIND}" = "0" ]; then
                LogText "结果： 配置文件 ${BIND_CONFIG_LOCATION} 似乎 到 为 正常"
                Display --indent 4 --text "- 检查 BIND 配置 consistency" --result "${STATUS_OK}" --color GREEN
            else
                LogText "结果： 可能 errors 发现 在 ${BIND_CONFIG_LOCATION}"
                Display --indent 4 --text "- 检查 BIND 配置 consistency" --result "${STATUS_WARNING}" --color RED
                ReportWarning "${TEST_NO}" "Errors 发现 在 BIND 配置文件"
            fi
        else
            LogText "结果：未找到 named-checkconf，跳过检查"
        fi
    fi
