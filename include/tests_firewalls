#
    InsertSection "${SECTION_FIREWALLS}"
#
#################################################################################
#
    IPTABLES_ACTIVE=0
    IP6TABLES_ACTIVE=0
    IPTABLES_INKERNEL_ACTIVE=0
    IPTABLES_MODULE_ACTIVE=0
    FIREWALL_ACTIVE=0
    FIREWALL_EMPTY_RULESET=0
    NFTABLES_ACTIVE=0
#
#################################################################################
#
    # Test        : FIRE-4502
    # Description : Check iptables kernel module
    Register --test-no FIRE-4502 --os Linux --weight L --network NO --category security --description "检查 iptables 内核模块"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${LSMODBINARY} | ${AWKBINARY} '{ print $1 }' | ${GREPBINARY} "^ip*_tables")
        if [ -n "${FIND}" ]; then
            FIREWALL_ACTIVE=1
            IPTABLES_ACTIVE=1
            IPTABLES_MODULE_ACTIVE=1
            Display --indent 2 --text "- 正在检查 iptables 内核模块" --result "${STATUS_FOUND}" --color GREEN
            Report "firewall_software[]=iptables"
            LogText "结果：在已加载的内核模块中发现 iptables"
            for I in ${FIND}; do
                if [ "${I}" = "ip6_tables" ]; then IP6TABLES_ACTIVE=1; Report "firewall_software[]=ip6tables"; fi
                LogText "发现模块：${I}"
            done
        elif [ -f ${ROOTDIR}proc/net/ip_tables_names ]; then
            FIREWALL_ACTIVE=1
            Report "firewall_software[]=iptables"
            IPTABLES_ACTIVE=1
            Display --indent 2 --text "- 正在检查 iptables 支持" --result "${STATUS_FOUND}" --color GREEN
        elif [ -f ${ROOTDIR}proc/net/ip6_tables_names ]; then
            FIREWALL_ACTIVE=1
            IP6TABLES_ACTIVE=1
            Report "firewall_software[]=ip6tables"
            Display --indent 2 --text "- 正在检查 ip6tables 支持" --result "${STATUS_FOUND}" --color GREEN
        else
            Display --indent 2 --text "- 正在检查 iptables 内核模块" --result "${STATUS_NOT_FOUND}" --color WHITE

            # If we can't find an active module, try to find the Linux configuration file and check that
            if [ -f /proc/config.gz ]; then LINUXCONFIGFILE="/proc/config.gz"; tCATCMD="zcat"; fi
            sLINUXCONFIGFILE="/boot/config-$(uname -r)"
            if [ -f ${sLINUXCONFIGFILE} ]; then LINUXCONFIGFILE=${sLINUXCONFIGFILE}; tCATCMD="cat"; fi

            # If we have a kernel configuration file, use it for testing
            # Do not perform test if we already found it in kernel module list, to avoid triggered it in the upcoming
            # tests, when using iptables --list
            if [ -n "${LINUXCONFIGFILE}" ]; then
                if [ -f ${LINUXCONFIGFILE} -a ${IPTABLES_MODULE_ACTIVE} -eq 0 ]; then
                    LogText "结果：发现内核配置文件（${LINUXCONFIGFILE}）"
                    FIND=$(${tCATCMD} ${LINUXCONFIGFILE} | ${GREPBINARY} -v '^#' | ${GREPBINARY} "CONFIG_IP_NF_IPTABLES" | head -n 1)
                    if [ -n "${FIND}" ]; then
                        HAVEMOD=$(echo ${FIND} | ${CUTBINARY} -d '=' -f2)
                        # Do not use iptables if it's compiled as a module (=m), since we already tested for it in the
                        # active list.
                        if [ "${HAVEMOD}" = "y" ]; then
                            LogText "结果：配置中提供了 iptables 支持"
                            IPTABLES_ACTIVE=1
                            IPTABLES_INKERNEL_ACTIVE=1
                            FIREWALL_ACTIVE=1
                            Display --indent 2 --text "- 正在检查配置文件中的 iptables" --result "${STATUS_FOUND}" --color GREEN
                        else
                            LogText "结果：Linux 内核配置文件中未发现 iptables"
                        fi
                    else
                        LogText "结果：未找到 Linux 配置项"
                        Display --indent 2 --text "- 正在检查配置文件中的 iptables" --result "${STATUS_NOT_FOUND}" --color WHITE
                    fi
                fi
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4508
    # Description : Check iptables chain policies
    # Notes       : Suggestions are currently disabled, until related page and documentation is available
    # TODO        : grep -z is not supported on BusyBox
    if [ ! "${IPTABLESBINARY}" = "" -a ${IPTABLES_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FIRE-4508 --preqs-met ${PREQS_MET} --os Linux --weight L --network NO --root-only YES --category security --description "检查 iptables 链所使用的策略"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 4 --text "- 正在检查 iptables 链策略" --result "${STATUS_FOUND}" --color GREEN
        IPTABLES_TABLES="filter nat mangle raw security"
        for IPTABLES_TABLE in ${IPTABLES_TABLES}
        do
            ${IPTABLESBINARY} -t "${IPTABLES_TABLE}" --list-rules --wait 1 2>/dev/zero |
            {
                IPTABLES_OUTPUT_QUEUE=""
                while IFS="$(printf '\n')" read -r IPTABLES_LINES
                do
                    set -- ${IPTABLES_LINES}
                    while [ $# -gt 0 ]; do
                        if [ "${1}" = "-P" ]; then
                            IPTABLES_CHAIN="${2}"
                            IPTABLES_TARGET="${3}"
                            shift 3
                        elif [ "${1}" = "-A" ] || [ "${1}" = "-N" ]; then
                            IPTABLES_CHAIN="${2}"
                            shift 2
                        elif [ "${1}" = "-j" ]; then
                            IPTABLES_TARGET="${2}"
                            shift
                        else
                            shift
                        fi
                    done
                    # logics
                    if [ "${IPTABLES_TABLE}" = "filter" ] || [ "${IPTABLES_TABLE}" = "security" ]; then
                        if [ "${IPTABLES_CHAIN}" = "INPUT" ]; then
                            if [ "${IPTABLES_TARGET}" = "ACCEPT" ]; then
                                IPTABLES_OUTPUT_QUEUE="${IPTABLES_OUTPUT_QUEUE}\n${IPTABLES_TABLE} ${IPTABLES_CHAIN} ${IPTABLES_TARGET} YELLOW 1 3"
                            elif [ "${IPTABLES_TARGET}" = "DROP" ]; then
                                IPTABLES_OUTPUT_QUEUE="${IPTABLES_OUTPUT_QUEUE}\n${IPTABLES_TABLE} ${IPTABLES_CHAIN} ${IPTABLES_TARGET} GREEN 3 3"
                            fi
                        fi
                        if [ "${IPTABLES_CHAIN}" = "INPUT" ] || [ "${IPTABLES_CHAIN}" = "FORWARD" ] || [ "${IPTABLES_CHAIN}" = "OUTPUT" ]; then
                            if [ "${IPTABLES_TARGET}" = "NFQUEUE" ]; then
                                IPTABLES_OUTPUT_QUEUE="${IPTABLES_OUTPUT_QUEUE}\n${IPTABLES_TABLE} ${IPTABLES_CHAIN} ${IPTABLES_TARGET} RED 0 3"
                            fi
                        fi
                    fi
                done
                if [ -n "${IPTABLES_OUTPUT_QUEUE}" ]; then
                    # Sort output if sort tool is available
                    if [ -n "${SORTBINARY}" ]; then
                        LogText "说明：正在排序输出"
                        IPTABLES_OUTPUT="$(printf '%b' "${IPTABLES_OUTPUT_QUEUE}" | ${SORTBINARY} -u )"
                    else
                        IPTABLES_OUTPUT="$(printf '%b' "${IPTABLES_OUTPUT_QUEUE}")"
                    fi
                    printf '%b\n' "${IPTABLES_OUTPUT}" | while IFS="$(printf '\n')" read -r IPTABLES_OUTPUT_LINE
                    do
                        if [ -n "$IPTABLES_OUTPUT_LINE" ]; then
                            set -- ${IPTABLES_OUTPUT_LINE}
                            while [ $# -gt 0 ]; do
                                LogText "结果：链 '${2}' 使用目标 '${3}'（表：${1}）"
                                Display --indent 6 --text "- 链 ${2}（表：${1}，目标：${3}）" --result "${3}" --color "${4}"
                                if [ "${3}" = "NFQUEUE" ]
                                then
                                    ReportSuggestion "${TEST_NO}" "条件允许时建议避免使用 ${3} 目标（iptables 链 ${2}，表：${1}）"
                                fi
                                AddHP "${5}" "${6}"
                                shift 6
                            done
                        fi
                    done
                fi
            }
            unset IPTABLES_TABLE
        done
        unset IPTABLES_TABLES
    fi
    unset PREQS_MET
#
#################################################################################
#
    # Test        : FIRE-4512
    # Description : Check iptables for empty ruleset (should have at least 5 or more rules)
    if [ -n "${IPTABLESBINARY}" -a ${IPTABLES_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FIRE-4512 --preqs-met ${PREQS_MET} --os Linux --weight L --network NO --root-only YES --category security --description "检查 iptables 规则集是否为空"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${IPTABLESBINARY} --list --numeric 2> /dev/null | ${GREPBINARY} -E -v "^(Chain|target|$)" | ${WCBINARY} -l | ${TRBINARY} -d ' ')
        if [ -n "${FIND}" ]; then
            FIREWALL_ACTIVE=1
            if [ ${FIND} -le 5 ]; then
                # Firewall is active, but needs configuration
                FIREWALL_EMPTY_RULESET=1
                LogText "结果：iptables 规则集似乎为空（发现 ${FIND} 条规则）"
                Display --indent 4 --text "- 正在检查空规则集" --result "${STATUS_WARNING}" --color RED
                ReportWarning "${TEST_NO}" "iptables 模块已加载，但没有活动规则"
            else
                LogText "结果：存在一条或多条规则（共 ${FIND} 条）"
                Display --indent 4 --text "- 正在检查空规则集" --result "${STATUS_OK}" --color GREEN
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4513
    # Description : Check iptables for unused rules
    if [ -n "${IPTABLESBINARY}" -a ${IPTABLES_ACTIVE} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FIRE-4513 --preqs-met ${PREQS_MET} --os Linux --weight L --network NO --root-only YES --category security --description "检查 iptables 中未使用的规则"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${IPTABLESBINARY} --list --numeric --line-numbers --verbose | ${AWKBINARY} '{ if ($2=="0") print $1 }' | ${XARGSBINARY})
        if IsEmpty "${FIND}"; then
            Display --indent 4 --text "- 正在检查未使用的规则" --result "${STATUS_OK}" --color GREEN
            LogText "结果：没有未使用的规则"
        else
            Display --indent 4 --text "- 正在检查未使用的规则" --result "${STATUS_FOUND}" --color YELLOW
            LogText "结果：发现一个或多个可能未使用的规则"
            LogText "说明：未使用规则可能表示防火墙规则尚未优化或已经过时"
            LogText "注意：部分规则可能尚未触发但仍有用途，清理前请仔细确认。"
            LogText "输出：iptables 规则编号：${FIND}"
            ReportSuggestion "${TEST_NO}" "检查 iptables 规则，确认哪些规则当前未被使用"
            LogText "提示：iptables --list --numeric --line-numbers --verbose"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4514
    # Notes       :
    # Check if ipv6 is active on any network interface
    # If ip_tables is active, and ip6_tables is not, show warning about missing filtering
#
#################################################################################
#

    # Test        : FIRE-4518
    # Description : Checking status of pf firewall components
    # Notes       : Use /dev/pf as first detection method if pf is available
    if [ -e /dev/pf ]; then PREQS_MET="YES"; SKIPREASON=""; else PREQS_MET="NO"; SKIPREASON="系统中没有 /dev/pf 设备"; fi
    Register --test-no FIRE-4518 --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --root-only YES --category security --description "检查 pf 防火墙组件"
    if [ ${SKIPTEST} -eq 0 ]; then
        PFFOUND=0; PFLOGDFOUND=0

        # Check status with pfctl
        LogText "检查：通过 pfctl 检查 pf 状态"
        if [ -n "${PFCTLBINARY}" ]; then
            FIND=$(${PFCTLBINARY} -sa 2>&1 | ${GREPBINARY} "^Status" | ${HEADBINARY} -1 | ${AWKBINARY} '{ print $2 }')
            if [ "${FIND}" = "Disabled" ]; then
                if IsVerbose; then Display --indent 2 --text "- 正在检查 pf 状态（pfctl）" --result "${STATUS_DISABLED}" --color RED; fi
                LogText "结果：pf 已禁用"
                AddHP 0 3
            elif [ "${FIND}" = "Enabled" ]; then
                Display --indent 2 --text "- 正在检查 pf 状态（pfctl）" --result "${STATUS_ENABLED}" --color GREEN
                LogText "结果：pf 已启用"
                PFFOUND=1
                AddHP 3 3
            else
                Display --indent 2 --text "- 正在检查 pf 状态（pfctl）" --result "${STATUS_UNKNOWN}" --color YELLOW
                ReportException ${TEST_NO} "pf 防火墙状态未知"
            fi
        fi

        # If we didn't find the status to be enabled, stop searching
        if [ ${PFFOUND} -eq 0 ]; then
            # Check for pf kernel module (FreeBSD and similar)
            LogText "检查：搜索 pf 内核模块"
            if [ -n "${KLDSTATBINARY}" ]; then
                FIND=$(${KLDSTATBINARY} | ${GREPBINARY} 'pf.ko')
                if [ -z "${FIND}" ]; then
                    LogText "结果：找不到 pf KLD"
                else
                    LogText "结果：pf KLD 已加载"
                    PFFOUND=1
                fi
            else
                LogText "结果：没有 kldstat 命令，已跳过此部分"
            fi

            if IsRunning "pflogd"; then
                LogText "结果：在进程列表中发现 pflog 守护进程"
                Display --indent 4 --text "- 正在检查 pflogd 状态" --result "ACTIVE" --color GREEN
                PFFOUND=1
                PFLOGDFOUND=1
            else
                LogText "结果：进程列表中未发现 pflog 守护进程"
            fi
        fi

        if [ ${PFFOUND} -eq 1 ]; then
            FIREWALL_ACTIVE=1
            Report "firewall_software[]=pf"
        else
            LogText "结果：本系统未运行 pf"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4520
    # Description : Check pf configuration consistency
    if [ ${PFFOUND} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FIRE-4520 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 pf 配置一致性"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：/etc/pf.conf"
        # Test for warnings (-n don't load the rules)
        if [ -f /etc/pf.conf ]; then
            LogText "结果：/etc/pf.conf 存在"
            # Check results from pfctl
            PFWARNINGS=$(${PFCTLBINARY} -n -f /etc/pf.conf -vvv 2>&1 | ${GREPBINARY} -i 'warning')
            if [ -z "${PFWARNINGS}" ]; then
                Display --indent 4 --text "- 正在检查 pf 配置一致性" --result "${STATUS_OK}" --color GREEN
                LogText "结果：未发现 pf 过滤规则警告"
            else
                Display --indent 4 --text "- 正在检查 pf 配置一致性" --result "${STATUS_WARNING}" --color RED
                LogText "结果：pf 过滤规则中发现一个或多个警告"
                ReportWarning "${TEST_NO}" "pf 配置文件中发现一个或多个警告" "/etc/pf.conf" "text:执行 'pfctl -n -f /etc/pf.conf -vvv' 查看 pf 警告"
            fi
        else
            LogText "结果：/etc/pf.conf 不存在"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4522
    # Description : Check ipchains
#
#################################################################################
#
    # Test        : FIRE-4524
    # Description : Check for CSF (ConfigServer Security & Firewall)
    Register --test-no FIRE-4524 --weight L --network NO --category security --description "检查是否存在 CSF"
    if [ ${SKIPTEST} -eq 0 ]; then
        FILE="/etc/csf/csf.conf"
        LogText "检查：${FILE}"
        if [ -f ${FILE} ]; then
            LogText "结果：${FILE} 存在"
            FIREWALL_ACTIVE=1
            Report "firewall_software[]=csf"
            Display --indent 2 --text "- 正在检查 CSF 状态（配置文件）" --result "${STATUS_FOUND}" --color GREEN

            LogText "检查：CSF 测试模式是否已禁用"
            FIND=$(${GREPBINARY} -P "^TESTING(\s|=)" ${FILE} | ${CUTBINARY} -d= -f2 | ${XARGSBINARY})
            if [ "${FIND}" = "0" ]; then
                Display --indent 4 --text "- 正在检查 CSF 测试模式是否禁用" --result "${STATUS_OK}" --color GREEN
            else
                Display --indent 4 --text "- 正在检查 CSF 测试模式是否禁用" --result "${STATUS_WARNING}" --color RED
            fi

            LogText "检查：CSF 是否正在运行"
            if [ ! -f /etc/csf/csf.disable ]; then
                Display --indent 4 --text "- 正在检查 CSF 是否运行" --result "${STATUS_OK}" --color GREEN
            else
                Display --indent 4 --text "- 正在检查 CSF 是否运行" --result "${STATUS_WARNING}" --color RED
            fi
        else
            LogText "结果：${FILE} 不存在"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4526
    # Description : Check ipf (Solaris)
    if [ ! "${IPFBINARY}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FIRE-4526 --os Solaris --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 ipf 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${IPFBINARY} -n -V | ${GREPBINARY} "^Running" | ${AWKBINARY} '{ print $2 }')
        if [ "${FIND}" = "yes" ]; then
            Display --indent 4 --text "- 正在检查 ipf 状态" --result "${STATUS_RUNNING}" --color GREEN
            LogText "结果：ipf 已启用并正在运行"
            FIREWALL_ACTIVE=1
            Report "firewall_software[]=ipf"
        else
            Display --indent 4 --text "- 正在检查 ipf 状态" --result "${STATUS_NOT_RUNNING}" --color YELLOW
            LogText "结果：ipf 未运行"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4530
    # Description : Check IPFW (FreeBSD)
    Register --test-no FIRE-4530 --os FreeBSD --weight L --network NO --category security --description "检查 IPFW 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -n "${SYSCTLBINARY}" ]; then
            # For now, only check for IPv4.
            FIND=$(${SYSCTLBINARY} net.inet.ip.fw.enable 2> /dev/null | ${AWKBINARY} '{ print $2 }')
            if [ "${FIND}" = "1" ]; then
                Display --indent 2 --text "- 正在检查 IPFW 状态" --result "${STATUS_RUNNING}" --color GREEN
                LogText "结果：IPFW 正在为 IPv4 运行"
                FIREWALL_ACTIVE=1
                Report "firewall_software[]=ipfw"
                IPFW_ENABLED=$(service -e | ${GREPBINARY} -o ipfw)
                if [ "${IPFW_ENABLED}" = "ipfw" ]; then
                    Display --indent 4 --text "- /etc/rc.conf 中已启用 IPFW" --result "${STATUS_YES}" --color GREEN
                    LogText "结果：IPFW 已配置为随 IPv4 启动"
                else
                    Display --indent 4 --text "- /etc/rc.conf 中已启用 ipfw" --result "${STATUS_NO}" --color YELLOW
                    LogText "结果：IPFW 未配置为随 IPv4 启动"
                fi
            else
                if IsVerbose; then Display --indent 2 --text "- 正在检查 IPFW 状态" --result "${STATUS_NOT_RUNNING}" --color YELLOW; fi
                LogText "结果：IPFW 未为 IPv4 运行"
            fi
        else
            ReportException "${TEST_NO}:1" "无法执行 IPFW 检查（缺少 sysctl）"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4532
    # Description : Check Application Firewall in macOS
    if [ -x /usr/libexec/ApplicationFirewall/socketfilterfw ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FIRE-4532 --weight L --os "macOS" --preqs-met ${PREQS_MET} --network NO --category security --description "检查 macOS 应用程序防火墙"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(/usr/libexec/ApplicationFirewall/socketfilterfw --getglobalstate 2> /dev/null | ${GREPBINARY} "Firewall is enabled")
        if [ -n "${FIND}" ]; then
            Display --indent 2 --text "- 正在检查 macOS 应用程序防火墙" --result "${STATUS_ENABLED}" --color GREEN
            AddHP 3 3
            LogText "结果：macOS 应用程序防火墙已启用"
            FIREWALL_ACTIVE=1
            APPLICATION_FIREWALL_ACTIVE=1
            Report "firewall_software[]=macosx-app-fw"
            Report "app_fw[]=macosx-app-fw"
        else
            if IsVerbose; then Display --indent 2 --text "- 正在检查 macOS 应用程序防火墙" --result "${STATUS_DISABLED}" --color YELLOW; fi
            AddHP 1 3
            LogText "结果：macOS 应用程序防火墙已禁用"
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4534
    # Description : Check outbound firewalls on macOS
    Register --test-no FIRE-4534 --weight L --os "macOS" --network NO --category security --description "检查 macOS 上的出站防火墙"
    if [ ${SKIPTEST} -eq 0 ]; then

        FOUND=0

        # Little Snitch Daemon (macOS)
        LogText "检查：Little Snitch Daemon 进程"
        if IsRunning --full "Little Snitch Daemon"; then
            Display --indent 2 --text "- 正在检查 Little Snitch Daemon" --result "${STATUS_ENABLED}" --color GREEN
            LogText "结果：发现 Little Snitch"
            FOUND=1
            FIREWALL_ACTIVE=1
            APPLICATION_FIREWALL_ACTIVE=1
            Report "app_fw[]=little-snitch"
            Report "firewall_software[]=little-snitch"
        fi

        # HandsOff! Daemon (macOS)
        LogText "检查：HandsOffDaemon 进程"
        if IsRunning "HandsOffDaemon"; then
            Display --indent 2 --text "- 正在检查 Hands Off! Daemon" --result "${STATUS_ENABLED}" --color GREEN
            LogText "结果：发现 Hands Off!"
            FOUND=1
            FIREWALL_ACTIVE=1
            APPLICATION_FIREWALL_ACTIVE=1
            Report "app_fw[]=hands-off"
            Report "firewall_software[]=hands-off"
        fi

        # LuLu Daemon (macOS)
        LogText "检查：LuLu 进程"
        if IsRunning "LuLu"; then
            Display --indent 2 --text "- 正在检查 LuLu Daemon" --result "${STATUS_ENABLED}" --color GREEN
            LogText "结果：发现 LuLu"
            FOUND=1
            FIREWALL_ACTIVE=1
            APPLICATION_FIREWALL_ACTIVE=1
            Report "app_fw[]=lulu"
            Report "firewall_software[]=lulu"
        fi

        # Radio Silence (macOS)
        LogText "检查：Radio Silence 进程"
        if IsRunning --full "Radio Silence"; then
            Display --indent 2 --text "- 正在检查 Radio Silence" --result "${STATUS_ENABLED}" --color GREEN
            LogText "结果：发现 Radio Silence"
            FOUND=1
            FIREWALL_ACTIVE=1
            APPLICATION_FIREWALL_ACTIVE=1
            Report "app_fw[]=radio-silence"
            Report "firewall_software[]=radio-silence"
        fi

        if [ ${FOUND} -eq 0 ]; then
            LogText "结果：未发现出站防火墙"
            AddHP 1 3
        else
            LogText "结果：发现一个或多个 macOS 出站防火墙"
            AddHP 3 3
        fi
    fi
#
#################################################################################
#
    # Test        : FIRE-4536
    # Description : Check nftables kernel module
    if HasData "${NFTBINARY}"; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
