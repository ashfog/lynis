            LogText "结果：${FILE} 存在"
            FIREWALL_ACTIVE=1
            Report "firewall_software[]=apf"
            Display --indent 2 --text "- 正在检查 APF 状态（配置文件）" --result "${STATUS_FOUND}" --color GREEN

            LogText "检查：APF 测试模式是否已禁用"
            FIND=$(${GREPBINARY} -P "^DEVEL_MODE(\s|=)" ${FILE} | ${CUTBINARY} -d= -f2 | ${XARGSBINARY})
            if [ "${FIND}" = "0" ]; then
                Display --indent 4 --text "- 正在检查 APF 测试模式是否禁用" --result "${STATUS_OK}" --color GREEN
            else
                Display --indent 4 --text "- 正在检查 APF 测试模式是否禁用" --result "${STATUS_WARNING}" --color RED
            fi

            LogText "检查：APF 是否正在运行"
            FIND=$(${IPTABLESBINARY} -L -n | ${GREPBINARY} -iom1 sanity | ${WCBINARY} -l)
            if [ "${FIND}" = "1" ]; then
                Display --indent 4 --text "- 正在检查 APF 是否运行" --result "${STATUS_OK}" --color GREEN
            else
                Display --indent 4 --text "- 正在检查 APF 是否运行" --result "${STATUS_WARNING}" --color RED
            fi
        else
            LogText "结果：${FILE} 不存在"
        fi
    fi
