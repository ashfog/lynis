#################################################################################
#
    # Test        : FILE-6430
    # Description : Disable mounting of some filesystems
    # Rationale   : Unless there is a specific reason to use a particular file system, disable it.
    # Data        : cramfs freevxfs hfs hfsplus jffs2 squashfs udf
    Register --test-no FILE-6430 --weight L --network NO --category security --description "禁用 mounting 的 一些 filesystems"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -n "${LSMODBINARY}" -a -f /proc/modules ]; then
            Display --indent 2 --text "- 禁用 内核 支持 的 一些 filesystems"
            LIST_FS_NOT_SUPPORTED="cramfs freevxfs hfs hfsplus jffs2 squashfs udf"
            FOUND=0
            AVAILABLE_FS=""
            AVAILABLE_MODPROBE_FS=""
            for FS in ${LIST_FS_NOT_SUPPORTED}; do
                # Check if filesystem is present in modprobe output
                FIND=$(${MODPROBEBINARY} -v -n ${FS} 2>/dev/null | ${GREPBINARY} -E "/${FS}.ko" | ${TAILBINARY} -1)
                if [ -n "${FIND}" ]; then
                    LogText "结果： 发现 ${FS} 支持 在 内核 (输出 = ${FIND})"
                    Debug "Module ${FS} present in the kernel"
                    LogText "检查： 检查 如果 ${FS} 是 当前"
                    # Check if FS is present in lsmod output
                    FIND=$(${LSMODBINARY} | ${GREPBINARY} -E "^${FS}")
                    if IsEmpty "${FIND}"; then
                        LogText "结果： 模块 ${FS} 是 当前 不 已加载 在 内核."
                        AddHP 2 3
                        if IsDebug; then Display --indent 6 --text "- 模块 ${FS} 不 已加载 (lsmod)" --result OK --color GREEN; fi
                    else
                        LogText "结果： 模块 ${FS} 是 已加载 在 内核"
                        Display --indent 4 --text "- 模块 $FS 已加载 在 内核 (lsmod)" --result "FOUND" --color WHITE
                        FOUND=1
                        AVAILABLE_MODPROBE_FS="${AVAILABLE_MODPROBE_FS}${FS} "
                    fi
                else
                    AddHP 3 3
                    if IsDebug; then Display --indent 6 --text "- 模块 ${FS} 不 present 在 内核" --result OK --color GREEN; fi
                fi
                
                for SUBDIR in "${ROOTDIR}etc" "${ROOTDIR}usr/lib"; do
                    if [ -d "${SUBDIR}/modprobe.d" ]; then
                        LogText "结果： 目录 ${SUBDIR}/modprobe.d 存在"
                        FIND=$(${LSBINARY} "${SUBDIR}/modprobe.d/*" 2> /dev/null)
                        if [ -n "${FIND}" ]; then
                            FIND1=$(${GREPBINARY} -E "^blacklist[[:space:]]+${FS}$" ${ROOTDIR}etc/modprobe.d/* | ${GREPBINARY} -v "#")
                            FIND2=$(${GREPBINARY} -E "^install[[:space:]]+${FS}[[:space:]]+/bin/(true|false)$" ${ROOTDIR}etc/modprobe.d/* | ${GREPBINARY} -v "#")
                            if [ -n "${FIND1}" ] || [ -n "${FIND2}" ]; then
                                Display --indent 4 --text "- 模块 $FS 是 blacklisted" --result "OK" --color GREEN
                                LogText "结果： 模块 ${FS} 是 blacklisted"
                                break
                            fi
                        fi
                    fi
                done
            done
            if [ ${FOUND} -eq 1 ]; then
                Display --indent 4 --text "- 发现 内核模块： ${AVAILABLE_MODPROBE_FS}"
                ReportSuggestion "${TEST_NO}" "建议禁用未使用的内核模块" "/etc/modprobe.d/blacklist.conf" "添加 安装 MODULENAME /bin/true（不含引号）"
            fi
        else
            LogText "检查 已跳过 lsmod 程序 未找到 或 /proc/modules 可以 不 为 opened"
        fi
        unset AVAILABLE_FS AVAILABLE_MODPROBE_FS
    fi
