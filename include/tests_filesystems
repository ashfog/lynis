#################################################################################
#
    # Test        : FILE-6311
    # Description : Checking LVM Volume Groups
    # Notes       : No volume groups found is sent to STDERR for unclear reasons. Filtering both STDERR redirecting and grep.
    if [ ! "${VGDISPLAYBINARY}" = "" -o ! "${LSVGBINARY}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FILE-6311 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 LVM 卷 组"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 用于 LVM 卷 组"
        case ${OS} in
            AIX)
                 FIND=$(${LSVGBINARY} -o)
            ;;
            Linux)
                 FIND=$(${VGDISPLAYBINARY} 2> /dev/null | ${GREPBINARY} -v "No volume groups found" | ${GREPBINARY} "VG Name" | ${AWKBINARY} '{ print $3 }' | ${SORTBINARY})
            ;;
            *)
                 ReportException "${TEST_NO}:1" "发现了卷组管理器，但尚不支持识别此操作系统"
            ;;
        esac
        if [ -n "${FIND}" ]; then
            LogText "结果： 发现 一个 或 更多 卷 组"
            for I in ${FIND}; do
                LogText "发现 LVM 卷 组： ${I}"
                Report "lvm_volume_group[]=${I}"
            done
            LVM_VG_USED=1
            Display --indent 2 --text "- 检查 LVM 卷 组" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果： 没有 LVM 卷 组 发现"
            if IsVerbose; then Display --indent 2 --text "- 检查 LVM 卷 组" --result "${STATUS_NONE}" --color WHITE; fi
        fi
    fi
