#################################################################################
#
    # Test        : FILE-6312
    # Description : Checking LVM volumes
    if [ ${LVM_VG_USED} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FILE-6312 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 LVM volumes"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查： 检查 用于 LVM volumes"
        case ${OS} in
            AIX)
                 ACTIVE_VG_LIST=$(${LSVGBINARY} -o)
                 FIND=$(for I in ${ACTIVE_VG_LIST}; do ${LSVGBINARY} -l ${I} | ${AWKBINARY} 'NR>2 { print $1 }'; done)
            ;;
            Linux)
                 FIND=$(${LVDISPLAYBINARY} | ${GREPBINARY} -v "No volume groups found" | ${GREPBINARY} "LV Name" | ${AWKBINARY} '{ print $3 }' | ${SORTBINARY})
            ;;
            *)
                 ReportException "${TEST_NO}:1" "Need specific 检查 用于 正在收集 卷管理器 数据"
            ;;
        esac
        if [ ! "${FIND}" = "" ]; then
            LogText "结果： 发现 一个 或 更多 volumes"
            for I in ${FIND}; do
                LogText "发现 LVM 卷： ${I}"
                Report "lvm_volume[]=${I}"
            done
            Display --indent 4 --text "- 检查 LVM volumes" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果： 没有 LVM 卷 组 发现"
            Display --indent 4 --text "- 检查 LVM volumes" --result "${STATUS_NONE}" --color WHITE
        fi
    fi
