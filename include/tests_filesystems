        if [ "${FIND}" = "1" ]; then
            Display --indent 2 --text "- 检查 ${ROOTDIR}var/tmp sticky bit" --result "${STATUS_OK}" --color GREEN
            LogText "结果： sticky bit 发现 在 ${ROOTDIR}var/tmp 目录"
            AddHP 3 3
        else
            Display --indent 2 --text "- 检查 ${ROOTDIR}var/tmp sticky bit" --result "${STATUS_WARNING}" --color RED
            ReportSuggestion "${TEST_NO}" "为 ${ROOTDIR}var/tmp 设置粘滞位，防止用户删除 /var/tmp 中属于其他用户的文件。" "/var/tmp" "text：设置粘滞位"
            AddHP 0 3
        fi
