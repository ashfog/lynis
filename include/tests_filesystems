    # Description : Check vm.swappiness (Linux)
    Register --test-no FILE-6394 --os Linux --weight L --network NO --category security --description "确定 level 的 swappiness."
    if [ ${SKIPTEST} -eq 0 ]; then
        SWAPLEVEL=$(${CAT_BINARY} /proc/sys/vm/swappiness)
        LogText "检查： 检查 level 的 vm.swappiness： ${SWAPLEVEL}"
        PHYSDISK=$(${LSBLKBINARY} | ${GREPBINARY} -E 'disk|SWAP' | ${GREPBINARY} -B1 SWAP | ${HEADBINARY} -n1 | ${AWKBINARY} '{print $1}')
        if [ ${SWAPLEVEL} -gt 60 ]; then
            LogText "结果： vm.swappiness=${SWAPLEVEL} meaning 该 swapping 是 更多 frequent 比 default."
            # Check if swap is on a HDD or SDD for frequent swapping
            if [ -d "/sys/block/${PHYSDISK}" ]; then
                HDDORSDD=$(${CAT_BINARY} "/sys/block/${PHYSDISK}/queue/rotational")
                if [ ${HDDORSDD} -eq 1 ]; then
                    ReportSuggestion "${TEST_NO}" "vm.swappiness 设置为 ${SWAPLEVEL}，高于默认值 60；建议为交换分区使用 SSD 以提高性能。"
                fi
            fi
        elif [ ${SWAPLEVEL} -eq 0 ]; then
            LogText "结果： vm.swappiness=${SWAPLEVEL} meaning swapping 是 已禁用."
            ReportSuggestion "${TEST_NO}" "vm.swappiness 设置为 ${SWAPLEVEL}。可考虑至少设置为 1，以尽量减少交换但不完全禁用，从而避免物理内存耗尽时 OOM killer 过早终止进程。"
        elif [ ${SWAPLEVEL} -eq 1 ]; then
            LogText "结果： vm.swappiness=${SWAPLEVEL} meaning 该 swapping 可以 仍然 occur but 在 very 最小."
        elif [ ${SWAPLEVEL} -eq 10 ]; then
            LogText "结果： vm.swappiness=${SWAPLEVEL} which 是 preferred 设置 用于 数据库 servers."
        elif [ ${SWAPLEVEL} -lt 60 ]; then
            LogText "结果： vm.swappiness=${SWAPLEVEL} meaning 该 swapping 是 更少 frequent 比 default. 此 是 仅 recommended 用于 servers."
        else
            LogText "结果： vm.swappiness=${SWAPLEVEL} which 是 standard level 的 swappiness 和 works well 用于 desktop systems."
        fi
        if IsVerbose; then Display --indent 2 --text "- Swappiness： ${SWAPLEVEL}" --result "INFO" --color WHITE; fi
    fi
