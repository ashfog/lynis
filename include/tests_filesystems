#################################################################################
#
    # Test        : FILE-6310
    # Description : Checking if some mount points are separated from /
    # Goal        : Users should not be able to fill their home directory or temporary directory and creating a Denial of Service
    Register --test-no FILE-6310 --weight L --network NO --category security --description "检查 /tmp、/home 和 /var 目录"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 2 --text "- 检查 mount 分"
        SEPARATED_FILESYTEMS="/home /tmp /var"
        for I in ${SEPARATED_FILESYTEMS}; do
            LogText "检查： 检查 如果 ${I} 是 mounted separately 或 mounted 在 / 文件 系统"
            if [ -L ${I} ]; then
                ShowSymlinkPath ${I}
                LogText "结果： ${I} 是 一个 符号链接. Manual 检查 必需 到 确定 exact 文件 系统 选项"
                ReportSuggestion "${TEST_NO}" "Symlinked mount 得分 needs 到 为 checked manually" "${I}" ""
                Display --indent 4 --text "- 检查 ${I} mount 得分" --result SYMLINK --color WHITE
            elif [ -d ${I} ]; then
                LogText "结果： 目录 ${I} 存在"
                case "${OS}" in
                    "AIX") FIND=$(${MOUNTBINARY} | ${AWKBINARY} -v MP=${I} '{ if ($2==MP) { print $2 }}') ;;
                    "HP-UX") FIND=$(${MOUNTBINARY} | ${AWKBINARY} -v MP=${I} '{ if ($1==MP) { print $1 }}') ;;
                    *) FIND=$(${MOUNTBINARY} | ${AWKBINARY} -v MP=${I} '{ if ($3==MP) { print $3 }}') ;;
                esac

                if IsEmpty "${FIND}"; then
                    LogText "结果： ${I} 未找到 在 mount 列表. 目录 大多数 很可能 stored 在 / 文件 系统"
                    Display --indent 4 --text "- 检查 ${I} mount 得分" --result "${STATUS_SUGGESTION}" --color YELLOW
                    ReportSuggestion "${TEST_NO}" "为降低 ${I} 文件系统占满带来的影响，请将 ${I} 放在独立分区中"
                    AddHP 9 10
                else
                    LogText "结果： 发现 ${I} 作为 一个 separated mount 得分"
                    Display --indent 4 --text "- 检查 ${I} mount 得分" --result "${STATUS_OK}" --color GREEN
                    AddHP 10 10
                fi
            else
                LogText "结果： 目录 ${I} 不存在"
            fi
        done
    fi
