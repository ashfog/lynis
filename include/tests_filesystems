#################################################################################
#
    # Test        : FILE-6332
    # Description : Check swap partitions
    if [ -f /etc/fstab ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FILE-6332 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 交换分区 partitions"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        LogText "检查： query 交换分区 partitions 从 /etc/fstab 文件"
        # Check if third field contains 'swap'
        FIND=$(${AWKBINARY} '{ if ($2=="swap" || $3=="swap") { print $1 }}' /etc/fstab | ${GREPBINARY} -v "^#")
        for I in ${FIND}; do
            FOUND=1
            REAL=""
            UUID=""
            LogText "交换分区 分区 发现： ${I}"
            # TODO Add a test if partition is not a normal partition (e.g. UUID=)
            # Can be ^/dev/mapper/vg-name_lv-name
            # Can be ^/dev/partition

            # Test for UUID usage (e.g. UUID=uuid --> /dev/disk/by-uuid/<uuid>)
            HAS_UUID=$(echo ${I} | ${GREPBINARY} "^UUID=")
            if [ -n "${HAS_UUID}" ]; then
                UUID=$(echo ${HAS_UUID} | ${AWKBINARY} -F= '{ print $2 }')
                LogText "结果： 使用 ${UUID} 作为 UUID"
                if [ -n "${BLKIDBINARY}" ]; then
                    FIND2=$(${BLKIDBINARY} | ${AWKBINARY} '{ if ($2=="UUID=\"${UUID}\"") print $1 }' | ${SEDBINARY} 's/:$//')
                    if [ -n "${FIND2}" ]; then
                        REAL="${FIND2}"
                    fi
                else
                    LogText "结果：未找到 blkid 程序，尝试检查设备列表"
                    sFILE=""
                    if [ -L /dev/disk/by-uuid/${UUID} ]; then
                        LogText "结果： 发现 磁盘 通过 /dev/disk/by-uuid listing"
                        ShowSymlinkPath /dev/disk/by-uuid/${UUID}
                        if [ -n "${sFILE}" ]; then
                            REAL="${sFILE}"
                            LogText "结果： 磁盘 是 ${REAL}"
                        fi
                    else
                        LogText "结果： 没有 符号链接 发现 到 /dev/disk/by-uuid/${UUID}"
                    fi
                fi
            fi
            # Set real device
            if [ -z "${REAL}" ]; then
                REAL="${I}"
            fi
            Report "swap_partition[]=${I},${REAL},"
        done
        if [ ${FOUND} -eq 1 ]; then
            Display --indent 2 --text "- Query 交换分区 partitions (fstab)" --result "${STATUS_OK}" --color GREEN
        else
            Display --indent 2 --text "- Query 交换分区 partitions (fstab)" --result "${STATUS_NONE}" --color YELLOW
            LogText "结果： 没有 交换分区 partitions 发现 在 /etc/fstab"
        fi
    fi
