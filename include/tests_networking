#
    # Test        : NETW-2400
    # Description : Test hostname for valid characters and length
    # Notes       : FQDN: max 253 characters
    #             : component: a-z, 0-9, hyphen, not start with hyphen, max 63 characters
    #               dots allowed as separator
    Register --test-no NETW-2400 --weight L --network YES --category basics --description "检查主机名长度和值"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Test first the fully qualified domain name
        if [ ${#FQDN} -gt 253 ]; then
            # Too long
            LogText "结果：FQDN 超过 253 个字符"
            Display --indent 2 --text "- 主机名（FQDN 长度）" --result "${STATUS_WARNING}" --color RED
            ReportWarning "${TEST_NO}" "主机名过长（超过 253 个字符）"
        elif [ ${#FQDN} -eq 0 ]; then
            # FQDN not defined
            LogText "结果：未定义 FQDN"
            if IsVerbose; then Display --indent 2 --text "- 主机名（FQDN 长度）" --result "${STATUS_UNKNOWN}" --color YELLOW; fi
        else
            # Fine
            LogText "结果：FQDN 已定义，且不超过 253 个字符（当前 ${#FQDN} 个字符）"
            if IsVerbose; then Display --indent 2 --text "- 主机名（FQDN 长度）" --result "${STATUS_OK}" --color GREEN; fi
        fi
        # Now test short hostname
        if [ ${#HOSTNAME} -eq 0 ]; then
            if IsVerbose; then Display --indent 2 --text "- 主机名（FQDN 长度）" --result "${STATUS_NONE}" --color RED; fi
            LogText "结果：未定义主机名"
        else
            # Test length
            if [ ${#HOSTNAME} -gt 63 ]; then
                LogText "结果：主机名超过 63 个字符"
                Display --indent 2 --text "- 主机名（长度）" --result "${STATUS_WARNING}" --color RED
            else
                LogText "结果：主机名已定义，且不超过 63 个字符"
            fi
            # Test valid characters (normally a dot should not be in the name, but we can't be 100% sure we have short name)
            FIND=$(echo "${HOSTNAME}" | ${TRBINARY} -d '[:alnum:]\.\-')
            if [ -z "${FIND}" ]; then
                LogText "结果：正常，主机名中未发现异常字符"
                if IsVerbose; then Display --indent 2 --text "- 主机名（允许的字符）" --result "${STATUS_OK}" --color GREEN; fi
            else
                LogText "结果：主机名中发现异常字符（字符：${FIND}），可能影响网络连接"
                Display --indent 2 --text "- 主机名（允许的字符）" --result "${STATUS_WARNING}" --color RED
                ReportWarning "${TEST_NO}" "主机名包含无效字符" "hostname" "text:请查看日志文件中的无效字符"
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : NETW-2600
    # Description : Gather IPv6 configuration
    Register --test-no NETW-2600 --os "Linux" --weight L --network YES --category security --description "检查 IPv6 配置"
    if [ ${SKIPTEST} -eq 0 ]; then
        IPV6_CONFIGURED=0
        IPV6_ACCEPT_RA=255
        IPV6_ACCEPT_REDIRECTS=255
        IPV6_MANUAL_CONFIGURED=255
        IPV6_ONLY=255
        IPV6_MISCONFIGURED=0
        IPV6_MISCONFIGURED_MTU=0
        FIND=$(sysctl -a 2> /dev/null | ${GREPBINARY} "^net.ipv6" | ${SEDBINARY} "s/ = /=/")
        if [ -n "${FIND}" ]; then
            IPV6_CONFIGURED=1
            for I in ${FIND}; do
                SYSCTL_KEY=$(echo ${I} | ${AWKBINARY} -F= '{ print $1 }')
                SYSCTL_VALUE=$(echo ${I} | ${AWKBINARY} -F= '{ print $2 }')
                case ${SYSCTL_KEY} in
                    "net.ipv6.conf.default.accept_ra")
                        if [ "${SYSCTL_VALUE}" = "1" ]; then IPV6_ACCEPT_RA=1; else IPV6_ACCEPT_RA=0; fi
                    ;;
                    "net.ipv6.conf.default.accept_redirects")
                        if [ "${SYSCTL_VALUE}" = "1" ]; then IPV6_ACCEPT_REDIRECTS=1; else IPV6_ACCEPT_REDIRECTS=0; fi
                    ;;
                    "net.ipv6.bindv6only")
                        if [ "${SYSCTL_VALUE}" = "1" ]; then IPV6_ONLY=1; else IPV6_ONLY=0; fi
                    ;;
                    "net.ipv6.conf.all.mtu" | "net.ipv6.conf.default.mtu")
                        if [ ${SYSCTL_VALUE} -lt 1280 ]; then IPV6_MISCONFIGURED_MTU=1; fi
                    ;;

                    #if TestValue --function equals --value "${SYSCTL_VALUE}" --search "1"; then
                    #     echo "Found ${SYSCTL_VALUE}"
                    #else
                    #     echo "Not found"
                    #fi
                esac
            done
        else
            IPV6_MODE="disabled"
        fi
        # Check if we are manually configured (not accepting automatic configuration)
        if [ ${IPV6_ACCEPT_RA} -eq 0 -a ${IPV6_ACCEPT_REDIRECTS} -eq 0 ]; then
            IPV6_MANUAL_CONFIGURED=1
            IPV6_MODE="manual"
        elif [ ${IPV6_ACCEPT_RA} -eq 1 -o ${IPV6_ACCEPT_REDIRECTS} -eq 1 ]; then
            IPV6_MODE="auto"
        else
            IPV6_MODE="disabled"
        fi

        LogText "结果：IPv6 模式为 ${IPV6_MODE}"
        if [ ${IPV6_CONFIGURED} -eq 1 ]; then
            Display --indent 2 --text "- 检查 IPv6 配置" --result "${STATUS_ENABLED}" --color WHITE
            STATUS=$(echo ${IPV6_MODE} | ${TRBINARY} '[:lower:]' '[:upper:]')
            Display --indent 6 --text "配置方式" --result "${STATUS}" --color WHITE
            if [ ${IPV6_ONLY} -eq 1 ]; then STATUS="${STATUS_YES}"; else STATUS="${STATUS_NO}"; fi
            LogText "结果：仅 IPv6 配置：${STATUS}"
            Display --indent 6 --text "仅 IPv6" --result "${STATUS}" --color WHITE
        else
            Display --indent 2 --text "- 检查 IPv6 配置" --result "${STATUS_DISABLED}" --color WHITE
        fi
        # Configuration errors
        if [ ${IPV6_MISCONFIGURED_MTU} -eq 1 ]; then
            IPV6_MISCONFIGURED=1
            LogText "结果：IPv6 接口的 MTU 应为 1280 或更高"
            Display --indent 6 --text "错误：MTU 过低" --result "${STATUS_WARNING}" --color RED
            ReportSuggestion "${TEST_NO}" "检查 IPv6 接口的 MTU 配置"
        fi

        # Possible improvements:
        # - Check if we found IPv6 enabled nameservers

        # Report
        Report "ipv6_mode=${IPV6_MODE}"
        Report "ipv6_only=${IPV6_ONLY}"
    fi
