#
    # Test        : NETW-3028
    # Description : Checking for many waiting connections
    # Type        : Performance
    # Notes       : It is common to see a healthy web server seeing to have several thousands of TCP connections in WAIT state
    if [ ! "${NETSTATBINARY}" = "" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NETW-3028 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 WAIT 状态的连接"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：使用 netstat 检查 WAIT 状态的连接"
        FIND=$(${NETSTATBINARY} -an | ${GREPBINARY} WAIT | ${WCBINARY} -l | ${AWKBINARY} '{ print $1 }')
        if IsEmpty "${OPTIONS_CONN_MAX_WAIT_STATE}"; then OPTIONS_CONN_MAX_WAIT_STATE="5000"; fi
        LogText "结果：当前有 ${FIND} 个连接处于等待状态（配置的最大值：${OPTIONS_CONN_MAX_WAIT_STATE}）。"
        if [ ${FIND} -gt ${OPTIONS_CONN_MAX_WAIT_STATE} ]; then
            Display --indent 2 --text "- 检查等待状态的连接" --result "${STATUS_WARNING}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "确定系统为何存在大量 WAIT 状态连接（${FIND}）"
        else
            Display --indent 2 --text "- 检查等待状态的连接" --result "${STATUS_OK}" --color GREEN
            LogText "结果：有 ${FIND} 个连接处于 WAIT 状态"
        fi
    fi
