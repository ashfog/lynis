#
    # Test        : NETW-3015
    # Description : Checking promiscuous interfaces (Linux)
    Register --test-no NETW-3015 --os Linux --weight L --network NO --category security --description "检查混杂模式接口（Linux）"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUNDPROMISC=99
        NETWORK=""
        USE_IP_INSTEAD_IFCONFIG=0

        if [ -n "${IPBINARY}" ]; then
            LogText "检查：使用 ip 命令获取网络接口"
            NETWORK=$(${IPBINARY} -o link 2> /dev/null | ${GREPBINARY} "^[0-9]" | ${AWKBINARY} '{print $2 }' | ${TRBINARY} -d ':')
            USE_IP_INSTEAD_IFCONFIG=1
        elif [ -n "${IFCONFIGBINARY}" ]; then
            LogText "检查：使用 ifconfig 命令获取网络接口"
            NETWORK=$(${IFCONFIGBINARY} 2> /dev/null | ${GREPBINARY} Link | ${TRBINARY} -s ' ' | ${CUTBINARY} -d ' ' -f1)
        fi

        LogText "检查：检查所有接口是否启用了混杂模式"
        if [ -n "${NETWORK}" ]; then
            FOUNDPROMISC=0
            for I in ${NETWORK}; do
                if [ ${USE_IP_INSTEAD_IFCONFIG} -eq 1 ]; then
                    FIND=$(${IPBINARY} -o -d link show ${I} 2> /dev/null | ${GREPBINARY} "promiscuity [1-9]")
                else
                    FIND=$(${IFCONFIGBINARY} ${I} 2> /dev/null | ${GREPBINARY} PROMISC)
                fi
                if [ -n "${FIND}" ]; then
                    LogText "结果：混杂模式接口：${I}"
                    ISWHITELISTED=$(${GREPBINARY} "^if_promisc:${I}:" ${PROFILE})
                    if [ -z "${ISWHITELISTED}" ]; then
                        FOUNDPROMISC=1
                        ReportWarning "${TEST_NO}" "发现混杂模式接口" "${I}" "text:确认是否需要此模式，或在配置文件中将接口加入白名单"
                        LogText "说明：某些工具会将接口设为混杂模式，以捕获或记录网络流量"
                    else
                        LogText "Result: 发现混杂模式接口 ${I} (*whitelisted via profile*)"
                    fi
                fi
            done
        else
            LogText "结果：未发现网络接口，因此未执行检查"
        fi

        # Show result
        if [ ${FOUNDPROMISC} -eq 0 ]; then
            Display --indent 2 --text "- 检查混杂模式接口" --result "${STATUS_OK}" --color GREEN
            LogText "结果：未发现混杂模式接口"
        elif [ ${FOUNDPROMISC} -eq 1 ]; then
            Display --indent 2 --text "- 检查混杂模式接口" --result "${STATUS_WARNING}" --color RED
        else
            Display --indent 2 --text "- 检查混杂模式接口" --result "${STATUS_UNKNOWN}" --color YELLOW
        fi
    fi
