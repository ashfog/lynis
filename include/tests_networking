#
    # Test        : NETW-3014
    # Description : Checking promiscuous interfaces (BSD)
    # Note        : FreeBSD and others
    if [ "${OS}" = "DragonFly" -o "${OS}" = "FreeBSD" -o "${OS}" = "NetBSD" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no NETW-3014 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查混杂模式接口（BSD）"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：检查混杂模式接口（FreeBSD）"
        FIND=$(${IFCONFIGBINARY} 2> /dev/null | ${GREPBINARY} PROMISC | ${CUTBINARY} -d ':' -f1)
        if HasData "${FIND}"; then
            LogText "结果：混杂模式接口：${FIND}"
            for ITEM in ${FIND}; do
                WHITELISTED=0
                for PROFILE in ${PROFILES}; do
                    Debug "Checking if interface ${ITEM} is whitelisted in profile ${PROFILE}"
                    ISWHITELISTED=$(${GREPBINARY} "^if_promisc:${ITEM}:" ${PROFILE})
                    if HasData "${ISWHITELISTED}"; then
                        WHITELISTED=1
                        LogText "结果：此接口已在配置文件中加入白名单（${PROFILE}）"
                    fi
                done
                # Check if this interface was whitelisted
                if [ ${WHITELISTED} -eq 0 ]; then
                    FOUNDPROMISC=1
                    ReportWarning "${TEST_NO}" "发现混杂模式接口（${ITEM}）"
                    LogText "说明：某些工具会将接口设为混杂模式，以捕获或记录网络流量"
                else
                    LogText "结果：发现混杂模式接口 ${ITEM}（已通过配置文件加入白名单）"
                fi
            done
        fi

        # Show result
        if [ ${FOUNDPROMISC} -eq 0 ]; then
            Display --indent 2 --text "- 检查混杂模式接口" --result "${STATUS_OK}" --color GREEN
            LogText "结果：未发现混杂模式接口"
        else
            Display --indent 2 --text "- 检查混杂模式接口" --result "${STATUS_WARNING}" --color RED
        fi
    fi
