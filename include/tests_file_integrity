    AIDECONFIG=""
    CSF_CONFIG="${ROOTDIR}etc/csf/csf.conf"
    FILE_INT_TOOL=""
    FILE_INT_TOOL_FOUND=0     # Boolean, file integrity tool found
#
#################################################################################
#
    InsertSection "${SECTION_FILE_INTEGRITY}"
    Display --indent 2 --text "- 正在检查文件完整性工具"
#
#################################################################################
#
    # Test        : FINT-4310
    # Description : Check if AFICK is installed
    Register --test-no FINT-4310 --weight L --network NO --category security --description "检查 AFICK 是否可用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：AFICK 可执行文件"
        if [ -n "${AFICKBINARY}" ]; then
            LogText "结果：已安装 AFICK（${AFICKBINARY}）"
            Report "file_integrity_tool[]=afick"
            FILE_INT_TOOL="afick"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- AFICK" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未安装 AFICK"
            if IsVerbose; then Display --indent 4 --text "- AFICK" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4314
    # Description : Check if AIDE is installed
    Register --test-no FINT-4314 --weight L --network NO --category security --description "检查 AIDE 是否可用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：AIDE 可执行文件"
        if [ -n "${AIDEBINARY}" ]; then
            LogText "结果：已安装 AIDE（${AIDEBINARY}）"
            Report "file_integrity_tool[]=aide"
            FILE_INT_TOOL="aide"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- AIDE" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未安装 AIDE"
            if IsVerbose; then Display --indent 4 --text "- AIDE" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4315
    # Description : Check AIDE configuration file
    if [ -n "${AIDEBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FINT-4315 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 AIDE 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        AIDE_CONFIG_LOCS="${ROOTDIR}etc ${ROOTDIR}etc/aide ${ROOTDIR}usr/local/etc"
        LogText "检查：在 ${AIDE_CONFIG_LOCS} 中搜索 aide.conf"
        for I in ${AIDE_CONFIG_LOCS}; do
            if [ -f "${I}/aide.conf" ]; then
                LogText "结果：在目录 ${I} 中发现 aide.conf"
                AIDECONFIG="${I}/aide.conf"
            fi
        done

        if [ -z "${AIDECONFIG}" ]; then
            Display --indent 6 --text "- AIDE 配置文件" --result "${STATUS_NOT_FOUND}" --color RED
            ReportWarning "${TEST_NO}" "未找到 AIDE 配置文件，AIDE 正常工作需要该文件"
        else
            LogText "正在检查配置文件 ${AIDECONFIG} 是否存在错误"
            FIND=$(${AIDEBINARY} --config=${AIDECONFIG} -D)
            if [ $? -eq 0 ]; then
                Display --indent 6 --text "- AIDE 配置文件" --result "${STATUS_FOUND}" --color GREEN
            else
                Display --indent 6 --text "- AIDE 配置文件" --result "${STATUS_WARNING}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "检查 AIDE 配置文件，其中可能存在错误"
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4316
    # Description : Presence of AIDE database and size check
    if [ -n "${AIDEBINARY}" -a -n "${AIDECONFIG}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FINT-4316 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 AIDE 数据库是否存在及其大小"
    if [ ${SKIPTEST} -eq 0 ]; then
        AIDE_DB=$(${GREPBINARY} -E '(^database|^database_in)=' ${AIDECONFIG} | ${SEDBINARY} "s/.*://")
        if case ${AIDE_DB} in @@*) ;; *) false;; esac; then
            I=$(${GREPBINARY} "@@define.*DBDIR" ${AIDECONFIG} | ${AWKBINARY} '{print $3}')
            AIDE_DB=$(echo ${AIDE_DB} | ${SEDBINARY} "s#.*}#${I}#")
        fi
        LogText "检查：在磁盘上搜索 AIDE 数据库 ${AIDE_DB}"

        if [ ! -e "${AIDE_DB}" ]; then
            Display --indent 6 --text "- AIDE 数据库" --result "${STATUS_NOT_FOUND}" --color RED
            LogText "结果：AIDE 数据库 ${AIDE_DB} 不存在"
            ReportWarning "${TEST_NO}" "未找到 AIDE 数据库，AIDE 正常工作需要该数据库"
        else
            LogText "正在检查数据库大小 ${AIDE_DB}"
            if [ -s "${AIDE_DB}" ]; then
                Display --indent 6 --text "- AIDE 数据库" --result "${STATUS_FOUND}" --color GREEN
                LogText "结果：AIDE 数据库 ${AIDE_DB} 存在且大小大于零"
            else
                Display --indent 6 --text "- AIDE 数据库" --result "${STATUS_WARNING}" --color YELLOW
                LogText "结果：AIDE 数据库 ${AIDE_DB} 存在，但大小为零"
                ReportSuggestion "${TEST_NO}" "检查 AIDE 数据库，其中可能存在错误"
            fi
        fi
        unset AIDE_DB I
    fi
#
#################################################################################
#
    # Test        : FINT-4318
    # Description : Check if Osiris is installed
    Register --test-no FINT-4318 --weight L --network NO --category security --description "检查 Osiris 是否可用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：Osiris 可执行文件"
        if [ -n "${OSIRISBINARY}" ]; then
            LogText "结果：已安装 Osiris（${OSIRISBINARY}）"
            Report "file_integrity_tool[]=osiris"
            FILE_INT_TOOL="osiris"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- Osiris" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未安装 Osiris"
            if IsVerbose; then Display --indent 4 --text "- Osiris" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4322
    # Description : Check if Samhain is installed
    Register --test-no FINT-4322 --weight L --network NO --category security --description "检查 Samhain 是否可用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：Samhain 可执行文件"
        if [ -n "${SAMHAINBINARY}" ]; then
            LogText "结果：已安装 Samhain（${SAMHAINBINARY}）"
            Report "file_integrity_tool[]=samhain"
            FILE_INT_TOOL="samhain"
