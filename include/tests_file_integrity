            if IsVerbose; then Display --indent 4 --text "- Samhain" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4326
    # Description : Check if Tripwire is installed
    Register --test-no FINT-4326 --weight L --network NO --category security --description "检查 Tripwire 是否可用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：Tripwire 可执行文件"
        if [ -n "${TRIPWIREBINARY}" ]; then
            LogText "结果：已安装 Tripwire（${TRIPWIREBINARY}）"
            Report "file_integrity_tool[]=tripwire"
            FILE_INT_TOOL="tripwire"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- Tripwire" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未安装 Tripwire"
            if IsVerbose; then Display --indent 4 --text "- Tripwire" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4328
    # Description : Check if OSSEC system integrity tool is running
    Register --test-no FINT-4328 --weight L --network NO --category security --description "检查 OSSEC syscheck 守护进程是否运行"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：OSSEC syscheck 守护进程是否正在运行"
        if IsRunning "ossec-syscheckd"; then
            LogText "结果：syscheck（OSSEC）处于活动状态"
            Report "file_integrity_tool[]=ossec"
            FILE_INT_TOOL="ossec-syscheck"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- OSSEC（系统检查）" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：syscheck（OSSEC）未处于活动状态"
            if IsVerbose; then Display --indent 4 --text "- OSSEC" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4330
    # Description : Check if mtree is installed
    # Note        : Usually on BSD and similar
    Register --test-no FINT-4330 --weight L --network NO --category security --description "检查 mtree 是否可用"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：mtree 可执行文件"
        if [ -n "${MTREEBINARY}" ]; then
            LogText "结果：已安装 mtree（${MTREEBINARY}）"
            Report "file_integrity_tool[]=mtree"
            FILE_INT_TOOL="mtree"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- mtree" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未安装 mtree"
            if IsVerbose; then Display --indent 4 --text "- mtree" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4334
    # Description : Check if LFD is used (part of CSF suite)
    if [ -f ${CSF_CONFIG} ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FINT-4334 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 lfd 守护进程状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 4 --text "- lfd（CSF）" --result "${STATUS_FOUND}" --color GREEN
        LogText "检查：确定 lfd 状态"
        if IsRunning "lfd - sleeping"; then
            LogText "结果：lfd 守护进程正在运行（CSF）"
            Report "file_integrity_tool[]=csf-lfd"
            Display --indent 6 --text "- LFD（CSF）守护进程" --result "${STATUS_RUNNING}" --color GREEN
            FILE_INT_TOOL="csf-lfd"
            FILE_INT_TOOL_FOUND=1
        else
            Display --indent 6 --text "- LFD（CSF）守护进程" --result "${STATUS_NOT_RUNNING}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4336
    # Description : Check if LFD is enabled (part of CSF suite)
    if [ -f ${CSF_CONFIG} ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FINT-4336 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 lfd 配置状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        # LFD configuration parameters
        ENABLED=$(${GREPBINARY} "^LF_DAEMON = \"1\"" ${CSF_CONFIG})
        if [ -n "${ENABLED}" ]; then
            LogText "结果：lfd 服务已配置为运行"
            Display --indent 6 --text "- 配置状态" --result "${STATUS_ENABLED}" --color GREEN
        else
            LogText "结果：lfd 服务已配置为不运行"
            Display --indent 6 --text "- 配置状态" --result "${STATUS_DISABLED}" --color YELLOW
        fi
        ENABLED=$(${GREPBINARY} "^LF_DIRWATCH =" ${CSF_CONFIG} | ${AWKBINARY} '{ print $3 }' | ${SEDBINARY} 's/"//g')
        if [ ! "${ENABLED}" = "0" -a -n "${ENABLED}" ]; then
            LogText "结果：已启用 lfd 目录监控（值：${ENABLED}）"
            Display --indent 6 --text "- 临时目录监控" --result "${STATUS_ENABLED}" --color GREEN
        else
            LogText "结果：已禁用 lfd 目录监控"
            Display --indent 6 --text "- 临时目录监控" --result "${STATUS_DISABLED}" --color YELLOW
        fi
        ENABLED=$(${GREPBINARY} "^LF_DIRWATCH_FILE =" ${CSF_CONFIG} | ${AWKBINARY} '{ print $3 }' | ${SEDBINARY} 's/"//g')
        if [ ! "${ENABLED}" = "0" -a -n "${ENABLED}" ]; then
            Display --indent 6 --text "- 目录/文件监控" --result "${STATUS_ENABLED}" --color GREEN
        else
            Display --indent 6 --text "- 目录/文件监控" --result "${STATUS_DISABLED}" --color YELLOW
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4338
    # Description : Check if osquery system integrity tool is running
    Register --test-no FINT-4338 --weight L --network NO --category security --description "检查 osqueryd syscheck 守护进程是否运行"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：osqueryd syscheck 守护进程是否正在运行"
        if IsRunning "osqueryd"; then
            LogText "结果：已安装 syscheck（osquery）"
            Report "file_integrity_tool[]=osquery"
            FILE_INT_TOOL="osquery"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- osquery 守护进程（syscheck）" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：未安装 syscheck（osquery）"
            if IsVerbose; then Display --indent 4 --text "- osquery 守护进程（syscheck）" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4339
    # Description : Check IMA/EVM status
    if [ ! -z "${EVMCTLBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; SKIPREASON="未找到 evmctl 可执行文件"; fi
    Register --test-no FINT-4339 --os Linux --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --category security --description "检查 IMA/EVM 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        if [ -e /sys/kernel/security/ima ]; then
            FOUND=$(${CAT_BINARY} /sys/kernel/security/ima/runtime_measurements_count)
        fi
        if [ "${FOUND}" -ne 1 ]; then
            LogText "结果：发现 EVM 工具，但 IMA/EVM 已禁用"
            Display --indent 2 --text "- IMA/EVM（状态）" --result "${STATUS_DISABLED}" --color YELLOW
        else
            LogText "结果：发现 EVM 工具，IMA/EVM 已启用"
            FILE_INT_TOOL="evmctl"
            FILE_INT_TOOL_FOUND=1
            Display --indent 2 --text "- IMA/EVM（状态）" --result "${STATUS_ENABLED}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4340
    # Description : Check dm-integrity status
    if [ ! -z "${INTEGRITYSETUPBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; SKIPREASON="未找到 integritysetup 可执行文件"; fi
    Register --test-no FINT-4340 --os Linux --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --category security --description "检查 dm-integrity 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        ROOTPROTECTED=0
	ROOTDEVICE=$(${MOUNTBINARY} | ${AWKBINARY} '/ on \/ type / { print $1 }')
	for DEVICE in /dev/mapper/*; do
	    if [ -e "${DEVICE}" ]; then
		FIND=$(${INTEGRITYSETUPBINARY} status "${DEVICE}" | ${GREPBINARY} -E 'type:.*INTEGRITY')
		if [ ! -z "${FIND}" ]; then
		    FOUND=1
		    LogText "结果：发现 dm-integrity 设备 ${DEVICE}"
		    if [ "${DEVICE}" = "${ROOTDEVICE}" ]; then
			ROOTPROTECTED=1
		    fi
		fi
	    fi
	done
        if [ "${FOUND}" -ne 1 ]; then
            LogText "结果：发现 dm-integrity 工具，但没有活动设备"
            Display --indent 2 --text "- dm-integrity（状态）" --result "${STATUS_DISABLED}" --color WHITE
        else
            LogText "结果：发现 dm-integrity 工具和活动设备"
	    if [ ${ROOTPROTECTED} -eq 1 ]; then
		LogText "结果：根文件系统受 dm-integrity 保护"
		Display --indent 2 --text "- dm-integrity（状态）" --result "${STATUS_ENABLED}" --color GREEN
	    else
		LogText "结果：发现活动的 dm-integrity 设备，但根文件系统未受其保护"
		Display --indent 2 --text "- dm-integrity（状态）" --result "${STATUS_FOUND}" --color YELLOW
	    fi
            FILE_INT_TOOL="dm-integrity"
            FILE_INT_TOOL_FOUND=1
            Display --indent 2 --text "- dm-integrity（状态）" --result "${STATUS_ENABLED}" --color GREEN
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4341
    # Description : Check dm-verity status
    if [ ! -z "${VERITYSETUPBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; SKIPREASON="未找到 veritysetup 可执行文件"; fi
    Register --test-no FINT-4341 --os Linux --preqs-met ${PREQS_MET} --skip-reason "${SKIPREASON}" --weight L --network NO --category security --description "检查 dm-verity 状态"
    if [ ${SKIPTEST} -eq 0 ]; then
        FOUND=0
        ROOTPROTECTED=0
	ROOTDEVICE=$(${MOUNTBINARY} | ${AWKBINARY} '/ on \/ type / { print $1 }')
	for DEVICE in /dev/mapper/*; do
	    if [ -e "${DEVICE}" ]; then
		FIND=$(${VERITYSETUPBINARY} status "${DEVICE}" | ${GREPBINARY} -E 'type:.*VERITY')
		if [ ! -z "${FIND}" ]; then
		    FOUND=1
		    LogText "结果：发现 dm-verity 设备 ${DEVICE}"
		    if [ "${DEVICE}" = "${ROOTDEVICE}" ]; then
			ROOTPROTECTED=1
		    fi
		fi
	    fi
	done
        if [ "${FOUND}" -ne 1 ]; then
            LogText "结果：发现 dm-verity 工具，但没有活动设备"
            Display --indent 2 --text "- dm-verity（状态）" --result "${STATUS_DISABLED}" --color WHITE
        else
            LogText "结果：发现 dm-verity 工具和活动设备"
	    if [ ${ROOTPROTECTED} -eq 1 ]; then
		LogText "结果：根文件系统受 dm-verity 保护"
		Display --indent 2 --text "- dm-verity（状态）" --result "${STATUS_ENABLED}" --color GREEN
	    else
		LogText "结果：发现活动的 dm-verity 设备，但根文件系统未受其保护"
		Display --indent 2 --text "- dm-verity（状态）" --result "${STATUS_FOUND}" --color YELLOW
	    fi
            FILE_INT_TOOL="dm-verity"
            FILE_INT_TOOL_FOUND=1
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4344
    # Description : Check if Wazuh system integrity tool is running
    Register --test-no FINT-4344 --weight L --network NO --category security --description "检查 Wazuh syscheck 守护进程是否运行"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：Wazuh syscheck 守护进程是否正在运行"
        if IsRunning "wazuh-syscheckd"; then
            LogText "结果：syscheck（Wazuh）处于活动状态"
            Report "file_integrity_tool[]=wazuh"
            FILE_INT_TOOL="wazuh-syscheck"
            FILE_INT_TOOL_FOUND=1
            Display --indent 4 --text "- Wazuh（系统检查）" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：syscheck（Wazuh）未处于活动状态"
            if IsVerbose; then Display --indent 4 --text "- Wazuh" --result "${STATUS_NOT_FOUND}" --color WHITE; fi
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4402 (was FINT-4316)
    # Description : Check if AIDE is configured to use SHA256 or SHA512 checksums
    if [ ! "${AIDEBINARY}" = "" -a -n "${AIDECONFIG}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no FINT-4402 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 AIDE 是否配置为使用 SHA256 或 SHA512 校验和"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${GREPBINARY} -v "^#" ${AIDECONFIG} | ${GREPBINARY} -E "= .*(sha256|sha512)")
        if [ -z "${FIND}" ]; then
            LogText "结果：未发现使用 SHA256 或 SHA512 创建校验和的配置"
            Display --indent 6 --text "- AIDE 配置（校验和）" --result Suggestion --color YELLOW
            ReportSuggestion "${TEST_NO}" "在 AIDE 中使用 SHA256 或 SHA512 创建校验和"
            AddHP 1 3
        else
            LogText "结果：发现使用 SHA256 或 SHA512 创建校验和的配置"
            Display --indent 6 --text "- AIDE 配置（校验和）" --result "${STATUS_OK}" --color GREEN
            AddHP 2 2
        fi
    fi
#
#################################################################################
#
    # Test        : FINT-4350
    # Description : Check if at least one file integrity tool is installed
    Register --test-no FINT-4350 --weight L --network NO --category security --description "检查是否安装文件完整性软件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：是否至少存在一个可用或已安装的文件完整性工具"
        if [ ${FILE_INT_TOOL_FOUND} -eq 1 ]; then
            LogText "结果：至少发现一个文件完整性工具"
            Display --indent 2 --text "- 正在检查完整性工具" --result "${STATUS_FOUND}" --color GREEN
            AddHP 5 5
        else
            LogText "结果：未发现文件完整性工具"
            Display --indent 2 --text "- 正在检查完整性工具" --result "${STATUS_NOT_FOUND}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "安装文件完整性工具，以监控关键和敏感文件的变化"
            AddHP 0 5
        fi
    fi
#
#################################################################################
#

WaitForKeyPress

# EOF
