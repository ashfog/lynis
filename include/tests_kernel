#################################################################################
#
    # Test        : KRNL-5788
    # Description : Checking availability new kernel
    if [ "${LINUX_VERSION}" = "Debian" ] || [ "${LINUX_VERSION}" = "Ubuntu" ] || [ "${LINUX_VERSION_LIKE}" = "Debian" ] || [ "${LINUX_VERSION_LIKE}" = "Ubuntu" ]; then
        PREQS_MET="YES"
    else
        PREQS_MET="NO"
    fi
    Register --test-no KRNL-5788 --os Linux --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查新 Linux 内核的可用性"
    if [ ${SKIPTEST} -eq 0 ]; then
        FINDKERNEL=""
        HAS_VMLINUZ=0
        LogText "检查：搜索 apt-cache，以确定是否有更新的内核"
        if [ -x ${ROOTDIR}usr/bin/apt-cache ]; then
            LogText "结果：找到${ROOTDIR}usr/bin/apt-cache"
            LogText "测试：检查 ${ROOTDIR}vmlinuz 或 ${ROOTDIR}boot/vmlinuz 是否存在"
            if [ -f ${ROOTDIR}vmlinuz -o -f ${ROOTDIR}boot/vmlinuz ]; then
                HAS_VMLINUZ=1
                if [ -f ${ROOTDIR}vmlinuz ]; then
                    FINDVMLINUZ="${ROOTDIR}vmlinuz"
                else
                    FINDVMLINUZ="${ROOTDIR}boot/vmlinuz"
                fi
                LogText "结果：找到${FINDVMLINUZ}"
                LogText "测试：检查 ${FINDVMLINUZ} 的读取链接位置"
                FINDKERNFILE=$(readlink -f ${FINDVMLINUZ})
                LogText "输出：readlink报告的文件${FINDKERNFILE}"
                LogText "测试：使用 dpkg -S 的输出检查相关包"
                FINDKERNEL=$(dpkg -S ${FINDKERNFILE} 2> /dev/null | ${AWKBINARY} -F : '{print $1}')
                LogText "输出： dpkg -S 报告包 ${FINDKERNEL}"
            elif [ -e ${ROOTDIR}dev/grsec ]; then
                FINDKERNEL="linux-image-$(uname -r)"
                LogText "结果：由于 grsecurity，${ROOTDIR}vmlinuz 缺失；假定内核为 ${FINDKERNEL}"
            elif [ -e ${ROOTDIR}etc/rpi-issue ]; then
                FINDKERNEL="raspberrypi-kernel"
                LogText "结果：由于 Raspbian，${ROOTDIR}vmlinuz 丢失"
            elif $(${GREPBINARY} -E -q 'do_symlinks.*=.*No' ${ROOTDIR}etc/kernel-img.conf); then
                FINDKERNEL="linux-image-$(uname -r)"
                LogText "结果：由于 /etc/kernel-img.conf 项 do_symlinks = No，${ROOTDIR}vmlinuz 缺失"
            else
                LogText "此系统缺少 ${ROOTDIR}vmlinuz 或 ${ROOTDIR}boot/vmlinuz。无法检查内核是否是最新的。"
                ReportSuggestion "${TEST_NO}" "确定此 Debian/Ubuntu 系统上缺少 ${ROOTDIR}vmlinuz 或 ${ROOTDIR}boot/vmlinuz 的原因。" "/vmlinuz or /boot/vmlinuz"
            fi

            if IsEmpty "${FINDKERNEL}"; then
                LogText "结果：无法检查内核更新状态，因为内核未知"
            else
                LogText "结果：发现内核 '${FINDKERNEL}'，将用于后续检查"
                LogText "测试：使用 apt-cache policy 确定是否有可用更新"
                FINDINSTALLED=$(apt-cache policy ${FINDKERNEL} | ${GREPBINARY} -E 'Installed' | ${CUTBINARY} -d ':' -f2 | ${TRBINARY} -d ' ')
                FINDCANDIDATE=$(apt-cache policy ${FINDKERNEL} | ${GREPBINARY} -E 'Candidate' | ${CUTBINARY} -d ':' -f2 | ${TRBINARY} -d ' ')
                LogText "安装的内核：${FINDINSTALLED}"
                LogText "候选内核：${FINDCANDIDATE}"
                if IsEmpty "${FINDINSTALLED}"; then
                    Display --indent 2 --text "- 检查可用的内核更新" --result "${STATUS_UNKNOWN}" --color YELLOW
                    LogText "结果：发生异常，apt-cache policy 没有输出"
                    if [ ${HAS_VMLINUZ} -eq 1 ]; then
                        ReportException "${TEST_NO}:01" "找到 vmlinuz (${FINDVMLINUZ})，但无法使用 apt-cache policy 确定已安装的内核"
                        ReportSuggestion "${TEST_NO}" "检查 apt-cache policy 的输出以确定其输出为何为空"
                    fi
                    LogText "结果：apt-cache policy 未返回已安装的内核版本"
                else
                    if [ "${FINDINSTALLED}" = "${FINDCANDIDATE}" ]; then
                        if [ -e /dev/grsec ]; then
                            Display --indent 2 --text "- 检查可用的内核更新" --result GRSEC --color GREEN
                            LogText "结果：已安装 Grsecurity，无法确定是否有更新的内核"
                            ReportManual "Manually check to confirm you're using a recent kernel and grsecurity patch"
                        else
                            Display --indent 2 --text "- 检查可用的内核更新" --result "${STATUS_OK}" --color GREEN
                            LogText "结果：没有可用的内核更新"
                        fi
                    else
                        Display --indent 2 --text "- 检查可用的内核更新" --result "有可用更新" --color YELLOW
                        LogText "结果：根据 'apt-cache policy'，有可用的内核更新。"
                        ReportSuggestion "${TEST_NO}" "确定可用内核更新的优先级"
                    fi
                fi
            fi
        else
            LogText "结果：找不到 ${ROOTDIR}usr/bin/apt-cache，跳过其他检查。"
        fi
        unset FINDCANDIDATE FINDINSTALLED FINDKERNEL HAS_VMLINUZ
    fi
