#
    # Test        : KRNL-5726
    # Description : Checking Linux loaded kernel modules
    Register --test-no KRNL-5726 --os Linux --weight L --network NO --category security --description "检查 Linux 加载的内核模块"
    if [ ${SKIPTEST} -eq 0 ]; then
        if [ -n "${LSMODBINARY}" -a -f /proc/modules ]; then
            FIND=$(${LSMODBINARY} | ${AWKBINARY} '{ if ($1!="Module") print $1 }' | sort)
            Display --indent 2 --text "- 检查加载的内核模块" --result "${STATUS_DONE}" --color GREEN
            if HasData "${FIND}"; then
                LogText "根据 lsmod 加载模块："
                COUNT=0
                for ITEM in ${FIND}; do
                    LogText "加载模块：${ITEM}"
                    Report "loaded_kernel_module[]=${ITEM}"
                    COUNT=$((COUNT + 1))
                done
                Display --indent 6 --text "找到 ${COUNT} 有源模块"
            else
                LogText "结果：未找到加载的模块"
                LogText "注意：未发现已加载的内核模块，可能是 lsmod 损坏或格式异常，也可能使用了自定义单体内核"
            fi
        else
            LogText "已跳过检查：未找到 lsmod 程序或无法打开 /proc/modules"
        fi
    fi
