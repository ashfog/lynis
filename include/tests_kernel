#
    # Test        : KRNL-5622
    # Description : Check default run level on Linux machines
    Register --test-no KRNL-5622 --os Linux --weight L --network NO --category security --description "确定 Linux 默认运行级别"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Checking if we can find the systemd default target
        LogText "测试：检查 systemd default.target"
        if [ $( [ ! -z ${SYSTEMCTLBINARY} ] && ${SYSTEMCTLBINARY} get-default) ]; then
            FIND=$(${SYSTEMCTLBINARY} get-default)
            FIND2=$(${ECHOCMD} ${FIND} | ${EGREPBINARY} "runlevel5|graphical")
            if HasData "${FIND2}"; then
                LogText "结果：在 runlevel5/graphical 上找到匹配项"
                Display --indent 2 --text "- 检查默认运行级别" --result "runlevel 5" --color GREEN
                Report "linux_default_runlevel=5"
            else
                LogText "结果：未找到匹配的运行级别，默认使用运行级别 3"
                Display --indent 2 --text "- 检查默认运行级别" --result "runlevel 3" --color GREEN
                Report "linux_default_runlevel=3"
            fi
        else
            LogText "结果：未找到 systemd，尝试检查 inittab"
            LogText "测试：检查 ${ROOTDIR}etc/inittab"
            if [ -f ${ROOTDIR}etc/inittab ]; then
                LogText "结果：找到文件 ${ROOTDIR}etc/inittab"
                LogText "测试：检查默认 Linux 运行级别"
                FIND=$(${AWKBINARY} -F: '/^id/ { print $2; }' ${ROOTDIR}etc/inittab | head -n 1)
                if IsEmpty "${FIND}"; then
                    Display --indent 2 --text "- 检查默认运行级别" --result "${STATUS_UNKNOWN}" --color YELLOW
                    LogText "结果：无法从 ${ROOTDIR}etc/inittab 确定默认运行级别"
                else
                    Display --indent 2 --text "- 检查默认运行级别" --result "${FIND}" --color GREEN
                    LogText "发现默认运行级别 '${FIND}'"
                    Report "linux_default_runlevel=${FIND}"
                fi
            else
                LogText "结果：找不到文件 ${ROOTDIR}etc/inittab"
                if [ "${LINUX_VERSION}" = "Debian" ] || [ "${LINUX_VERSION}" = "Ubuntu" ] || [ "${LINUX_VERSION_LIKE}" = "Debian" ] || [ "${LINUX_VERSION_LIKE}" = "Ubuntu" ]; then
                    LogText "检查：在 Debian 系统上使用 who -r 检查运行级别"
                    FIND=$(who -r | ${AWKBINARY} '{ if ($1=="run-level") { print $2 } }')
                    if HasData "${FIND}"; then
                        LogText "Result: 发现默认运行级别 '${FIND}'"
                        Report "linux_default_runlevel=${FIND}"
                        Display --indent 2 --text "- 检查默认运行级别" --result "RUNLEVEL ${FIND}" --color GREEN
                    else
                        LogText "结果：无法通过 who -r 确定默认运行级别"
                        Display --indent 2 --text "- 检查默认运行级别" --result "${STATUS_UNKNOWN}" --color YELLOW
                    fi
                fi
            fi
        fi
    fi
#
#################################################################################
#
    # Test        : KRNL-5677
    # Description : Check CPU options and support (PAE, No eXecute, eXecute Disable)
    # More info   : pae and nx bit are both visible on AMD and Intel CPU's if supported

    Register --test-no KRNL-5677 --platform "x86_64 amd64" --os "Linux NetBSD" --weight L --network NO --category security --description "检查 CPU 选项和支持"
    if [ ${SKIPTEST} -eq 0 ]; then
        Display --indent 2 --text "- 检查 CPU 支持 (NX/PAE)"
        LogText "测试：检查/proc/cpuinfo"
        if [ -f /proc/cpuinfo ]; then
            LogText "结果：找到/proc/cpuinfo"
            LogText "测试：检查 CPU 选项 (XD/NX/PAE)"
            FIND_PAE_NX=$(${GREPBINARY} " pae " /proc/cpuinfo | ${GREPBINARY} " nx ")
            FIND_PAE=$(${GREPBINARY} " pae " /proc/cpuinfo)
            FIND_NX=$(${GREPBINARY} " nx " /proc/cpuinfo)
            FOUND=0
            if HasData "${FIND_PAE_NX}"; then
                LogText "PAE：是"
                LogText "NX：是"
                CPU_PAE=1
                CPU_NX=1
                LogText "结果：PAE 或未找到 eXecute 选项"
                Report "cpu_pae=1"
                Report "cpu_nx=1"
                FOUND=1
            else
                if HasData "${FIND_PAE}" && IsEmpty "${FIND_NX}"; then
                    Report "cpu_pae=1"
                    LogText "结果：找到PAE"
                    CPU_PAE=1
                    FOUND=1
                else
                    if HasData "${FIND_NX}" && IsEmpty "${FIND_PAE}"; then
                        Report "cpu_nx=1"
                        LogText "结果：发现No eXecute"
                        CPU_NX=1
                        FOUND=1
                    else
                        LogText "结果：发现没有启用 CPU 选项（PAE 或 NX 位）"
                    fi
                fi
            fi
            if [ ${FOUND} -eq 1 ]; then
                Display --indent 4 --text "CPU 支持：支持 PAE 和/或 NoeXecute" --result "${STATUS_FOUND}" --color GREEN
            else
                Display --indent 4 --text "CPU 支持： 不支持 PAE 或 NoeXecute" --result "${STATUS_NONE}" --color YELLOW
                ReportSuggestion "${TEST_NO}" "尽可能使用启用 PAE 的内核以获得本机 No eXecute/eXecute Disable 支持"
            fi
        else
            Display --indent 4 --text "CPU 支持：无 /proc/cpuinfo" --result "${STATUS_SKIPPED}" --color YELLOW
            LogText "结果：未找到 /proc/cpuinfo"
        fi
    fi
