    if [ ${SKIPTEST} -eq 0 ]; then
        CHECKFILE="${ROOTDIR}boot/config-$(uname -r)"
        CHECKFILE_ZIPPED="${ROOTDIR}proc/config.gz"
        if [ -f ${CHECKFILE} ]; then
            LINUXCONFIGFILE="${CHECKFILE}"
            LogText "结果：找到配置（${LINUXCONFIGFILE}）"
            Display --indent 2 --text "- 检查Linux内核配置文件" --result "${STATUS_FOUND}" --color GREEN
        elif [ -f ${CHECKFILE_ZIPPED} ]; then
            LINUXCONFIGFILE="${CHECKFILE_ZIPPED}"
            LINUXCONFIGFILE_ZIPPED=1
            LogText "结果：找到配置：${ROOTDIR}proc/config.gz（压缩）"
            Display --indent 2 --text "- 检查Linux内核配置文件" --result "${STATUS_FOUND}" --color GREEN
        else
            LogText "结果：在${ROOTDIR}boot中找不到Linux内核配置文件"
            Display --indent 2 --text "- 检查Linux内核配置文件" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
        if HasData "${LINUXCONFIGFILE}"; then
            Report "linux_config_file=${LINUXCONFIGFILE}"
        fi
    fi
