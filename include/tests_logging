#################################################################################
#
# Logging and related files
#
#################################################################################
#
    LOG_FILES_LOCS="${ROOTDIR}var/log ${ROOTDIR}var/adm"
    LOGROTATE_CONFIG_FOUND=0
    LOGROTATE_TOOL=""
    METALOG_RUNNING=0
    RFC3195D_RUNNING=0
    RSYSLOG_RUNNING=0
    WAZUH_AGENT_RUNNING=0
    SOLARIS_LOGHOST=""
    SOLARIS_LOGHOST_FOUND=0
    SOLARIS_LOGHOST_LOCALHOST=0
    SYSLOG_DAEMON_PRESENT=0
    SYSLOG_DAEMON_RUNNING=0
    SYSLOG_NG_RUNNING=0
    SYSTEMD_JOURNAL_RUNNING=0
#
#################################################################################
#
    InsertSection "${SECTION_LOGGING_AND_FILES}"

    # Test        : LOGG-2130
    # Description : Check for a running syslog daemon
    Register --test-no LOGG-2130 --weight L --network NO --category security --description "检查正在运行的 syslog 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：搜索日志守护进程"
        FIND=$(${PSBINARY} ax | ${GREPBINARY} -E "syslogd|syslog-ng|metalog|systemd-journal" | ${GREPBINARY} -v "grep")
        if [ -z "${FIND}" ]; then
            Display --indent 2 --text "- 检查正在运行的日志守护进程" --result "${STATUS_WARNING}" --color RED
            LogText "结果：未找到 syslog、syslog-ng、rsyslog、metalog 或 systemd-journal 等日志守护进程"
            ReportSuggestion "${TEST_NO}" "检查是否有 syslog 守护进程正在运行且配置正确。"
            AddHP 0 3
        else
            Display --indent 2 --text "- 检查正在运行的日志守护进程" --result "${STATUS_OK}" --color GREEN
            LogText "结果：发现日志守护进程"
            SYSLOG_DAEMON_PRESENT=1
            SYSLOG_DAEMON_RUNNING=1
            AddHP 3 3
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2132
    # Description : Check for a running syslog-ng daemon
    Register --test-no LOGG-2132 --weight L --network NO --category security --description "检查正在运行的 syslog-ng 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在进程列表中搜索 syslog-ng 守护进程"
        if IsRunning "syslog-ng"; then
            LogText "结果：在进程列表中发现 syslog-ng"
            Display --indent 4 --text "- 检查 Syslog-NG 状态" --result "${STATUS_FOUND}" --color GREEN
            SYSLOG_DAEMON_PRESENT=1
            SYSLOG_NG_RUNNING=1
            Report "syslog_daemon_present=1"
            Report "syslog_daemon[]=syslog-ng"
        else
            LogText "结果：进程列表中未发现 syslog-ng"
            Display --indent 4 --text "- 检查 Syslog-NG 状态" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2134
    # Description : Check for Syslog-NG configuration file consistency
    if [ ! "${SYSLOGNGBINARY}" = "" -a ${SYSLOG_NG_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no LOGG-2134 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 Syslog-NG 配置文件一致性"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(${SYSLOGNGBINARY} -s; echo $?)
        if [ "${FIND}" = "0" ]; then
            LogText "结果：Syslog-NG 配置文件看起来一致"
            Display --indent 6 --text "- 检查 Syslog-NG 一致性" --result "${STATUS_OK}" --color GREEN
        else
            LogText "结果：Syslog-NG 配置文件可能存在不一致"
            Display --indent 6 --text "- 检查 Syslog-NG 一致性" --result "${STATUS_WARNING}" --color RED
            ReportSuggestion "${TEST_NO}" "检查 Syslog-NG 配置文件，或手动运行 syslog-ng -s 验证一致性"
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2136
    # Description : Check for a running systemd-journal daemon
    Register --test-no LOGG-2136 --weight L --network NO --category security --description "检查正在运行的 systemd journal 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在进程列表中搜索 systemd journal 守护进程"
        if IsRunning "systemd-journal"; then
            Display --indent 4 --text "- 检查 systemd journal 状态" --result "${STATUS_FOUND}" --color GREEN
            SYSTEMD_JOURNAL_RUNNING=1
            Report "syslog_daemon_present=1"
            Report "syslog_daemon[]=systemd-journal"
        else
            Display --indent 4 --text "- 检查 systemd journal 状态" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2210
    # Description : Check for a running metalog daemon
    Register --test-no LOGG-2210 --weight L --network NO --category security --description "检查正在运行的 metalog 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在进程列表中搜索 metalog 守护进程"
