            Report "syslog_daemon[]=metalog"
        else
            LogText "结果：进程列表中未发现 metalog"
            Display --indent 4 --text "- 检查 Metalog 状态" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2230
    # Description : Check for a running rsyslog daemon
    Register --test-no LOGG-2230 --weight L --network NO --category security --description "检查正在运行的 RSyslog 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在进程列表中搜索 RSyslog 守护进程"
        if IsRunning "rsyslogd"; then
            LogText "结果：在进程列表中发现 rsyslogd"
            Display --indent 4 --text "- 检查 RSyslog 状态" --result "${STATUS_FOUND}" --color GREEN
            SYSLOG_DAEMON_PRESENT=1
            RSYSLOG_RUNNING=1
            Report "syslog_daemon_present=1"
            Report "syslog_daemon[]=rsyslog"
        else
            LogText "结果：进程列表中未发现 rsyslogd"
            Display --indent 4 --text "- 检查 RSyslog 状态" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2240
    # Description : Check for a running RFC 3195 compliant daemon (syslog via TCP)
    Register --test-no LOGG-2240 --weight L --network NO --category security --description "检查正在运行且符合 RFC 3195 的守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在进程列表中搜索 RFC 3195 守护进程（可靠 syslog）"
        if IsRunning "rfc3195d"; then
            LogText "结果：在进程列表中发现 rfc3195d"
            Display --indent 4 --text "- 检查 RFC 3195 守护进程状态" --result "${STATUS_FOUND}" --color GREEN
            SYSLOG_DAEMON_PRESENT=1
            RFC3195D_RUNNING=1
        else
            LogText "结果：进程列表中未发现 rfc3195d"
            Display --indent 4 --text "- 检查 RFC 3195 守护进程状态" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2138
    # Description : Check for kernel log daemon (klogd) presence on Linux systems
    # Notes       : * When using metalog, rsyslog or systemd (systemd-journal), this process is not needed.
    #               * In combination with syslog-ng, klogd is still an addition to it, since it
    #                 captures kernel related events and send them to syslog-ng.
    #               * This test should be below all other logging daemons
    Register --test-no LOGG-2138 --os Linux --weight L --network NO --category security --description "检查 Linux 内核日志守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：搜索内核日志守护进程（klogd）"
        if [ ${RSYSLOG_RUNNING} -eq 0 ] && [ ${SYSTEMD_JOURNAL_RUNNING} -eq 0 ] && [ ${METALOG_RUNNING} -eq 0 ]; then
            # Search for klogd, but ignore other lines related to klogd (like dd with input/output file)
            #FIND=$(${PSBINARY} ax | ${GREPBINARY} "klogd" | ${GREPBINARY} -v "dd" | ${GREPBINARY} -v "grep")
            if IsRunning "klogd"; then
                LogText "结果：klogd 正在运行"
                Display --indent 4 --text "- 检查 klogd" --result "${STATUS_FOUND}" --color GREEN
            else
                LogText "结果：未发现 klogd"
                Display --indent 4 --text "- 检查 klogd" --result "${STATUS_NOT_FOUND}" --color RED
                ReportWarning "${TEST_NO}" "klogd 未运行，可能导致日志文件缺少内核消息"
            fi
        else
            LogText "结果：其他组件正在记录内核消息，跳过此检查"
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2142
    # Description : Check for minilogd presence on Linux systems
    Register --test-no LOGG-2142 --os Linux --weight L --network NO --category security --description "检查 minilog 守护进程"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：搜索仍在运行的 minilogd 实例"
        # Search for minilogd. It shouldn't be running normally, if another syslog daemon is started
        if IsRunning "minilogd"; then
            Display --indent 4 --text "- 检查 minilogd 实例" --result "${STATUS_WARNING}" --color RED
            LogText "结果：在进程列表中发现 minilogd"
            # minilogd daemon seems to be running
            ReportWarning "${TEST_NO}" "minilogd 正在运行，而正常情况下它不应运行"
        else
            Display --indent 4 --text "- 检查 minilogd 实例" --result "${STATUS_NOT_FOUND}" --color WHITE
            LogText "结果：没有 minilogd 正在运行"
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2144
    # Description : Check for wazuh-agent presence on Linux systems
    Register --test-no LOGG-2144 --os Linux --weight L --network NO --category security --description "检查 wazuh-agent"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：在进程列表中搜索 wazuh-agent 实例"
        if IsRunning "wazuh-agentd"; then
            LogText "结果：在进程列表中发现 wazuh-agent"
            Display --indent 4 --text "- 检查 wazuh-agent status" --result "${STATUS_FOUND}" --color GREEN
            WAZUH_AGENT_RUNNING=1
        else
            LogText "结果：进程列表中未发现 wazuh-agent"
            Display --indent 4 --text "- 检查 wazuh-agent daemon status" --result "${STATUS_NOT_FOUND}" --color WHITE
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2146
    # Description : Check for logrotate (/etc/logrotate.conf and logrotate.d)
    Register --test-no LOGG-2146 --weight L --os Linux --network NO --category security --description "检查 logrotate.conf 和 logrotate.d"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认 ${ROOTDIR}etc/logrotate.conf 是否存在"
        if [ -f ${ROOTDIR}etc/logrotate.conf ]; then
            LOGROTATE_CONFIG_FOUND=1
            LOGROTATE_TOOL="logrotate"
            LogText "结果：发现文件 ${ROOTDIR}etc/logrotate.conf"
        else
            LogText "结果：未找到 ${ROOTDIR}etc/logrotate.conf"
        fi

        LogText "检查：确认目录 ${ROOTDIR}etc/logrotate.d 是否存在"
        if [ -d ${ROOTDIR}etc/logrotate.d ]; then
            LOGROTATE_CONFIG_FOUND=1
            LOGROTATE_TOOL="logrotate"
            LogText "结果：发现 ${ROOTDIR}etc/logrotate.d"
        else
            LogText "结果：发现 ${ROOTDIR}etc/logrotate.conf"
        fi

        if [ ${LOGROTATE_CONFIG_FOUND} -eq 1 ]; then
            Display --indent 2 --text "- 检查 logrotate" --result "${STATUS_OK}" --color GREEN
            LogText "结果：发现 logrotate 配置"
        else
            Display --indent 2 --text "- 检查 logrotate" --result "${STATUS_NOT_FOUND}" --color WHITE
            LogText "结果：未发现 logrotate 配置"
            ReportSuggestion "${TEST_NO}" "检查日志文件是否正确轮转"
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2148
    # Description : Checking log files rotated with logrotate
    if [ -n "${LOGROTATEBINARY}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no LOGG-2148 --weight L --preqs-met ${PREQS_MET} --network NO --category security --description "检查由 logrotate 轮转的文件"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：确认哪些文件由 logrotate 轮转以及它们是否存在"
        FIND=$(${LOGROTATEBINARY} -d -v ${ROOTDIR}etc/logrotate.conf 2>&1 | ${GREPBINARY} -E "considering log|skipping" | ${GREPBINARY} -v '*' | ${SORTBINARY} -u | ${AWKBINARY} '{ if ($2!="log") { print "File:"$2":does_not_exist" } else { print "File:"$3":exists" } }')
        if [ -z "${FIND}" ]; then
            LogText "结果：未发现相关内容"
        else
            LogText "结果：发现一个或多个由 logrotate 轮转的文件"
            for I in ${FIND}; do
                LogText "输出：${I}"
            done
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2150
    # Description : Checking log directories rotated with logrotate
    if HasData "${LOGROTATEBINARY}"; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no LOGG-2150 --weight L --preqs-met ${PREQS_MET} --network NO --category security --description "检查 logrotate 配置中的目录"
    if [ ${SKIPTEST} -eq 0 ]; then
        LogText "检查：搜索 logrotate 配置中定义的目录"
        FIND=$(${LOGROTATEBINARY} -d -v ${ROOTDIR}etc/logrotate.conf 2>&1 | ${GREPBINARY} -E "considering log|skipping" | ${GREPBINARY} -v '*' | ${SORTBINARY} -u | ${AWKBINARY} '{ if ($2=="log") { print $3 } }' | ${SEDBINARY} 's@/[^/]*$@@g' | ${SORTBINARY} -u)
        if IsEmpty "${FIND}"; then
            LogText "结果：未发现相关内容"
        else
            LogText "结果：通过 logrotate 配置发现一个或多个目录"
            for DIR in ${FIND}; do
                if [ -d ${DIR} ]; then
                    LogText "发现目录：${DIR}"
                    Report "log_directory[]=${DIR}"
                else
                    LogText "结果：找不到目录 ${DIR}"
                fi
            done
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2152
    # Description : Check for Solaris 'loghost' entry in /etc/inet/hosts, or
    #               successful resolving via DNS or any other name service.
    Register --test-no LOGG-2152 --weight L --os Solaris --network NO --category security --description "检查 loghost"
    if [ ${SKIPTEST} -eq 0 ]; then
        # Try local hosts file
        LogText "检查：在 /etc/inet/hosts 中搜索 loghost"
        FIND=$(${GREPBINARY} loghost /etc/inet/hosts | ${GREPBINARY} -v "^#")
        if [ -n "${FIND}" ]; then
            SOLARIS_LOGHOST="${FIND}"
            SOLARIS_LOGHOST_FOUND=1
            LogText "结果：在 /etc/inet/hosts 中发现 loghost 条目"
        else
            LogText "结果：/etc/inet/hosts 中未发现 loghost 条目"

            # Try name resolving if no entry is present in local host file
            LogText "检查：通过名称解析搜索 loghost"
            FIND=$(getent hosts loghost | ${GREPBINARY} loghost)
            if [ -n "${FIND}" ]; then
                SOLARIS_LOGHOST="${FIND}"
                SOLARIS_LOGHOST_FOUND=1
                LogText "结果：名称解析成功"
                LogText "Output: ${FIND}"
            else
                LogText "结果：名称解析未返回结果"
            fi
        fi

        if [ ${SOLARIS_LOGHOST_FOUND} -eq 1 ]; then
            LogText "结果：发现 loghost 条目，可能用于发送 syslog 消息"
            Display --indent 2 --text "- 检查 loghost entry" --result "${STATUS_OK}" --color GREEN
        else
            Display --indent 2 --text "- 检查 loghost entry" --result "${STATUS_WARNING}" --color RED
            LogText "结果：未发现 loghost 条目"
            ReportWarning "${TEST_NO}" "未发现 loghost 条目"
            ReportSuggestion "${TEST_NO}" "在 /etc/inet/hosts 或其他名称服务中添加 loghost 条目"
        fi
    fi
#
#################################################################################
#
    # Test        : LOGG-2153
    # Description : Check Solaris 'loghost' entry is not localhost, meaning
    #               remote logging is not configured.
    if [ ${SOLARIS_LOGHOST_FOUND} -eq 1 ] && [ -n "${SOLARIS_LOGHOST}" ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no LOGG-2153 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 loghost is localhost"
    if [ ${SKIPTEST} -eq 0 ]; then
        FIND=$(echo "${SOLARIS_LOGHOST}" | ${AWKBINARY} '{ print $1 }' | ${GREPBINARY} -E "::1|127.0.0.1|127.1")
        if [ -n "${FIND}" ]; then
            SOLARIS_LOGHOST_LOCALHOST=1
            LogText "结果：loghost 条目为 localhost（默认值）"
            Display --indent 4 --text "- 检查 loghost entry is localhost" --result "${STATUS_YES}" --color YELLOW
            ReportSuggestion "${TEST_NO}" "将 loghost 条目设置为远程位置以启用远程日志。"
        else
            Display --indent 4 --text "- 检查 loghost entry is localhost" --result "${STATUS_NO}" --color GREEN
        fi
    fi

#
#################################################################################
#
    # Test        : LOGG-2154
    # Description : Check to see if remote logging is enabled
    # Notes       : prevent lines showing up with commands in it (like |mail)
    if [ ${SYSLOG_DAEMON_RUNNING} -eq 1 ]; then PREQS_MET="YES"; else PREQS_MET="NO"; fi
    Register --test-no LOGG-2154 --preqs-met ${PREQS_MET} --weight L --network NO --category security --description "检查 syslog 配置文件"
    if [ ${SKIPTEST} -eq 0 ]; then

        if [ ${RSYSLOG_RUNNING} -eq 1 ]; then
            DATA=""
            TARGET="${ROOTDIR}etc/rsyslog.conf"
            if [ -f ${TARGET} ]; then
                LogText "检查：分析文件 ${TARGET} 中的远程目标"
                DATA=$(${GREPBINARY} -E "@@?([a-zA-Z0-9\-])+(\.)?(([a-zA-Z0-9-])+)?(\.)?(([a-zA-Z0-9-])+)?(\.)?(([a-zA-Z0-9-])+)?(\.)?(([a-zA-Z0-9-])+)?" ${TARGET} | ${GREPBINARY} -v "#" | ${TRBINARY} -cd "[:print:]\n" | ${SEDBINARY} 's/[[:blank:]]\{1,\}/:space:/g')
                if [ -z "${DATA}" ]; then
                    LogText "结果：未发现远程目标"
                else
                    LogText "结果：发现远程目标"
                    REMOTE_LOGGING_ENABLED=1
                    for D in ${DATA}; do
                        if SafeInput "${D}"; then
                            D=$(echo ${D} | ${SEDBINARY} 's/:space:/ /g')
                            LogText "数据：${D}"
                        fi
                    done
                fi
            fi
            TARGET="${ROOTDIR}etc/rsyslog.d"
            if [ -d ${TARGET} ]; then
                FILES=$(${FINDBINARY} -L ${TARGET} -type f -print0 | ${TRBINARY} -cd '[:print:]\0' | ${SEDBINARY} 's/[[:blank:]]/:space:/g' | ${TRBINARY} '\0' ' ')
                for F in ${FILES}; do
                    F=$(echo ${F} | ${SEDBINARY} 's/:space:/ /g')
                    LogText "检查：分析文件 ${F} 中的远程目标"
                    DATA=$(${GREPBINARY} -E "@@?([a-zA-Z0-9\-])+(\.)?(([a-zA-Z0-9-])+)?(\.)?(([a-zA-Z0-9-])+)?(\.)?(([a-zA-Z0-9-])+)?(\.)?(([a-zA-Z0-9-])+)?" ${F} | ${GREPBINARY} -v "#" | ${TRBINARY} -cd "[:print:]\n" | ${SEDBINARY} 's/[[:blank:]]\{1,\}/:space:/g')
                    if [ -n "${DATA}" ]; then
                        LogText "结果：发现远程目标"
                        REMOTE_LOGGING_ENABLED=1
                        for D in ${DATA}; do
                            if SafeInput "${D}"; then
                                D=$(echo ${D} | ${SEDBINARY} 's/:space:/ /g')
                                LogText "数据：${D}"
                            fi
                        done
                    else
                        # Check new style configuration (omrelp/omfwd). This can be all on one line or even split over multiple lines.
                        DATA=$(${GREPBINARY} -E "target=\"([a-zA-Z0-9\-])" ${F})
                        if [ -n "${DATA}" ]; then
                            LogText "结果：发现 'target' 关键字，很可能正在使用远程日志主机"
                            REMOTE_LOGGING_ENABLED=1
                        else
                            LogText "结果：未发现远程目标"
                        fi
                    fi
                done
            fi
        fi

        # Test generic syslog files (syslog-ng and older syslog daemons)
        if [ ${SYSLOG_NG_RUNNING} -eq 1 ]; then
            SYSLOGD_CONF="${ROOTDIR}etc/syslog-ng/syslog-ng.conf"
        else
            SYSLOGD_CONF="${ROOTDIR}etc/syslog.conf"
        fi

        if [ -f ${SYSLOGD_CONF} ]; then
            LogText "检查：确认日志是否同时发送到远程日志主机"
            FIND=$(${GREPBINARY} -E "@[a-zA-Z0-9]|destination\s.+(udp|tcp).+\sport" ${SYSLOGD_CONF} | ${GREPBINARY} -v "^#" | ${GREPBINARY} -v "[a-zA-Z0-9]@")
            if [ -n "${FIND}" ]; then
                FIND2=$(echo "${FIND}" | ${GREPBINARY} -v "@loghost")
                if [ ${SOLARIS_LOGHOST_LOCALHOST} -eq 1 ] && [ -z "${FIND2}" ]; then
                    LogText "结果：已向 loghost 启用远程日志，但 loghost 指向 localhost"
                else
                    LogText "结果：已启用远程日志"
                    REMOTE_LOGGING_ENABLED=1
                fi
            else
                # Search for configured destinations with an IP address or hostname, then determine which ones are used as a log destination
                DESTINATIONS=$(${GREPBINARY} "^destination" ${SYSLOGD_CONF} | ${GREPBINARY} -E "(udp|tcp)" | ${GREPBINARY} "port" | ${AWKBINARY} '{print $2}')
                for DESTINATION in ${DESTINATIONS}; do
                    FIND2=$(${GREPBINARY} "log" ${SYSLOGD_CONF} | ${GREPBINARY} "source" | ${GREPBINARY} -E "destination\(${DESTINATION}\)")
                    if [ -n "${FIND2}" ]; then
                        LogText "结果：发现用于远程日志的目标 ${DESTINATION}"
                        REMOTE_LOGGING_ENABLED=1
                    fi
                done
            fi
        fi

        # Test wazuh-agent configuration for syslog configuration
        if [ ${WAZUH_AGENT_RUNNING} ]; then
            WAZUH_AGENT_CONF="/var/ossec/etc/ossec.conf"
        fi

        if [ -f ${WAZUH_AGENT_CONF} ]; then
            LogText "检查：检查 Wazuh Agent 的远程 syslog 转发配置"
            FIND=$(${EGREPBINARY} '<location>/var/log/syslog</location>' ${WAZUH_AGENT_CONF})
            if [ "${FIND}" ]; then
                DESTINATION=$(${EGREPBINARY} -o '<address>([A-Za-z0-9\.\-\_]*)</address>' ${WAZUH_AGENT_CONF} | sed 's/<address>//' | sed 's/<\/address>//')
                LogText "结果：发现用于远程日志的目标 ${DESTINATION} with wazuh"
                REMOTE_LOGGING_ENABLED=1
            fi
        fi

        # Show result
        if [ ${REMOTE_LOGGING_ENABLED} -eq 0 ]; then
            Report "remote_syslog_configured=0"
            LogText "结果：未发现远程日志配置"
            ReportSuggestion "${TEST_NO}" "启用外部日志主机，用于归档并提供额外保护"
            AddHP 1 3
            Display --indent 2 --text "- 检查远程日志" --result "${STATUS_NOT_ENABLED}" --color YELLOW
        else
            Report "remote_syslog_configured=1"
            AddHP 5 5
            Display --indent 2 --text "- 检查远程日志" --result "${STATUS_ENABLED}" --color GREEN
        fi

    fi
